// Developer: @Mistium
// Description: Browse, install and update apps from apps.rotur.dev
//
// Layout: a glass sidebar with search, the main sections and the categories, and a
// pane showing the Discover page, a list of apps or one app. `installed.json` in the
// appstore@system save maps an app title to the version the store installed.
// Sizes passed to `box` are the visible size, OSL arithmetic runs left to right.

import "window_tools"

permission "request" "file admin"
permission "request" "terminal"
permission "request" "save admin"
permission "request" "account"
permission "request" "rotur token"

SIDE = 230
ROW_H = 84

window.resize(1000, 680)
window.show()

save "appstore@system" "set_directory"
if !"installed.json".saveExists() (
  save "installed.json" "set" {}
) else if typeof("installed.json".saveGet()) != "object" (
  save "installed.json" "set" {}
)
save_data @= "installed.json".saveGet() ?? {}

home_json = null
all_json = null
supported_json = []
categories = {}
category_keys = []

page = "loading"
page_title = "Discover"
page_list = []
page_app = ""
nav_key = "discover"
page_history = []
last_query = ""
inputs.search = ""
side_len = 0
page_len = 0
button_click = false
shot = 1
installing = ""

array say_queue = []
array forget_queue = []
def queueSay(message) (
  say_queue.append(message)
)

install_msg = null
install_title = null
install_icon = null

def installApp(cur, message) (
  file "goto_dir" "~/Applications"
  install_msg = message
  install_title = cur.title
  install_icon = cur.icon
  installing = cur.title
  void requests.getAsync("https://apps.rotur.dev/apps/download/" ++ encodeURIComponent(install_title) ++ "/osl?auth=" ++ roturToken())
    .then(resp -> (
      installing = ""
      if resp.success == false or resp.body == null or resp.body == "" (
        queueSay("Download failed")
        return
      )
      file "set_file" install_title ++ ".osl" resp.body
      file "open" "~/Applications/" ++ install_title ++ ".osl" "onlyaccess"
      file "set" 11 install_icon
      file "close"
      queueSay(install_msg ?? "Installed " ++ install_title)
    ))
)

// remembers where we were, then shows a page
def navigate(p, title, list, app, key) (
  page_history.append({page: page, title: page_title, list: page_list, app: page_app, key: nav_key})
  page = p
  page_title = title
  page_list = list
  page_app = app
  nav_key = key
  shot = 1
)

def go_back() (
  local last @= page_history.pop()
  page = last.page
  page_title = last.title
  page_list = last.list
  page_app = last.app
  nav_key = last.key
)

// a top level section, it starts a fresh history
def open_section(title, list, key) (
  page_history = []
  page = key == "discover" ? "discover" "list"
  page_title = title
  page_list = list
  page_app = ""
  nav_key = key
)

def pending_updates() (
  return supported_json.filter(v -> (v.title in save_data and v.version != save_data[v.title])).map(v -> v.title)
)

my_apps @= requests.get("https://apps.rotur.dev/apps/owned?auth=" ++ roturToken())
if my_apps.status != 200 (
  my_apps @= []
) else (
  my_apps @= my_apps.body.ownedApps
)

// ---------------------------------------------------------------- drawing helpers

// a sidebar entry, result in `button_click`
def "nav_row" "label, icn, key, y, badge" (
  goto side_x y
  hit sw 30
  button_click = onclick
  local ink = txtc
  if nav_key == key (
    box sw 30 12 : c#global_accent
    ink = accent_txt
  ) else if mouse_touching (
    cursor "pointer"
    box sw 30 12 : c#hover_col
  )
  goto side_x - (sw / 2) + 18 y
  icon icn 0.55 : c#ink
  goto side_x - (sw / 2) + 36 y
  text label 8.5 : c#ink
  if badge != "" (
    goto side_x + (sw / 2) - 12 y
    rigtext badge 8 : c#ink
  )
)

// a text button, result in `button_click`
def "text_button" "label, w, fill, ink" (
  hit w 32
  button_click = onclick
  if mouse_touching (
    cursor "pointer"
  )
  box w 32 14 : c#fill
  centext label 9 : c#ink
)

// one app as a card: icon, name, a line of description, size and install state
def "app_row" "name, x, y, w" (
  local id = name.toStr().toLower()
  local app @= all_json[id]
  if app == null (
    return
  )
  goto x y
  hit w ROW_H - 12
  local over = mouse_touching
  if onclick (
    void ("https://apps.rotur.dev/apps/info/" ++ id).getAsync()
    navigate("app", app.title, page_list, id, nav_key)
  )
  box w + 2 ROW_H - 10 16 : c#edge_col
  if over (
    cursor "pointer"
    box w ROW_H - 12 14 : c#hover_col
  ) else (
    box w ROW_H - 12 14 : c#prim
  )
  goto x - (w / 2) + 40 y
  icon app.icon.replace("\n", " ") 1.6 : c#txtc
  local chars = w - 165 / 8
  goto x - (w / 2) + 78 y + 12
  text app.title.trimText(w - 190 / 10) 10 : c#txtc
  goto x - (w / 2) + 78 y - 10
  text (app.description ?? "").toStr().replace("\n", " ").trimText(chars) 8 : c#muted
  local state = formatFileSize(app.scripts.osl.size)
  local state_ink = muted
  if app.title in save_data (
    state = "Installed"
    if save_data[app.title] != app.version (
      state = "Update"
      state_ink = global_accent
    )
  ) else if app.price > 0 (
    state = app.price ++ " rc"
  )
  goto x + (w / 2) - 16 y
  rigtext state 8 : c#state_ink
)

// label on the left, value on the right, inside a card the caller drew
def "info_row" "label, value, y" (
  goto pw / -2 + 20 + cx y
  text label 9 : c#muted
  goto pw / 2 - 20 + cx y
  rigtext value.toStr().trimText(pw - 220 / 9) 9 : c#txtc
)

def "section_label" "label, y" (
  goto pw / -2 + 6 + cx y
  text label 7.5 : c#muted
)

// ---------------------------------------------------------------- pages

// rows of app cards, two columns when there is room. Only visible rows are drawn
def "draw_apps" "list, y" (
  local cols = pw > 620 ? 2 1
  local cw = pw - (cols - 1 * 12) / cols
  for i list.len (
    local col = i - 1 % cols
    local row = floor(i - 1 / cols)
    local ry = y - (row * ROW_H) - (ROW_H / 2)
    if ry < frame.top + ROW_H and ry > frame.bottom - ROW_H (
      app_row list[i] cx - (pw / 2) + (cw / 2) + (col * (cw + 12)) ry cw
    )
  )
  apps_height = ceil(list.len / cols) * ROW_H
)

def "draw_discover" (
  local y = frame.top - 12 + frame.scroll
  local top = y
  local bh = pw / 16 * 7
  goto cx y - (bh / 2)
  card pw bh
  style {rounding: 7}
  image home_json.featured.image pw - 2 bh - 2
  y -= bh + 14
  app_row home_json.featured.name cx y - (ROW_H / 2) pw
  y -= ROW_H + 8

  section_label "POPULAR RIGHT NOW" y - 8
  y -= 24
  local tiles @= home_json.tiles.map(v -> v.title)
  draw_apps tiles y
  y -= apps_height
  page_len = top - y + 24
)

def "draw_list" (
  local y = frame.top - 8 + frame.scroll
  if page_list.len == 0 (
    goto cx 20
    icon "apps" 1.6 : c#track_col
    goto cx -24
    local empty = "Nothing here yet"
    if nav_key == "updates" (
      empty = "Everything is up to date"
    )
    if nav_key == "search" (
      empty = "No apps match that"
    )
    centext empty 9.5 : c#muted
    page_len = 0
    return
  )
  draw_apps page_list y
  page_len = apps_height + 24
)

def "draw_app" (
  cur @= all_json[page_app]
  local y = frame.top - 12 + frame.scroll
  local top = y

  // header: icon, name, author and the main action
  goto cx y - 50
  card pw 100
  goto pw / -2 + 52 + cx y - 50
  icon cur.icon.replace("\n", " ") 2.4 : c#txtc
  goto pw / -2 + 104 + cx y - 36
  text cur.title.trimText(pw - 300 / 14) 14 : c#txtc
  goto pw / -2 + 104 + cx y - 64
  local by = "By " ++ cur.author
  text by 9 : c#muted
  goto pw / -2 + 104 + (by.len * 4.5) + cx y - 64
  hit by.len * 9 18
  if mouse_touching (
    cursor "pointer"
  )
  if onclick (
    local who = cur.author.toLower()
    author_key = who
    navigate("list", "Apps by " ++ cur.author, supported_json.filter(v -> (v.author.toLower().replace(" ", "").split(",").contains(author_key))).map(v -> v.title), "", nav_key)
    return
  )

  file "exists" parseFilePath("~/Applications/" ++ cur.title ++ ".osl")
  local installed = exists
  local msg = "Install"
  if installing == cur.title (
    msg = "Installing..."
  ) else if installed (
    // plain ifs: a ternary after `or` binds to the last operand and the label became `true`
    msg = "Open"
    if cur.title in save_data and save_data[cur.title] != cur.version (
      msg = "Update"
    )
  ) else if cur.price > 0 and !my_apps.contains(cur.title.toLower()) (
    msg = "Buy for " ++ cur.price ++ " rc"
  )
  local bw = msg.len * 9 + 36
  goto pw / 2 - 20 - (bw / 2) + cx y - 50
  text_button msg bw global_accent accent_txt
  if button_click and installing == "" (
    if msg == "Open" (
      file "open" "~/Applications/" ++ cur.title ++ ".osl" "onlyaccess"
      file "start"
      file "close"
    ) else if !msg.startsWith("Buy ") or "Are you sure you want to buy this app?".confirm() (
      installApp(cur, "Installed to " ++ username ++ "/Applications")
      save_data[cur.title] = cur.version
      save "installed.json" "set" save_data
    )
  )
  if installed (
    goto pw / 2 - 40 - bw + cx y - 50
    hit 32 32
    if mouse_touching (
      cursor "pointer"
      box 32 32 14 : c#hover_col
    )
    icon "more" 0.6 : c#txtc
    if onclick (
      open_rightclick [
        {"Reinstall": def(v) -> (
          installApp(v.cur, "Reinstalled " ++ v.cur.title)
        )},
        {"Uninstall": def(v) -> (
          file "goto_dir" "~/Applications"
          file "open" v.cur.title ++ ".osl" "onlyaccess"
          file "delete"
          file "close"
          forget_queue.append(v.cur.title)
          queueSay("Uninstalled " ++ v.cur.title)
        )},
      ] {cur}
    )
  )
  y -= 114

  // one screenshot at a time, with dots to switch
  if cur.screenshots.len > 0 (
    shot = shot.clamp(1, cur.screenshots.len)
    local sh = min(pw / 16 * 9, 340)
    goto cx y - (sh / 2)
    card pw sh
    style {rounding: 7}
    image "https://apps.rotur.dev/apps/screenshots/" ++ page_app ++ "/" ++ encodeURIComponent(cur.screenshots[shot]) null sh - 16
    y -= sh + 14
    if cur.screenshots.len > 1 (
      goto cur.screenshots.len - 1 * -9 + cx y
      for i cur.screenshots.len (
        hit 16 16
        if mouse_touching (
          cursor "pointer"
        )
        if onclick (
          shot = i
        )
        local dot = i == shot ? global_accent track_col
        box 8 8 8 : c#dot
        change_x 18
      )
      y -= 22
    )
  )

  section_label "ABOUT" y - 8
  y -= 24
  local descr = (cur.description ?? "No description").toStr().wrapText(pw - 40 / 9)
  local lines = descr.split("\n").len
  local dh = lines * 20 + 24
  goto cx y - (dh / 2)
  card pw dh
  goto pw / -2 + 20 + cx y - 22
  text descr 9 : c#txtc
  y -= dh + 14

  section_label "INFORMATION" y - 8
  y -= 24
  local perms = "None"
  if cur.permissions.len > 0 (
    perms = cur.permissions.join(", ")
  )
  local price = cur.price > 0 ? cur.price ++ " rc" "Free"
  local rows = [
    ["Version", cur.version],
    ["Size", formatFileSize(cur.scripts.osl.size)],
    ["Price", price],
    ["Category", (cur.genre ?? "").toStr().toTitle()],
    ["Downloads", cur.downloads ?? 0],
    ["Views", cur.views ?? 0],
    ["Permissions", perms]
  ]
  local ih = rows.len * 30 + 8
  goto cx y - (ih / 2)
  card pw ih
  for i rows.len (
    local item @= rows[i]
    local label = item[1]
    local value = item[2]
    info_row label value y - 19 - (i - 1 * 30)
    if i < rows.len (
      goto cx y - 34 - (i - 1 * 30)
      box pw - 40 1 0 : c#edge_col
    )
  )
  y -= ih
  page_len = top - y + 24
)

mainloop:
load_theme

if home_json == null (
  data = "https://apps.rotur.dev/apps/featured".getAsync()
  if data != "loading" (
    home_json = data
  )
)
if all_json == null (
  data = "https://apps.rotur.dev/apps/all".getAsync()
  if data != "loading" (
    all_json @= data.apps
    supported_json = all_json.getValues()
      .filter(v -> v.supports.contains("originOS"))
      .sortBy("genre")

    local genres = supported_json.map(v -> v.genre.toStr().toLower())
    out = {}
    for i supported_json.len (
      local parts = genres[i].split(",")
      for i2 parts.len (
        local genre = parts[i2].strip()
        if genre != "" (
          out[genre] ??= []
          void out[genre].append(supported_json[i].title)
        )
      )
    )
    categories @= out
    category_keys = categories.getKeys()
  )
)
if all_json != null and home_json != null and page == "loading" (
  page = "discover"
  // an app id as passed_data opens straight on that app, originAssist uses this
  local deep = passed_data.toStr().toLower()
  if deep != "" and all_json[deep] != null (
    navigate("app", all_json[deep].title, [], deep, "discover")
  )
)

while forget_queue.len > 0 (
  void save_data.delete(forget_queue.pop())
  save "installed.json" "set" save_data
)

// typing in the search box shows results, clearing it returns to Discover
local query = inputs.search.toStr().toLower().strip()
if query != last_query and all_json != null (
  last_query = query
  if query == "" (
    open_section("Discover", [], "discover")
  ) else (
    search_query = query
    open_section("Results for " ++ query, supported_json.filter(v -> (v.title.toLower().contains(search_query) or (v.description ?? "").toStr().toLower().contains(search_query))).map(v -> v.title), "search")
  )
)

// page background, squared off where it meets the glass sidebar
local cl = window.left + SIDE
window.setGlass(100, "15px")
goto SIDE / 2 0
square window.width - SIDE - 10 window.height + 10 10 : c#window_colour
goto cl + 12 0
square 20 window.height 4
c window_colour
pen "opacity" 55
icon "w 99999 dot 0 0" 10
pen "opacity" 0
frame "clear"

// ---- sidebar
side_x = window.left + (SIDE / 2)
// the top row shares the window buttons' centre line (21 below the top) and height (27),
// and the sidebar keeps the same 6 inset at the sides as it has at the top
sw = SIDE - 12
goto side_x window.top - 21
box sw 27 12 : c#prim
goto side_x - (sw / 2) + 16 window.top - 21
icon "search" 0.5 : c#muted
goto side_x + 12 window.top - 21
c prim
input sw - 44 21 "search" "Search apps" 9 txtc

if page != "loading" (
  local updates @= pending_updates()
  local update_badge = updates.len > 0 ? updates.len.toStr() ""
  nav_row "Discover" "home" "discover" window.top - 63 ""
  if button_click (
    inputs.search = ""
    last_query = ""
    open_section("Discover", [], "discover")
  )
  nav_row "Updates" "download" "updates" window.top - 97 update_badge
  if button_click (
    open_section("Updates", updates, "updates")
  )
  nav_row "Installed" "apps" "installed" window.top - 131 ""
  if button_click (
    open_section("Installed", supported_json.filter(v -> (v.title in save_data)).map(v -> v.title), "installed")
  )

  goto side_x - (sw / 2) + 10 window.top - 167
  text "CATEGORIES" 7.5 : c#muted
  frame window.left window.top - 181 cl window.bottom + 8 side_len "categories" (
    side_x = 0
    sw = frame.width - 12
    local y = frame.top - 18 + frame.scroll
    for i category_keys.len (
      if y < frame.top + 40 and y > frame.bottom - 40 (
        local name = category_keys[i]
        local count = categories[name].len.toStr()
        nav_row name.toTitle() "folder" "cat:" ++ name y count
        if button_click (
          open_section(name.toTitle(), categories[name], "cat:" ++ name)
        )
      )
      y -= 34
    )
    side_len = category_keys.len * 34 + 12
  )
)

// ---- pane header: back, title and the drag area
local hx = cl + 24
if page_history.len > 0 (
  goto hx + 6 window.top - 21
  hit 27 27
  if mouse_touching (
    cursor "pointer"
    box 27 27 12 : c#hover_col
  )
  if onclick (
    go_back()
  )
  icon "left-arrow" 0.6 : c#txtc
  hx += 34
)
goto hx window.top - 21
text page_title.toStr().trimText(window.right - hx - 140 / 12) 12 : c#txtc
window "set_dragbox" [[2, 2, SIDE + 70, 0], [-2, 2, -92, -42]]

c window_colour
frame cl window.top - 46 window.right window.bottom page_len "store" (
  pw = min(frame.width - 50, 760)
  // the scrollbar gutter takes 10px on the right
  cx = -5
  switch page (
    case "loading"
      goto cx 0
      direction timer * 360
      icon "w 2 cutcircle 0 0 10 0 90" 1.4 : c#txtc
      direction 90
      goto cx -40
      centext "Loading the store" 9 : c#muted
      break
    case "discover"
      draw_discover
      break
    case "list"
      draw_list
      break
    case "app"
      draw_app
      break
  )
)

if say_queue.len > 0 (
  // Global `say` command (opens Alert.osl), not the local queue helper.
  say say_queue.pop()
)

import "win-buttons"
