import "window_tools"

permission "request" "windows"
permission "request" "terminal"

window.show()
window.resize(600,400)
current_tab = "no_perms"

activity_info = false
if Windows().getKeys("id").contains(passed_data) (
  activity_info = true
  page = passed_data
)
memory = roturLink.enabled or "performance.memory !== undefined".eval()
paused = false
graph = []
network_usage = []
string delta = "0%"

dom_last_update = 0
dom_prev_dom_writes = 0
dom_prev_dom_t = timer
dom_writes_per_s = 0
dom_writes_per_frame = 0
dom_layout_score = 0
dom_layout_state = "stable"
dom_global = {}
dom_target_stats = {}
dom_window_rows = []

def drawTab(name, label) (
  c name == current_tab ? seco prim
  square tab_w 25 10 1
  if onclick (
    current_tab = name
  )
  change_x tab_w / -2 + 8
  text label 8 : c#txtc
)

rightclick_menu = [
  "Unknown",
  "-",
  {"Show in Files": def(win) -> (
    window.create("/(a) system/user applications/Files.osl", win.file.uuid)
  )},
  {"More Activity Info": def(win) -> (
    window.create(window.file.uuid, {
      passed_data: win.id,
      child: true
    })
  )},
  {"Copy File Path": def(win) -> (
    clipboard "set" win.file.path
  )},
  {"Get File Info": def(win) -> (
    window.create("/(a) system/system apps/Files_Info.osl", win.file.uuid)
  )},
  "-",
  {"Kill Process": def(win) -> (
    void win.close()
  )},
]

def getWindowsData() (
  windows_list @= Windows()
    .map(v -> (
      v.time = v.render[1].toNum()
      return v
    ))

  windows_names @= windows_list.getKeys("name")
  windows_drawtimes @= windows_list.getKeys("render")
  windows_ids @= windows_list.getKeys("id")
  windows_draw_main @= windows_list.getKeys("time")

  local vals = []
  for i windows_list.len (
    vals.append({
      name: windows_names[i],
      time: windows_draw_main[i],
      id: windows_ids[i],
      draw: windows_drawtimes[i]
    })
   )
   windows_total_time = windows_draw_main.sum()
   number system_time = max(0, floor(((delta_time * 1000) - windows_total_time) * 10) / 10)
   vals.append({
     name: "System",
     time: system_time,
     id: -1,
     draw: [system_time]
   })
   windows_list.append(vals[-1])

   vals @= vals.sortBy("time").reverse()
   windows_list @= windows_list.sortBy("time").reverse()

   windows_names @= vals.getKeys("name")
   windows_ids @= vals.getKeys("id")
   windows_drawtimes @= vals.getKeys("draw")
   windows_draw_main @= vals.getKeys("time")
)

def "updateDomMetrics" (
  if timer - dom_last_update >= 0.5 (
    dom_last_update = timer
    dom_global = "window.OSLDom && window.OSLDom.stats ? window.OSLDom.stats() : {}".eval()
    dom_total_writes = "window.OSLDom && window.OSLDom.writes ? window.OSLDom.writes() : 0".eval()
    dom_write_delta = dom_total_writes - dom_prev_dom_writes
    dom_write_dt = max(timer - dom_prev_dom_t, 0.01)
    dom_prev_dom_t = timer
    dom_prev_dom_writes = dom_total_writes
    dom_writes_per_s = dom_write_delta / dom_write_dt
    dom_writes_per_frame = dom_writes_per_s / max(fps, 1)
    dom_layout_score = dom_writes_per_frame / max(dom_global.records / 10, 1)
    if dom_writes_per_frame > 16 (
      dom_layout_state = "heavy layout thrash"
    )
    if dom_writes_per_frame > 6 and dom_writes_per_frame <= 16 (
      dom_layout_state = "churn"
    )
    if dom_writes_per_frame <= 6 (
      dom_layout_state = "stable"
    )
    dom_window_rows = "(()=>{ try { const rt = window.vm && window.vm.runtime; if (!rt || !rt.targets) return []; const out = []; for (const t of rt.targets) { const w = t.window; if (!t.__osldom || !w || w.id == null) continue; const wi = window.origin?.windows?.ids?.findIndex(id => String(id) === String(w.id)) ?? -1; const windowName = wi >= 0 ? window.origin.windows.names[wi] : null; const s = t.__osldom; let pools = 0, records = 0, attached = 0, persistent = 0, canvasBytes = 0; for (const pool of s.els || []) { pools += 1; for (const rec of pool.arr || []) { if (!rec || rec.dead) continue; records += 1; if (rec.el && rec.el.isConnected) attached += 1; if (rec.type === 'iframe' || rec.type === 'textedit' || rec.type === 'lineedit') persistent += 1; if (rec.cv) canvasBytes += (rec.cv.width || 0) * (rec.cv.height || 0) * 4; } } out.push({ id: +w.id, name: String(windowName || w.name || t.sprite?.name || 'Window'), records, attached, detached: records - attached, persistent, pools, canvasBytes, approxBytes: records * 180 }); } return out.sort((a,b)=>b.records-a.records); } catch(e) { return []; } })()".eval()
    if activity_info (
      dom_target_stats = null
      local ids = dom_window_rows.getKeys("id")
      if ids.len > 0 (
        local idx = ids.index(page)
        if idx > -1 (
          dom_target_stats = dom_window_rows[idx]
        )
      )
    )
  )
)

created_time = timer
last_timer = timer
next_update = 2
high = 0
low = 250
graph = (1 to 1000).fill(null)
getWindowsData()

disk_info = []

width = window.width
height = window.height

mainloop:
load_theme

window_changed_dimensions = false
if window.width != width or window.height != height (
  window_changed_dimensions = true
  width = window.width
  height = window.height
)

if current_tab == "no_perms" (
  if window.permissions.contains("windows") (
    current_tab = "Render Info"
  ) else (
    if current_tab == "no_perms" (
      loc 2 2 20 -20
      text "This Application requires window permissions to function properly" 10 : c#fff
      exit
    )
  )
)
if activity_info (
  loc 2 2 20 -20
  text name 10 : c#txtc
  loc 2 2 20 -50
  text round(dt ?? 0) + "fps" 15
  void updateDomMetrics()
  if timer - created_time > 1 (
    loc 2 2 90 -100
    square 140 25 10 : c#prim hover_c#seco
    if clicked (
      terminal "kill " ++ page
      window.close()
    )
    icon "close" 0.7 : c#txtc chx#-50

    text "Force Quit" 9 : chx#20
  )

  wwm = window_width / 30
  whm = window_height / 100
  if timer - last_timer > 0.05 (
    last_timer = timer
    dt = delta_time
    windows_list @= Windows()
    current = windows_list.getKeys("id").index(page)
    drawtimes @= (windows_list[current].render ?? "[]").JsonParse()
    name = windows_list[current].name
    dt = (1000 / (drawtimes[1] + 0.01)).clamp(1,1000)
    pr = drawtimes[2]
    void graph.append(dt / 1000)
    graph.delete(1)
  )
  c txtc
  loc 2 2 20 -150
  each i pr (
    set_x window.left + 20
    text i 10
    change_y -20
  )
  if dom_target_stats != null (
    dom_lines = [
      "vDOM nodes: " ++ dom_target_stats.records,
      "vDOM approx size: " ++ formatFileSize(dom_target_stats.approxBytes),
      "Attached: " ++ dom_target_stats.attached,
      "Detached: " ++ dom_target_stats.detached,
      "Pools: " ++ dom_target_stats.pools,
      "Persistent: " ++ dom_target_stats.persistent,
      "Canvas cache: " ++ formatFileSize(dom_target_stats.canvasBytes),
      "Writes/second: " ++ dom_writes_per_s.round(),
      "Writes/frame: " ++ dom_writes_per_frame.round() ++ " (" ++ dom_layout_state ++ ")",
      "Layout churn score: " ++ dom_layout_score.round()
    ]
  )
  if dom_target_stats == null (
    dom_lines = ["DOM stats unavailable for this process"]
  )
  loc 2 2 25 -350
  text dom_lines.join("\n") 8
  goto 150 -50
  c global_accent
  graph window_width - 300 window_height - 100 graph
  exit
)

wwm = window_width - 50 / 100
whm = window_height / 300
if !paused (
  // only add to the fps usage graph when not paused
  // fixes: https://discord.com/channels/1147362734300725298/1336340461555552319
  usage = (fps / fps_limit).clamp(0,1)
  graph.append(usage)
  if graph.len > 1000 (
    graph.delete(1)
  )
  frames = fps.round()
  high = max(high, frames)
  low *= 1.002
  low = min(low, frames)
)
if !paused and current_tab == "DOM" (
  void updateDomMetrics()
)
loc 2 2 23 - (frames.len * 5) -20
text frames 10 : c#txtc
loc 2 2 13.5 -40
text "fps" 7
loc 2 2 23 - (high.len * 5) -70
text high 10
loc 2 2 12 -90
text "high" 7
loc 2 2 23 - (round(low).len * 5) -120
text round(low) 10
loc 2 2 13.5 -140
text "low" 7
loc 2 2 23 - (delta.len * 5) -170
text delta 10
loc 2 2 13.5 -190
text "cpu" 7
if memory (
  ram_use = (roturLink.memory.percent ?? "Math.round(performance.memory.totalJSHeapSize/performance.memory.jsHeapSizeLimit*100)".eval()).round() ++ "%"
  loc 2 2 23 - (ram_use.len * 5) -220
  text ram_use 10
  loc 2 2 13.5 -240
  text "ram" 7
)
tab_w = 78
loc 2 2 100 -20
drawTab("Render Info", "Render")
loc 2 2 195 -20
drawTab("Performance", "Graph")
loc 2 2 290 -20
drawTab("Network", "Network")
loc 2 2 385 -20
drawTab("Disk", "Disk")
loc 2 2 480 -20
drawTab("DOM", "DOM")
loc 2 -2 25 25
c paused ? global_accent prim
square 25 25 10 : tooltip#Pause
if onclick (
  paused.not()
)
icon "w 3 line 5 10 -5 10 cont -10 5 cont -10 -5 cont -5 -10 cont 5 -10 cont 10 -5 cont 10 5 cont 5 10" 0.8 : c#txtc

updated = false
if timer - last_timer > next_update and !paused (
  last_timer = timer
  dt = delta_time
  getWindowsData()
  number cpu_usage = roturLink.cpu.percent ?? (windows_total_time / (1000 / fps_limit) * 100)
  cpu_percent = round(cpu_usage).clamp(1,100)
  delta = cpu_percent ++ "%"
  updated = true
)
switch current_tab (
  case "Performance"
    window "responsive" true
    goto 25 -40
    c global_accent
    graph max(100, window_width - 70) max(100, window_height - 100) graph
    break
  case "Network"
    info = [
      "connected   |   " ++ network.connected,
      "server      |   " ++ network.server,
      "username    |   " ++ network.username,
      "",
      "- Websocket",
      "upload      |   " ++ formatFileSize(network.upload),
      "download    |   " ++ formatFileSize(network.download),
      "total up    |   " ++ formatFileSize(network.uploadTotal),
      "total down  |   " ++ formatFileSize(network.downloadTotal)
    ]
    if roturLink.enabled (
      net = roturLink.network
      info ++= [
        "",
        "- Packets",
        "received    |   " ++ net.packets_received,
        "sent        |   " ++ net.packets_sent,
        "",
        "- Data",
        "received    |   " ++ formatFileSize(net.received),
        "sent        |   " ++ formatFileSize(net.sent)
      ]
    )
    loc 2 2 60 -60
    text info.join("\n") 10 : c#txtc
    break
  case "Render Info"
    // get an object of {window_id: {worker_id: worker_object, ...}, ...}
    object workers @= "window.origin.workers".eval()

    window "responsive" false
    loc 2 2 50 -45
    x = x_position
    y = y_position
    loc -2 -2 0 0
    c prim
    frame x y x_position y_position windows_names.len * 40 (
      y = frame.scroll - 20
      tot = 0
      w = frame_width - 20
      for count windows_names.len (
        loc 999 2 0 y
        square w 25 10 : c#prim
        if mouse_touching (
          square w 25 10 : c#seco
          if onclick (
            window.create(window.file.uuid, {
              passed_data: windows_ids[count],
              child: true
            })
          )
        )

        // handle right clicking
        if windows_ids[count] == -1 (
          loc 2 2 25 y
          icon "origin-logo" 0.7 : c#txtc
          text "System" 7 : chx#20 c#txtc
          loc -2 2 -15 y
          d = windows_drawtimes[count][1]
          rigtext d.toStr() ++ "ms" 7
          y -= 40
          continue
        )
        object win_top @= windows_list[count] ?? {}
        object win @= win_top.window ?? {file: {uuid: win_top.uuid}}
        rightclick_menu[1] = "> " ++ win.file.uuid
        rightclick rightclick_menu win

        file "open" win.file.uuid "onlyaccess"
        loc 2 2 25 y
        file "render" 1 : c#txtc
        text fileGet(2) 7 : c#txtc chx#20
        loc -2 2 -15 y
        d = windows_drawtimes[count][1]
        tot += d
        rigtext d.toStr() ++ "ms" 7
        y -= 40
      )
    )
    break
  case "DOM"
    dom_cache = dom_global.caches ?? {}
    dom_limits = dom_global.limits ?? {}
    dom_lines = [
      "DOM states: " ++ (dom_global.states ?? 0),
      "Pool count: " ++ (dom_global.pools ?? 0),
      "VDOM records: " ++ (dom_global.records ?? 0),
      "Attached nodes: " ++ (dom_global.attached ?? 0),
      "Detached nodes: " ++ (dom_global.detached ?? 0),
      "Persistent nodes: " ++ (dom_global.persistent ?? 0),
      "Pooled DOM nodes: " ++ (dom_global.pooledElements ?? 0),
      "Canvas texture bytes: " ++ formatFileSize(dom_global.canvasBytes ?? 0),
      "VDOM approx size: " ++ formatFileSize((dom_global.records ?? 0) * 180),
      "Image cache: " ++ (dom_cache.images ?? 0) ++ "/" ++ (dom_limits.images ?? 0) ++ " (" ++ formatFileSize(dom_cache.imageBytes ?? 0) ++ "/" ++ formatFileSize(dom_limits.imageBytes ?? 0) ++ ")",
      "Sprite cache: " ++ (dom_cache.sprites ?? 0) ++ "/" ++ (dom_limits.sprites ?? 0) ++ " (" ++ formatFileSize(dom_cache.spriteBytes ?? 0) ++ "/" ++ formatFileSize(dom_limits.spriteBytes ?? 0) ++ ")",
      "Image refs / names: " ++ (dom_cache.imageRefs ?? 0) ++ " / " ++ (dom_cache.imageNames ?? 0),
      "Writes/sec: " ++ dom_writes_per_s.round() ++ " | " ++ "writes/frame: " ++ dom_writes_per_frame.round() ++ " (" ++ dom_layout_state ++ ")",
      "Layout churn score: " ++ dom_layout_score.round()
    ]
    if dom_window_rows.len > 0 (
      dom_lines.append("")
      dom_lines.append("Top VDOM windows:")
      local list_len = dom_window_rows.len.clamp(0, 8)
      for i list_len (
        object row = dom_window_rows[i]
        dom_lines.append(row.name ++ " (#" ++ row.id ++ "): " ++ row.records ++ " nodes, " ++ row.attached ++ " attached, " ++ formatFileSize(row.canvasBytes) ++ ", score " ++ ((row.approxBytes / max(row.records, 1)).round() / 1.8).round())
      )
    )
    loc 2 2 85 -65
    text "DOM / VDOM profile" 12 : c#txtc
    loc 2 2 70 -90
    local dom_frame_left = x_position
    local dom_frame_top = y_position
    loc -2 -2 -20 20
    frame dom_frame_left dom_frame_top x_position y_position dom_lines.len * 20 + 50 (
      local dom_report_y = frame.scroll - 10
      loc 2 2 15 dom_report_y
      text dom_lines.join("\n") 10
    )
    break
  case "Disk"
    loc 2 2 60 -60
    text "- Rotur Cloud\n" 10 : c#txtc
    text disk_info.len > 0 ? disk_info.join("\n") "Usage data unavailable" 10

    if roturLink.enabled (
      local disk = roturLink.disk
      loc 2 2 60 -200
      text "- Hardware Disk\n" 10
      text "Free   |   " ++ formatFileSize(disk.free) ++ "\n" 10
      text "Used   |   " ++ formatFileSize(disk.used) ++ "\n" 10
      text "Size   |   " ++ formatFileSize(disk.total) ++ "\n" 10
    ) else (
      loc 2 2 60 -200
      text "- Hardware Disk\n" 10 : c#txtc
      text "Metrics unavailable in browser mode" 10
    )
    break
)
if mouse_down.not() (
  can = true
)

import "win-buttons"
