// this is a not finished WIP window manager for originOS written in OSL

permission "request" "windows"
permission "request" "javascript"
permission "request" "input monitoring"
window.setInputMonitoring(true)

def checkCollision(number x, number y, number w, number h) (
  local pointer_x = mouse_ondown ? mouse_press_x mouse_x
  local pointer_y = mouse_ondown ? mouse_press_y mouse_y
  return abs(pointer_x - x) < w / 2 and abs(pointer_y - y) < h / 2
)

// use the builtin version api
// normalise both version schemes to one scale: old integer style ("616",
// "620") becomes 6.16/6.20, new decimal style ("7.00") stays 7.00
version = origin.version.toNum()
if version >= 100 (
  version /= 100
)
capabilities = {}
if version != 0 and version < 6 (
  window.close()
)
// can we programatically open the right click menu?
capabilities.open_rightclick = version >= 6.1

origin @= "window.origin".eval()
// get the origin global object
// this gives us a shit ton of apis

if typeof(origin.windows.area) != "object" (
  origin.windows.area = {}
)
window_area @= origin.windows.area
window_area.top = window_area.top ?? 0
window_area.bottom = window_area.bottom ?? 0
window_area.right = window_area.right ?? 0
window_area.left = window_area.left ?? 0

window "responsive" true
// the window manager belongs to every space, it must never slide away with one
window.no_desktop = true

number hitbox_size = 13

number x2 = hitbox_size * 2
number x25 = hitbox_size / 4

def tileWindow(win, position) (
  if win.restore_bounds == null (
    win.restore_bounds = {
      x: win.x,
      y: win.y,
      width: win.width,
      height: win.height
    }
  )
  local bottom = screen.y / -2 + max(0, window_area.bottom)
  local win_top = screen.y / 2 - max(0, window_area.top)
  local left = screen.x / -2 + max(0, window_area.left)
  local right = screen.x / 2 - max(0, window_area.right)
  local width = right - left
  if position == "top" (
    win.tile = "0,-1"
  ) else if position == "left" (
    local desktop @= "origin.desktop".eval()
    width = desktop.split[desktop.current + 1] * width
    win.tile = "-1,0"
    right = left + width
  ) else (
    local desktop @= "origin.desktop".eval()
    width = (1 - desktop.split[desktop.current + 1]) * width
    win.tile = "1,0"
    left = right - width
  )
  win.target_x = (left + right) / 2
  win.target_y = (bottom + win_top) / 2
  win.target_width = width
  win.target_height = win_top - bottom
)

def dragEdge(prop, axis) (
  if !mouse_down (
    state.dragEdge = null
    return
  )
  if mouse_moving (
    local pos = top.tile
    if pos == null (
      pos = ""
    )
    if axis == "x" (
      if pos.startsWith("-1,") or pos.startsWith("1,") (
        local desktop @= "origin.desktop".eval()
        local mouse = pos[1] == "-" ? -mouse_x mouse_x
        local left = screen.x / -2 + max(0, window_area.left)
        local right = screen.x / 2 - max(0, window_area.right)
        local available = right - left
        local split = (abs(state.resize1 + mouse) / available).clamp(0.3, 0.7)
        desktop.split[desktop.current + 1] = split

        for i wins.len (
          local cur @= wins[i].window
          local tile = cur.tile
          if typeof(tile) != "string" (
            continue
          )
          if (cur.desktop ?? 0).toNum() == desktop.current.toNum() and (tile.startsWith("-1,") or tile.startsWith("1,")) (
            if tile[1] == "-" (
              cur.width = split * available - 5
              cur.x = left + (split * available / 2) - 3
            ) else (
              cur.width = (1 - split) * available - 5
              cur.x = right - ((1 - split) * available / 2) - 3
            )
            cur.target_x = null
            cur.callRender()
          )
        )
      ) else (
        top.width = abs(state.resize1 - mouse_x).clamp(top.min_width, 999999)
        top.x = state.resize1 + (top.width / state.div)
        top.target_x = null
      )
    ) else (
      top.height = abs(state.resize2 - mouse_y).clamp(top.min_height, 999999)
      top.y = state.resize2 + (top.height / state.div)
      top.target_y = null
    )
    top.callRender()
  )
)

def dragDiagonal() (
  if !mouse_down (
    state.dragDiag = null
    return
  )
  if mouse_moving (
    top.width = abs(state.resize1 - mouse_x).clamp(top.min_width, 999999)
    top.height = abs(state.resize2 - mouse_y).clamp(top.min_height, 999999)
    top.x = state.resize1 + (top.width / state.div1)
    top.y = state.resize2 + (top.height / state.div2)
    top.target_x = null
    top.target_y = null

    local w = top.width / 2
    local h = top.height / 2

    top.callRender()
  )
)

// holding a dragged window against a side edge carries it to the next space
def carryToSpace() (
  local edge = 0
  if mouse_x < screen.x / -2 + 10 (
    edge = -1
  ) else if mouse_x > screen.x / 2 - 10 (
    edge = 1
  )
  if edge == 0 (
    state.move.edge = 0
    state.move.switched = false
    return
  )
  local desktop @= "origin.desktop".eval()
  local next = desktop.current + edge
  local count = (desktop.count ?? 5).toNum().clamp(1, 5)
  if top.no_desktop == true or next < 0 or next >= count or desktop.multiplier != desktop.current (
    return
  )
  // carrying the only window of a space into an empty one would just be renumbered back
  local staying = 0
  local waiting = 0
  for i wins.len (
    local other @= wins[i].window
    if other.no_desktop == true or other.desktop_layer == true or other.id == top.id or other.width == 0 (
      continue
    )
    if (other.desktop ?? 0).toNum() == desktop.current.toNum() (
      staying ++
    )
    if (other.desktop ?? 0).toNum() == next (
      waiting ++
    )
  )
  if staying == 0 and waiting == 0 (
    return
  )
  if state.move.edge != edge (
    state.move.edge = edge
    state.move.edge_at = timer
    return
  )
  local held = timer - state.move.edge_at
  if held > 0.7 (
    // pinned while the spaces slide so the window stays under the pointer.
    // carried tells the dock this is still a normal window on a space
    top.desktop = next
    top.carried = true
    top.no_desktop = true
    state.carry @= top
    desktop.current = next
    state.move.edge_at = timer
    state.move.switched = true
  )
)

def moveWindow() (
  if !mouse_down (
      local win_top = screen.y / 2 - max(0, window_area.top)
      local left = screen.x / -2 + max(0, window_area.left)
      local right = screen.x / 2 - max(0, window_area.right)
      if state.move.switched == true (
        // the edge was used to change space, so it must not also tile on release
      ) else if mouse_y > win_top - 13 (
        tileWindow(top, "top")
      ) else if mouse_x < left + 13 (
        tileWindow(top, "left")
      ) else if mouse_x > right - 13 (
        tileWindow(top, "right")
      )
      state.move = null
      return
    )
    state.dragDiag = null
    state.cursor = "grabbing"
    carryToSpace()
    if mouse_moving (
      if top.tile != null (
        local relative_x = (mouse_x - top.x) / top.width
        local relative_y = (mouse_y - top.y) / top.height
        local restore @= top.restore_bounds ?? {}

        top.tile = null
        top.target_width = restore.width ?? 700
        top.target_height = restore.height ?? 450
        top.restore_bounds = null

        top.x = mouse_x - (relative_x * top.target_width)
        top.y = mouse_y - (relative_y * top.target_height)

        state.move.x = top.x
        state.move.y = top.y
      ) else (
        top.x = state.move.x + (mouse_x - state.move.mouse_x)
        top.y = state.move.y + (mouse_y - state.move.mouse_y)
        state.move.x = top.x
        state.move.y = top.y
      )
      top.target_x = null
      top.target_y = null
      state.move.mouse_x = mouse_x
      state.move.mouse_y = mouse_y
      top.callRender()
    )
)

def handleResize() (
  number leftEdge = top.left.toNum()
  number rightEdge = top.right.toNum()
  number topEdge = top.top.toNum()
  number bottomEdge = top.bottom.toNum()
  number height = top.height.toNum()
  number width = top.width.toNum()

  object resizable = {}
  if typeof(top.resizable) == "object" (
    resizable = top.resizable
  )
  if top.resizable == false (
    resizable = {
      left: false,
      right: false,
      top: false,
      bottom: false
    }
  )

  // left edge
  if resizable.left != false and checkCollision(x + leftEdge, y, hitbox_size, topEdge - x25) (
    state.cursor = "ew-resize"
    if mouse_ondown (
      state.changeState("left","width")
    )
  )
  // right edge
  if resizable.right != false and checkCollision(x + rightEdge, y, hitbox_size, height - x25) (
    state.cursor = "ew-resize"
    if mouse_ondown (
      state.changeState("right","width")
    )
  )

  if top.tile == null (
    // top edge
    if resizable.top != false and checkCollision(x, y + topEdge, width - x25, hitbox_size) (
      state.cursor = "ns-resize"
      if mouse_ondown (
        state.changeState("top","height")
      )
    )
    // bottom edge
    if resizable.bottom != false and checkCollision(x, y + bottomEdge, width - x25, hitbox_size) (
      state.cursor = "ns-resize"
      if mouse_ondown (
        state.changeState("bottom","height")
      )
    )

    // top right
    if resizable.right != false and resizable.top != false and checkCollision(x + rightEdge, y + topEdge, x2, x2) (
      state.cursor = "nesw-resize"
      if mouse_ondown (
        state.changeState("right,top","both")
      )
    )

    // bottom right
    if resizable.right != false and resizable.bottom != false and checkCollision(x + rightEdge, y + bottomEdge, x2, x2) (
      state.cursor = "nwse-resize"
      if mouse_ondown (
        state.changeState("right,bottom","both")
      )
    )

    // top left
    if resizable.left != false and resizable.top != false and checkCollision(x + leftEdge, y + topEdge, x2, x2) (
      state.cursor = "nwse-resize"
      if mouse_ondown (
        state.changeState("left,top","both")
      )
    )

    // bottom left
    if resizable.left != false and resizable.bottom != false and checkCollision(x + leftEdge, y + bottomEdge, x2, x2) (
      state.cursor = "nesw-resize"
      if mouse_ondown (
        state.changeState("left,bottom","both")
      )
    )
  )
)

def handleMove() (
  local pointer_x = mouse_ondown ? mouse_press_x mouse_x
  local pointer_y = mouse_ondown ? mouse_press_y mouse_y
  drag @= top.dragbox[1]
  if typeof(drag) != "array" (
    return
  )
  goto x y
  change top.width / -drag[1].toNum() + drag[3].toNum() top.height / drag[2].toNum() + drag[4].toNum()
  if pointer_x < x_position or pointer_y > y_position (
    return
  )

  drag @= top.dragbox[2]
  if typeof(drag) != "array" (
    return
  )
  goto x y
  change top.width / -drag[1].toNum() + drag[3].toNum() top.height / drag[2].toNum() + drag[4].toNum()
  if pointer_x > x_position or pointer_y < y_position (
    return
  )
  state.cursor = "grab"
  if mouse_right (
    if capabilities.open_rightclick (
      goto mouse_x mouse_y
      open_rightclick [
        [
          "Move to space",
          {"Space 1": def(win) -> (
            win.desktop = 0
          )},
          {"Space 2": def(win) -> (
            win.desktop = 1
          )},
          {"Space 3": def(win) -> (
            win.desktop = 2
          )},
          {"Space 4": def(win) -> (
            win.desktop = 3
          )},
          {"Space 5": def(win) -> (
            win.desktop = 4
          )}
        ].trim(1, (desktops.count ?? 1).toNum().clamp(1, 5) + 1),
        {"Show App in Files": def(win) -> (
          window.create("/(a) system/user applications/Files.osl", {
            passed_data: win.file.uuid
          })
        )},
        {"Application Info": def(win) -> (
          window.create("/(a) system/system apps/Files_Info.osl", {
            passed_data: win.file.uuid
          })
        )},
        "-",
        {"Fullscreen Window": def(win) -> (
          // these dont work on other windows yet, they work in current context
          // win.fullscreen()
        )},
        {"Minimise Window": def(win) -> (
          // win.minimise()
        )},
        {"Close Window": def(win) -> (
          win.close()
        )}
      ] top
    )
  )
  if mouse_ondown (
    state.dragDiag = null
    state.dragEdge = null
    state.move = {
      x: top.x,
      y: top.y,
      mouse_x: mouse_ondown ? mouse_press_x mouse_x,
      mouse_y: mouse_ondown ? mouse_press_y mouse_y,
      tile: top.tile
    }
  )
)

def handleTop() (
  local nodragging = state.dragEdge == null and state.dragDiag == null and state.move == null
  if nodragging and !file_dragging (
    local space = desktops.current.toNum()
    for i wins.len (
      local cur @= wins[i].window
      // windows on another space share these coordinates but are not on screen
      if cur.no_desktop != true and (cur.desktop ?? 0).toNum() != space (
        continue
      )
      x = cur.x.toNum()
      y = cur.y.toNum()
      local hovering = checkCollision(x, y, (cur.width + x2).toNum(), (cur.height + x2).toNum())
      local isntMini = true
      if cur.isMini != null (
        isntMini = cur.isMini().not()
      )
      if hovering and cur.shown and isntMini (
        top @= cur
        if mouse_ondown and i > 1 (
          void top.focus()
        )
        if cur.isResizable() (
          handleResize()
        )
        handleMove()
        break
      )
    )
  )
  nodragging = state.dragEdge == null and state.dragDiag == null and state.move == null
  if nodragging (
    top @= {}
    return
  )
  if top.shown (
    if state.dragEdge != null (
      dragEdge(state.prop,state.axis)
    )
    if state.dragDiag != null (
      dragDiagonal()
    )
    if state.move != null (
      moveWindow()
    )
  )
)

def handleKeybinds(keybinds) (
  local modifiers @= keybinds.getKeys()
  for i modifiers.len (
    // keynames
    local mod = modifiers[i]
    if mod.isKeyDown().not() (
      continue
    )
    local binds @= keybinds[mod]
    local keys @= binds.getKeys()
    for j keys.len (
      local key = keys[j]
      if key.onKeyDown().not() (
        continue
      )
      try (
        void function("", binds[key])()
      )
    )
  )
)

state = {
  dragEdge: null,
  dragDiag: null,
  move: null,
  carry: null,
  changeState: def(edge,prop) -> (
    if prop == "both" (
      self.dragDiag = edge.split(",")
      self.axis = "both"
      self.div1 = dragDiag[1] == "left" ? -2 2
      self.div2 = dragDiag[2] == "bottom" ? -2 2
      self.resize1 = top.x - (top.width / div1)
      self.resize2 = top.y - (top.height / div2)
    ) else (
      self.dragEdge = edge
      self.axis = ["width"].contains(prop) ? "x" "y"
      self.div = ["left","bottom"].contains(edge) ? -2 2
      self.resize1 = top.x - (top.width / div)
      self.resize2 = top.y - (top.height / div)
    )

    self.prop = prop
    self.last_size = top[prop]
    self.pos = top.tile
  )
}

array wins = []

window.resize(0,0)

mainloop:

wins @= Windows()

handleKeybinds(origin.keyboard.keybinds)

screen = {
  x: screensize_x,
  y: screensize_y
}

if !mouse_down (
  state.cursor = null
)

handleTop()
if state.carry != null (
  local desktop @= "origin.desktop".eval()
  if desktop.multiplier == desktop.current (
    state.carry.no_desktop = false
    state.carry.carried = false
    state.carry = null
  )
)
if state.cursor != null (
  eval ("origin.cursorOverride = '" ++ state.cursor ++ "'")
) else (
  eval "origin.cursorOverride = null"
)
