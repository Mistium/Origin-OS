// Description: Renames the file or folder whose uuid is given as passed_data

import "window_tools"

window "dimensions" 340 176
window "resizable" False
window "show"
file "open" passed_data "onlyaccess"

folder = fileGet(1) === ".folder"
old_name = fileGet(2).toStr()
inputs.main = old_name
heading = "Rename Folder"
if !folder (
  inputs.main = old_name ++ fileGet(1)
  heading = "Rename File"
)
button_click = false

// a text button, result in `button_click`
def "text_button" "label, w, fill, ink" (
  hit w 32
  button_click = onclick
  if mouse_touching (
    cursor "pointer"
  )
  box w 32 14 : c#fill
  centext label 9 : c#ink
)

mainloop:
load_theme

goto window.left + 20 window.top - 26
text heading 11 : c#txtc
goto window.left + 20 window.top - 48
text old_name.trimText(36) 8 : c#muted

goto 0 window.top - 86
box 300 34 12 : c#hover_col
c hover_col
input 284 26 "main" "New name" 9 txtc

// files keep everything after the last dot as their type
local name = inputs.main.toStr().strip()
local parts = name.split(".")
local ext = parts.last()
local base = parts.trim(1, parts.len - 1).join(".")
local valid = name != "" and (folder or (parts.len > 1 and ext != "" and base != ""))

goto -78 window.bottom + 36
text_button "Cancel" 144 prim txtc
if button_click (
  window "stop"
)
goto 78 window.bottom + 36
if valid (
  text_button "Rename" 144 global_accent accent_txt
  if button_click or "enter".onKeyDown() (
    if folder (
      file "set" 2 name
    ) else (
      file "set" 2 base
      file "set" 1 "." ++ ext
    )
    window "stop"
  )
) else (
  box 144 32 14 : c#prim
  centext "Rename" 9 : c#muted
)
