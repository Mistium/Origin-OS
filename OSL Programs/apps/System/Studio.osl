// Developer: @Mistium
// Description: Code editor for originOS
//
// Layout: a tab strip per split across the top, the splits below it, an optional
// explorer panel on the right and a status bar. `split_tabs` is the model, each
// entry is {tabs, cur}. While a split is being drawn `tabs` and `current_tab`
// alias that split. Sizes passed to `box` are the visible size, OSL arithmetic
// runs left to right.

file "use_type" "txt"
save "Studio" "set_directory"

permission "request" "file admin"
permission "request" "notifications"

// tabs mirror the window buttons: 27 tall, centred 21 below the top, 6 in from the edge
TAB_H = 42
TOOL_H = 34
STATUS_H = 24

array pickers = []

state = {
  folder: null,
  is_opal: false,
  folder_sidebar: false,
  folder_sidebar_width: 280,
  open_folders: [],
  folder_list_len: 0,
  linked_windows_scroll: [0, 0],
  linked_windows_height: 0,
  linked_windows: [],

  // fractions of the width for each split, they add to 1
  split_sizes: [1],
  split_resizing: 0,
  split_resize_start_x: 0,
  split_resize_start_left: 0,
  split_resize_start_right: 0,

  folder_resizing: false,
  folder_resize_start_x: 0,
  folder_resize_start_w: 280,
  draw_highlight: [0, 0]
}

number right = 0
number right_smooth = 0
boolean uses_mouse = ["Windows", "Linux"].contains(system_os)

inputs.linked_windows = []
inputs.name = ""

// what the status bar describes, set by whichever editor has the cursor
status_tab = null
status_cursor = null

tab_dragging = false
tab_drag_candidate = null
tab_drag_tab = null
tab_drag_from_split = 0
tab_drag_from_index = 0
tab_close_lock = false
tab_width = 0
current_tab_target = 0
current_split_target = 0
current_tab_split = 1
tool_click = false

// ---------------------------------------------------------------- palette

// ponytail: Studio names its theme colours c_prim, c_text and so on, so it keeps its own copy of the
// window_tools palette. Switch to load_theme when those names are retired.
def hex_channels(string value) array (
  local hex = value.replace("#", "")
  if hex.len == 3 (
    hex = hex[1] ++ hex[1] ++ hex[2] ++ hex[2] ++ hex[3] ++ hex[3]
  )
  local out = []
  for ch 3 (
    void out.append(hex.trim(ch * 2 - 1, ch * 2).toBase(16, 10).toNum())
  )
  return out
)

def mix(string a, string b, number t) string (
  local ca = hex_channels(a)
  local cb = hex_channels(b)
  local out = "#"
  for ch 3 (
    local mixed = round((ca[ch] * (1 - t)) + (cb[ch] * t))
    local part = mixed.toStr().toBase(10, 16).toStr().toLower()
    if part.len < 2 (
      part = "0" ++ part
    )
    out ++= part
  )
  return out
)

def readable_on(string a) string (
  local ca = hex_channels(a)
  if ((ca[1] * 0.299) + (ca[2] * 0.587) + (ca[3] * 0.114)) > 150 (
    return "#111111"
  )
  return "#ffffff"
)

palette_key = ""
muted = "#888888"
hover_col = "#333333"
edge_col = "#333333"
track_col = "#555555"
gutter_col = "#111111"
accent_txt = "#ffffff"

def "refresh_palette" (
  local theme = user.theme
  c_prim = theme.primary
  c_seco = theme.secondary
  c_text = theme.text
  window_colour = theme.background
  local key = c_prim ++ c_seco ++ c_text ++ window_colour ++ global_accent
  if key != palette_key (
    palette_key = key
    muted = mix(c_text, c_prim, 0.42)
    hover_col = mix(c_prim, c_seco, 0.4)
    edge_col = mix(c_prim, c_text, 0.14)
    track_col = mix(c_prim, c_text, 0.3)
    gutter_col = mix(window_colour, c_prim, 0.5)
    accent_txt = readable_on(global_accent)
  )
)

// ---------------------------------------------------------------- drawing helpers

// a filled rounded box, w and h are the visible size and r the corner diameter
def "box" "w, h, r" (
  square w - r h - r r
)

// an invisible hit area, sets mouse_touching / onclick / clicked
def "hit" "w, h" (
  square w h 0 0 1
)

// the strip under the tabs that holds a tab's buttons, leaves the pen on the first slot
def "toolbar_begin" (
  goto 0 frame.top - (TOOL_H / 2)
  square frame.width TOOL_H 0 : c#window_colour
  goto 0 frame.top - TOOL_H
  square frame.width 0 1 : c#edge_col
  goto frame.left + 22 frame.top - (TOOL_H / 2)
)

// one toolbar button, moves the pen to the next slot, result in `tool_click`
def "tool" "icn, tip, size" (
  hit 28 26
  tool_click = onclick
  if mouse_touching (
    cursor "pointer"
    box 28 26 10 : c#hover_col tooltip#tip
  )
  icon icn size : c#c_text
  change_x 32
)

// a centred icon and message for a tab with nothing to show
def "empty_state" "icn, message" (
  goto 0 10
  icon icn 2 : c#track_col
  goto 0 -40
  centext message 9.5 : c#muted
)

// ---------------------------------------------------------------- tabs model

def remember_recent(uuid) (
  recent = recent.delete(uuid).prepend(uuid).trim(1, 10)
  save "recent_files.json" "set" recent
)

def file_tab(uuid) (
  local name = open(uuid, ["name", "type"])
  remember_recent(uuid)
  return {
    type: "file",
    name: name.join(""),
    id: ouidNew(),
    data: open(uuid).toStr().split("\n"),
    uuid: uuid,
    ohf: compileOHF(getOHF(name[2])),
    func: editor.renderNorm
  }
)

def welcome_tab() (
  return {
    type: "welcome",
    name: "Welcome",
    id: ouidNew(),
    func: pages.home
  }
)

def "add_tab" "data" (
  data.id ??= ouidNew()
  void tabs.append(data)
  current_tab = tabs.len
)

def "insert_tab" "index, data" (
  data.id ??= ouidNew()
  tabs ??= []
  tabs.insert(index, data)
  current_tab = index
)

// opens a file in the current split, or focuses its tab when it is already open there
def "open_file_tab" "uuid" (
  for i tabs.len (
    if tabs[i].type == "file" and tabs[i].uuid == uuid (
      current_tab = i
      return
    )
  )
  add_tab file_tab(uuid)
)

// focuses the first tab matching `kind` and `source`, otherwise adds `data`
def "focus_or_add_tab" "kind, source, data" (
  for i tabs.len (
    if tabs[i].type == kind and (source == null or tabs[i].source_tab_id == source) (
      current_tab = i
      return
    )
  )
  add_tab data
)

def ensureSplitSizes() (
  local n = split_tabs.len
  if n <= 0 (
    state.split_sizes = [1]
    return
  )
  if typeof(state.split_sizes) != "array" or state.split_sizes.len != n (
    state.split_sizes = []
    for i n (
      void state.split_sizes.append(1 / n)
    )
  )
  local sum = 0
  for i n (
    state.split_sizes[i] = (state.split_sizes[i] ?? (1 / n)).toNum().clamp(0.08, 0.92)
    sum += state.split_sizes[i]
  )
  if sum != 0 (
    for i n (
      state.split_sizes[i] /= sum
    )
  )
)

def open_folder(uuid) (
  state.folder = uuid
  state.open_folders = []
  state.is_opal = open(uuid, ["location", "name"]).join("/").listFolder().contains("opal.json")
  recent_folders = recent_folders.delete(uuid).prepend(uuid).trim(1, 8)
  save "recent_folders.json" "set" recent_folders
)

// ---------------------------------------------------------------- syntax highlighting

def getOHF(string type) (
  type = type.toUpper()
  if type.startsWith(".") (
    type = type.trim(2, -1)
  )
  string name = type ++ ".ohf"
  // cached definitions are reused for a day
  if name.saveExists() and timestamp - name.saveGet(10) < 86400000 (
    return name.saveGet()
  )
  local OHF = requests.get("https://origin.mistium.com/Other/OHF/" ++ type ++ ".ohf")
  if OHF.status != 200 (
    if name.saveExists() (
      return name.saveGet()
    )
    return null
  )
  local parsed = OHF.body.JsonParse()
  save name "set" parsed
  return parsed
)

def compileOHF(ohf) (
  if typeof(ohf) != "object" (
    return ""
  )
  local output = {
    tokens: {},
    overrides: {},
    parser: {}
  }
  try (
    if ohf.categories != null (
      each o ohf.categories.getValues() (
        each r o.tokens (
          output.tokens["tkn:" ++ r] = o.color
        )
      )
    )
    if ohf.overrides != null (
      each o ohf.overrides.getKeys() (
        output.overrides[o] = ohf.overrides[o]
      )
    )
    output.parser = ohf.parser ?? {}
    output.highlighter = ohf.highlighter ?? {}
  ) catch o (
    error o
    return ""
  )
  return output
)

// ---------------------------------------------------------------- pages

class pages (
  def home() (
    goto 0 0
    square frame.width frame.height 0 : c#window_colour
    local cw = min(frame.width - 40, 760)
    local col = cw / 2 - 10
    local left = cw / -2
    local top = frame.top - 34

    goto left top
    text "Studio" 16 : c#c_text
    goto left top - 28
    text "Write and run code for originOS" 9 : c#muted

    // start column
    local x = left + (col / 2)
    local y = top - 78
    goto left y
    text "START" 7.5 : c#muted
    y -= 34
    goto x y
    box col + 2 34 14 : c#edge_col
    box col 32 12 : c#c_prim
    c c_prim
    input col - 20 24 "name" "New file name, like hello.osl" 9 c_text
    local dot = inputs.name.index(".")
    local valid = dot > 1 and dot < inputs.name.len
    y -= 42
    goto x y
    hit col 32
    local create = onclick and valid
    if valid (
      if mouse_touching (
        cursor "pointer"
      )
      box col 32 12 : c#global_accent
      centext "Create File" 9 : c#accent_txt
    ) else (
      box col 32 12 : c#hover_col
      centext "Create File" 9 : c#muted
    )
    if create or (valid and selected_input == "name" and "enter".onKeyDown()) (
      file "download" inputs.name
      add_tab file_tab(data)
      inputs.name = ""
    )
    y -= 42
    goto x y
    hit col 32
    if mouse_touching (
      cursor "pointer"
      box col 32 12 : c#hover_col
    ) else (
      box col + 2 34 14 : c#edge_col
      box col 32 12 : c#window_colour
    )
    if onclick (
      // the picker answers with a transmit, remember which windows may answer
      file "pick"
      void pickers.append(data)
    )
    centext "Open File..." 9 : c#c_text
    y -= 42
    goto x y
    hit col 32
    if mouse_touching (
      cursor "pointer"
      box col 32 12 : c#hover_col
    ) else (
      box col + 2 34 14 : c#edge_col
      box col 32 12 : c#window_colour
    )
    if onclick (
      state.folder_sidebar = true
    )
    centext "Open Folder..." 9 : c#c_text

    // recent column
    local rx = left + col + 20
    goto rx top - 78
    text "RECENT" 7.5 : c#muted
    if recent.len == 0 (
      goto rx top - 112
      text "Files you save show up here" 9 : c#muted
      return
    )
    frame rx - 8 top - 92 rx + col + 8 frame.bottom + 8 recent.len * 36 + 8 "cache@recent" (
      local w = frame.width - 12
      for i recent.len (
        local uuid = recent[i].toStr()
        file "uuid_exists" uuid
        if !exists (
          void recent.delete(i)
          save "recent_files.json" "set" recent
          break
        )
        goto 0 frame.top - 4 + frame.scroll - (i - 0.5 * 36)
        hit w 32
        if mouse_touching (
          cursor "pointer"
          box w 32 12 : c#hover_col
        )
        if onclick (
          open_file_tab uuid
        )
        local name = open(uuid, ["name", "type", "location"])
        goto w / -2 + 20 y_position
        file "render" 0.8
        text (name[1] ++ name[2]).trimText(w - 60 / 9) 9 : c#c_text chx#22
      )
    )
  )
)

class editor (
  def renderNorm() (
    local tab @= tabs[current_tab]
    goto 0 TOOL_H / -2
    inputs[tab.id] @= tab.data
    c window_colour
    textbox frame.width frame.height - TOOL_H tab.id 0 {
      line_numbers: {
        bg_colour: gutter_col
      },
      sel_colour: track_col,
      text_colour: c_text,
      ohf: tab.ohf
    }

    // lint messages sit at the end of the line they belong to
    local sel @= inputs.selected
    local err @= (tab.errors ?? []).sortBy("line")
    local data @= inputs[tab.id]
    local offset = data.len.toStr().len * 8 + 30
    for i err.len (
      local cur @= err[i]
      if err[i - 1].line == cur.line (
        continue
      )
      goto frame.left + (data[cur.line].len * 10 + offset) frame.top - 44.5 - (cur.line - 1 * 23) + tab.scroll.y
      if y_position < frame.top - TOOL_H - 8 and y_position > frame.bottom (
        text cur.message 10 : c#f87171
      )
    )
    if status_tab == null (
      status_tab @= tab
    )
    if sel.id == tab.id (
      tab.scroll @= sel.scroll
      status_tab @= tab
      status_cursor @= sel.cursor
      if sel.changed (
        tab.unsaved = true
        tab.data @= inputs[tab.id]
        if tab.name.endsWith(".osl") and "lintSyntax" in osl (
          tab.errors @= osl.lintSyntax(tab.data.join("\n")).errors
        )
      )
    )

    toolbar_begin
    editorButtons(tab)
  )
)

class icnPreview (
  def render() (
    local tab @= tabs[current_tab]
    tab.icn_state ??= {
      display: [0, 0],
      last_display: [0, 0],
      mouse: [0, 0],
      zoom: 1
    }
    local icn @= tab.icn_state
    frame frame.left frame.top - TOOL_H frame.right frame.bottom (
      goto 0 0
      square frame.width frame.height 0 : c#window_colour
      local lines = []
      if tab.source_input != null and inputs[tab.source_input] != null (
        lines @= inputs[tab.source_input]
      ) else if tab.source_uuid != null (
        lines = open(tab.source_uuid).split("\n")
      )

      if mouse_touching (
        if mouse_down (
          cursor "grabbing"
          icn.display = icn.last_display - (icn.mouse - [mouse_x, mouse_y])
        ) else (
          cursor "grab"
          icn.last_display = icn.display
          icn.mouse @= [mouse_x, mouse_y]
        )
        icn.zoom += uses_mouse ? scroll_velocity / -100 scroll_velocity / 10
        icn.zoom = icn.zoom.clamp(0.1, 20)
      ) else if !mouse_down (
        icn.last_display = icn.display
        icn.mouse @= [mouse_x, mouse_y]
      )

      // axes through the origin, then the icon itself
      goto icn.display
      c edge_col
      icon "w 0 square 0 0 10 9999 square 0 0 9999 10 w 5 c" + c_text + lines.join(" ") icn.zoom
    )

    toolbar_begin
    tool "minus" "Zoom out" 0.6
    if tool_click (
      icn.zoom = (icn.zoom / 1.25).clamp(0.1, 20)
    )
    tool "add" "Zoom in" 0.6
    if tool_click (
      icn.zoom = (icn.zoom * 1.25).clamp(0.1, 20)
    )
    tool "target" "Reset view" 0.6
    if tool_click (
      icn.zoom = 1
      icn.display = [0, 0]
      icn.last_display = [0, 0]
    )
    goto frame.right - 16 frame.top - (TOOL_H / 2)
    rigtext round(icn.zoom * 100) ++ "%" 8.5 : c#muted
  )
)

// pulls new log lines out of the windows started from the run button
def updateLinkedWindowLogs() (
  for i state.linked_windows.len (
    local cur @= state.linked_windows[i]
    local win @= cur.context.window
    local logs @= win.logs
    if cur.total_logs < logs.len (
      for j logs.len - cur.total_logs (
        local log @= logs[cur.total_logs + j]
        local idx @= log.index(": ")
        if idx != -1 (
          log @= log.trim(idx + 2, -1)
        )
        void inputs.linked_windows.append(log)
      )
      cur.total_logs = logs.len
    )
    if win.dead (
      void state.linked_windows.delete(i)
      i --
    )
  )
)

class logsTab (
  def render() (
    goto 0 0
    square frame.width frame.height 0 : c#window_colour
    toolbar_begin
    tool "bin" "Clear logs" 0.6
    if tool_click (
      inputs.linked_windows = []
      state.linked_windows_scroll = [0, 0]
      for i state.linked_windows.len (
        state.linked_windows[i].total_logs = 0
      )
    )
    goto frame.right - 16 frame.top - (TOOL_H / 2)
    rigtext state.linked_windows.len ++ " running" 8.5 : c#muted

    if inputs.linked_windows.len == 0 (
      empty_state "terminal" "Run an osl file to see its logs here"
      return
    )

    // newest line at the bottom, drawn upwards until the frame is full
    local lscroll @= state.linked_windows_scroll
    frame frame.left frame.top - TOOL_H frame.right frame.bottom state.linked_windows_height "cache@logs_tab" (
      if mouse_x > frame.left and mouse_x < frame.right and mouse_y > frame.bottom and mouse_y < frame.top (
        lscroll[2] -= scroll.y.velocity
        lscroll[2] = lscroll[2].clamp(0, state.linked_windows_height)
      )
      local x = frame.left + 16
      goto x frame.bottom + 20 - lscroll[2]
      local i = inputs.linked_windows.len
      local w = frame.width / 9 - 5
      local hgt = 0
      loop i (
        local parts = inputs.linked_windows[i].toStr().wrapText(w).split("\n")
        local j = parts.len
        loop j (
          set_x x
          text parts[j] 9 : c#c_text
          change_y 20
          hgt += 20
          if y_position > frame.top + 20 (
            break
          )
          j --
        )
        change_y 8
        hgt += 8
        i --
      )
      state.linked_windows_height = hgt
    )
  )
)

class searchTab (
  def render() (
    local tab @= tabs[current_tab]
    goto 0 0
    square frame.width frame.height 0 : c#window_colour
    toolbar_begin

    local input_id = "search_" ++ tab.id
    local iw = frame.width - 24
    goto 0 frame.top - (TOOL_H / 2)
    box iw 24 10 : c#c_prim
    goto iw / -2 + 14 y_position
    icon "search" 0.45 : c#muted
    goto 10 y_position
    c c_prim
    input iw - 40 22 input_id "Search in " ++ (tab.source_name ?? "file") 9 c_text
    local q = (inputs[input_id] ?? "").toStr()

    tab.last_q ??= ""
    tab.results ??= []
    if q != tab.last_q (
      tab.last_q = q
      tab.results = []
      local lines = []
      if tab.source_input != null and inputs[tab.source_input] != null (
        lines @= inputs[tab.source_input]
      ) else if tab.source_uuid != null (
        lines @= open(tab.source_uuid).split("\n")
      )
      local q2 = q.toUpper()
      if q2.len > 0 (
        for i lines.len (
          local line = lines[i].toStr()
          if line.toUpper().contains(q2) (
            void tab.results.append({
              line: i,
              text: line.strip()
            })
          )
          if tab.results.len >= 200 (
            break
          )
        )
      )
    )

    local results @= tab.results
    if q.len == 0 (
      empty_state "search" "Type to search this file"
      return
    )
    if results.len == 0 (
      empty_state "search" "No results"
      return
    )

    frame frame.left frame.top - TOOL_H frame.right frame.bottom results.len * 26 + 8 "cache@search_tab" (
      local w = frame.width - 12
      local first = max(0, floor(frame.scroll / 26))
      local i = first
      loop min(results.len - first, ceil(frame.height / 26) + 1) (
        i ++
        local r @= results[i]
        goto 0 frame.top - 4 + frame.scroll - (i - 0.5 * 26)
        hit w 24
        if mouse_touching (
          cursor "pointer"
          box w 24 10 : c#hover_col
        )
        if onclick and tab.source_tab_id != null (
          // jump to the file's tab with the cursor on that line
          for t tabs.len (
            if tabs[t].id == tab.source_tab_id (
              current_tab = t
              input "focus" tab.source_tab_id
              input "move_cursor" r.line 0
              break
            )
          )
        )
        goto frame.left + 52 y_position
        rigtext r.line.toStr() 8.5 : c#muted
        goto frame.left + 64 y_position
        text r.text.trimText(w - 70 / 9) 9 : c#c_text
      )
    )
  )
)

// ---------------------------------------------------------------- editor toolbar

def saveTab(tab) (
  file "open" tab.uuid "onlyaccess"
  file "set" 4 inputs[tab.id].join("\n")
  // the same file can be open in several splits
  for i split_tabs.len (
    local list @= split_tabs[i].tabs
    for j list.len (
      if list[j].type == "file" and list[j].uuid == tab.uuid (
        list[j].unsaved = false
      )
    )
  )
  remember_recent(tab.uuid)
)

def editorButtons(tab) (
  local path = open(tab.uuid, ["location", "name", "type"])
  local file_type = path[3]
  local focused = inputs.selected.id == tab.id

  tool "save" "Save (Ctrl+S)" 0.6
  if tool_click or (focused and "control".isKeyDown() and "s".onKeyDown()) (
    saveTab(tab)
  )

  if [".osl", ".js", ".bf", ".owf"].contains(file_type) (
    tool "play" "Run" 0.6
    if tool_click (
      switch file_type (
        case ".js"
          local parts = inputs[tab.id].join("\n").eval().toStr().split("\n")
          for i parts.len (
            void inputs.linked_windows.append(parts[i])
          )
          break
        case ".osl"
          window.create(tab.uuid, {
            get_obj: true
          })
          // track the window so its logs can be followed
          void state.linked_windows.append({ total_logs: 0, context: data })
          break
        default
          file "open" tab.uuid "onlyaccess"
          file "start"
          file "close"
      )
    )
  )

  tool "search" "Search in file" 0.55
  if tool_click (
    focus_or_add_tab "search" tab.id {
      type: "search",
      name: "Search",
      source_name: tab.name,
      source_uuid: tab.uuid,
      source_input: tab.id,
      source_tab_id: tab.id,
      func: searchTab.render
    }
  )

  if file_type == ".osl" or file_type == ".js" (
    tool "terminal" "Logs" 0.6
    if tool_click (
      focus_or_add_tab "logs" null {
        type: "logs",
        name: "Logs",
        func: logsTab.render
      }
    )
  )

  if [".json", ".ohf", ".ojff"].contains(file_type) (
    if inputs[tab.id].len == 1 (
      tool "line -10 10 5 10 line 0 2.5 10 2.5 line 0 -5 10 -5" "Format JSON" 0.55
      if tool_click (
        inputs[tab.id] = inputs[tab.id][1].JsonParse().JsonFormat().split("\n")
        tab.unsaved = true
      )
    ) else (
      tool "line -10 10 10 10 line -10 2.5 10 2.5 line -10 -5 5 -5" "Minify JSON" 0.55
      if tool_click (
        inputs[tab.id] = inputs[tab.id].join("\n").JsonParse().toStr().split("\n")
        tab.unsaved = true
      )
    )
  )

  if file_type == ".icn" (
    tool "eye" "Preview icon" 0.6
    if tool_click (
      add_tab {
        type: "icn_preview",
        name: "Preview: " ++ tab.name,
        source_uuid: tab.uuid,
        source_input: tab.id,
        func: icnPreview.render
      }
    )
  )

  // where the file lives, right aligned
  local room = frame.right - x_position - 30 / 8
  if room > 12 (
    goto frame.right - 14 frame.top - (TOOL_H / 2)
    rigtext path[1].toStr().trimText(room) 8 : c#muted
  )
)

// ---------------------------------------------------------------- tab strip

def "draw_tabs" (
  local removed = false
  x = frame.left + 4 - frame.scroll_h
  start = x
  local tab_y = frame.top - (TAB_H / 2)

  for i tabs.len (
    local tab @= tabs[i]
    local remove_immediately = false
    local is_file = tab.type == "file"
    local can_drag_tab = split_tabs.len > 1 or tabs.len > 1
    if is_file (
      file "open" tab.uuid "onlyaccess"
    )

    // l is the label part, the close button sits in the last 24px
    local l = tab.name.len * 9 + 26
    if is_file (
      l += 20
    )
    local tw = l + 28

    // drop marker in front of this tab
    if file_dragging or tab_dragging (
      goto x tab_y
      if dist(x_position, y_position, mouse_x, mouse_y) < 40 (
        square 0 20 2 : c#global_accent
        current_tab_target = current_tab_split ++ "," ++ i
        x += 8
      )
    )

    goto x + (tw / 2) tab_y
    hit tw - 4 27
    local over = mouse_touching
    goto x + (l / 2) tab_y
    hit l 27

    if is_file (
      if mouse_touching (
        rightclick "file" tab.uuid
      )
      if (mouse_down or mouse_touching) and !tab_dragging and tab_drag_candidate == null (
        file "interact"
        if data == "open" (
          current_tab = i
        )
        if data == "dragging" (
          // the OS now carries the file, the tab goes with it unless it is the only one
          if can_drag_tab (
            remove_immediately = true
          ) else (
            data = ""
            file_dragging = false
          )
        )
      )
    ) else (
      if mouse_touching and !tab_dragging and tab_drag_candidate == null and mouse_down and !file_dragging and can_drag_tab (
        tab_drag_candidate = {
          split: current_tab_split,
          index: i,
          start: [mouse_x, mouse_y]
        }
      )
      if tab_drag_candidate != null and tab_drag_candidate.split == current_tab_split and tab_drag_candidate.index == i and mouse_down and !file_dragging and can_drag_tab (
        if dist(tab_drag_candidate.start[1], tab_drag_candidate.start[2], mouse_x, mouse_y) > 10 (
          tab_dragging = true
          tab_drag_tab @= tab
          tab_drag_from_split = current_tab_split
          tab_drag_from_index = i
          tab_drag_candidate = null
          void tabs.delete(i)
          if current_tab > i (
            current_tab -= 1
          )
          current_tab = current_tab.clamp(1, max(1, tabs.len))
          i --
          continue
        )
      )
      if onclick (
        current_tab = i
      )
    )

    if remove_immediately (
      tabs @= tabs.delete(i)
      i --
      continue
    )

    goto x + (tw / 2) tab_y
    if i == current_tab (
      box tw - 2 29 14 : c#edge_col
      box tw - 4 27 12 : c#c_prim
    ) else if over (
      box tw - 4 27 12 : c#hover_col
    )
    goto x + 16 tab_y
    if is_file (
      change_x 4
      file "render" 0.7
      change_x 16
    )
    c i == current_tab ? c_text muted
    text tab.name 9

    // close button, an unsaved tab shows a dot until it is hovered
    goto x + tw - 18 tab_y
    hit 20 20
    local over_close = mouse_touching
    if over_close (
      cursor "pointer"
      box 20 20 10 : c#track_col
    )
    if tab.unsaved == true and !over_close (
      icon "w 9 dot 0 0" 0.5 : c#c_text
    ) else if over or over_close or i == current_tab (
      icon "close" 0.4 : c#c_text
    )
    if onclick and !tab_close_lock (
      tab_close_lock = true
      removed = true
      if tab.unsaved == true (
        removed = ("Close " ++ tab.name ++ " without saving?").confirm()
      )
    )
    if removed (
      if status_tab != null and status_tab.id == tab.id (
        status_tab = null
        status_cursor = null
      )
      tabs @= tabs.delete(i)
      if current_tab > i (
        current_tab -= 1
      )
      i --
      removed = false
      continue
    )
    x += tw
  )

  // drop marker after the last tab
  if file_dragging or tab_dragging (
    goto x + 6 tab_y
    if dist(x_position, y_position, mouse_x, mouse_y) < 40 (
      square 0 20 2 : c#global_accent
      current_tab_target = current_tab_split ++ "," ++ (tabs.len + 1)
    )
  )
  goto x + 18 tab_y
  hit 28 28
  if mouse_touching (
    cursor "pointer"
    box 28 28 10 : c#hover_col tooltip#"New tab"
  )
  icon "add" 0.55 : c#c_text
  if onclick (
    add_tab welcome_tab()
  )
  goto x + 36 tab_y
  tab_width = x_position - start
)

// ---------------------------------------------------------------- explorer

def drawFilesList(uuids, depth) (
  for i uuids.len (
    if y_position < frame.bottom - 30 (
      break
    )
    local uuid = uuids[i]
    file "open" uuid "onlyaccess"
    local type = fileGet(1)
    local is_folder = type == ".folder"
    local row_y = y_position
    local x = frame.left + 14 + (depth * 16)

    goto 0 row_y
    hit frame.width - 12 26
    local over = mouse_touching
    rightclick "file" uuid
    if over (
      cursor "pointer"
      box frame.width - 12 26 10 : c#hover_col
    )
    if is_folder (
      local folder_open = state.open_folders.contains(uuid)
      if onclick (
        if folder_open (
          void state.open_folders.delete(uuid)
        ) else (
          void state.open_folders.append(uuid)
        )
      )
      goto x row_y
      icon folder_open ? "down" "right" 0.4 : c#muted
    ) else (
      data = ""
      if over and !tab_dragging and tab_drag_candidate == null (
        file "interact"
      )
      if data == "open" (
        open_file_tab uuid
      )
    )
    file "open" uuid "onlyaccess"
    goto x + 20 row_y
    file "render" 0.75
    local label = fileGet(2) ++ (is_folder ? "" type)
    text label.trimText(frame.right - x - 56 / 9) 9 : c#c_text chx#18

    goto 0 row_y - 28
    if is_folder and state.open_folders.contains(uuid) (
      file "open" uuid "onlyaccess"
      local children @= fileGet(4)
      state.folder_list_len += children.len * 28
      drawFilesList(children, depth + 1)
    )
  )
)

def "draw_explorer" (
  goto 0 0
  square frame.width frame.height 0 : c#window_colour
  goto frame.left 0
  square 0 frame.height 1 : c#edge_col

  // header: title, run button for opal projects, close folder
  local head_y = frame.top - (TOOL_H / 2)
  goto frame.left + 16 head_y
  local title = "EXPLORER"
  if state.folder != null (
    title = open(state.folder, ["name"])[1].toStr().toUpper()
  )
  text title.trimText(frame.width - 90 / 7.5) 7.5 : c#muted
  goto frame.right - 20 head_y
  if state.folder != null (
    tool "close" "Close folder" 0.4
    if tool_click (
      state.folder = null
      state.is_opal = false
    )
    if state.is_opal (
      goto frame.right - 52 head_y
      tool "play" "Run project" 0.55
      if tool_click (
        run_opal_project()
      )
    )
  )
  goto 0 frame.top - TOOL_H
  square frame.width 0 1 : c#edge_col
)

def run_opal_project() (
  local root_dir = open(state.folder, ["location", "name"]).join("/")
  local path = root_dir ++ "/opal.json"
  if !path.fileExists() (
    say "opal.json not found"
    return
  )
  local script = open(path).JsonParse().main
  if script == null (
    say "opal.json has no main script"
    return
  )
  local open_path = root_dir ++ "/" ++ script
  if !open_path.fileExists() (
    say "Script not found"
    return
  )
  file "open" open_path "onlyaccess"
  if fileGet(1) == ".osl" (
    file "start"
  )
  file "close"
)

// ---------------------------------------------------------------- startup

if "recent_files.json".saveExists() (
  recent = "recent_files.json".saveGet().trim(1, 10)
) else (
  recent = []
  save "recent_files.json" "set" recent
)
if "recent_folders.json".saveExists() (
  recent_folders = "recent_folders.json".saveGet().trim(1, 8)
) else (
  recent_folders = []
  save "recent_folders.json" "set" recent_folders
)

tabs = []
current_tab = 1
if passed_data == "" (
  void tabs.append(welcome_tab())
) else (
  local file = open(passed_data, ["name", "type", "data"])
  if file[2] == "" or typeof(file[3]) != "string" (
    void tabs.append(welcome_tab())
  ) else (
    void tabs.append(file_tab(passed_data))
  )
)
split_tabs = [{tabs, cur: 1}]

window.show()

mainloop:
window "responsive" false
refresh_palette
tab_close_lock = false
w @= window

if !mouse_down and !tab_dragging (
  tab_drag_candidate = null
)

// the whole window is one flat surface, panels are divided by hairlines
goto 0 0
square window.width + 10 window.height + 10 0 : c#window_colour

updateLinkedWindowLogs()

// a file picked from the welcome page
if new_transmit (
  if pickers.contains(transmit_source) and transmit_data != "closed" (
    tabs @= split_tabs[1].tabs
    open_file_tab transmit_data
    split_tabs[1].cur = current_tab
  )
  new_transmit = false
)

// a file dropped on a tab strip, a split or the explorer
if file_dropped != 0 (
  local name @= open(file_dropped, ["name", "type", "data"])
  if name[2] == ".shortcut" (
    file_dropped = open(name[3], ["uuid"])[1]
    name @= open(file_dropped, ["name", "type", "data"])
  )
  if name[2] == ".folder" (
    if current_tab_target == "folder_sidebar" (
      open_folder(file_dropped)
    )
  ) else (
    local spl = current_tab_target.toStr().split(",")
    local cur @= split_tabs[spl[1].toNum().clamp(1, split_tabs.len)]
    if current_split_target != 0 (
      split_tabs.insert(current_split_target, {tabs: [], cur: 1})
      cur @= split_tabs[current_split_target]
    )
    tabs @= cur.tabs
    local at = spl[2].toNum()
    if at == 0 (
      at = tabs.len + 1
    )
    insert_tab at.clamp(1, tabs.len + 1) file_tab(file_dropped)
    cur.cur = current_tab
    cur.tabs @= tabs
  )
  current_tab_target = 0
  file_dropped = 0
)

// explorer slides in from the right
right_target = 0
if state.folder_sidebar (
  right_target -= state.folder_sidebar_width
)
right_smooth += right_target - right_smooth / 4
if abs(right_target - right_smooth) < 0.5 (
  right_smooth = right_target
)
right = w.right + right_smooth
local explorer_shown = right_smooth < -1

if state.folder_resizing and !mouse_down (
  state.folder_resizing = false
)
if explorer_shown and !file_dragging and !tab_dragging (
  if mouse_y > w.bottom + STATUS_H and mouse_y < w.top - TAB_H and abs(mouse_x - right) < 6 (
    cursor "ew-resize"
    if mouse_ondown (
      state.folder_resizing = true
      state.folder_resize_start_x = mouse_x
      state.folder_resize_start_w = state.folder_sidebar_width
    )
  )
)
if state.folder_resizing (
  state.folder_sidebar_width = (state.folder_resize_start_w + (state.folder_resize_start_x - mouse_x)).clamp(200, w.width - 300)
  right_smooth = 0 - state.folder_sidebar_width
  right = w.right + right_smooth
)

if file_dragging or tab_dragging (
  current_tab_target = 0
)

// ---- tab strips, the space after the last tab drags the window
window.dragbox = [[1, 1, 0, 0], [1, 1, 0, 0]]
local strip_right = min(right, w.right - 126)
frame w.left w.top strip_right w.top - TAB_H (
  ensureSplitSizes()
  local sections = split_tabs.len
  local total_w = frame.width
  local sx = 0
  for i sections (
    local cur @= split_tabs[i]
    tabs @= cur.tabs
    current_tab_split = i
    current_tab = cur.cur
    local fw = total_w * state.split_sizes[i]
    frame frame.left + sx frame.top frame.left + fw + sx frame.bottom [cur.tab_width.toNum() + 60, 0] "split_" ++ i (
      draw_tabs
      if mouse_x > frame.left and mouse_x < frame.right (
        number drag_left = frame.x - window.x + x_position
        number drag_right = min(frame.x - window.x + frame.right, window.right - 126)
        if drag_left < drag_right (
          window.dragbox = [
            [9999, 2, drag_left, 0],
            [9999, 2, drag_right, 0 - TAB_H]
          ]
        )
      )
    )
    cur.tab_width = tab_width
    cur.cur = current_tab.clamp(1, max(1, tabs.len))
    cur.tabs @= tabs
    split_tabs[i] @= cur
    sx += fw
  )
)
// the gap between the last strip and the window buttons drags too
if mouse_x > strip_right (
  window.dragbox = [[9999, 2, strip_right, 0], [9999, 2, w.right - 126, 0 - TAB_H]]
)

// explorer toggle sits beside the window buttons
goto w.right - 106 w.top - (TAB_H / 2)
hit 27 27
if mouse_touching (
  cursor "pointer"
  box 27 27 10 : c#hover_col tooltip#"Toggle explorer"
)
if onclick (
  state.folder_sidebar = !state.folder_sidebar
)
c state.folder_sidebar ? global_accent c_text
icon "w 3 square 0 0 10 10 w 8 line 5 6 5 -6" 0.55
goto 0 w.top - TAB_H
square w.width 0 1 : c#edge_col

// drop splits that lost their last tab
local cleanup_i = split_tabs.len
loop cleanup_i (
  local s @= split_tabs[cleanup_i]
  if s == null or s.tabs == null or s.tabs.len == 0 (
    split_tabs.delete(cleanup_i)
  )
  cleanup_i --
)
if split_tabs.len == 0 (
  window.close()
)

// which split would a dragged file or tab land in
current_split_target = 0
if file_dragging or tab_dragging (
  frame w.left w.top - TAB_H right w.bottom + STATUS_H (
    local sections = split_tabs.len + 1
    local fw = frame.width / sections
    for i sections (
      local zone_l = frame.left + (i - 1 * fw)
      if mouse_x > zone_l and mouse_x < zone_l + fw and mouse_y > frame.bottom and mouse_y < frame.top (
        current_split_target = i
        state.draw_highlight = [i - 1 * fw, fw]
      )
    )
  )
)

if tab_dragging (
  file_dropped = 0
)

// a dragged tab lands in a strip, in a new split, or back where it came from
if tab_dragging and !mouse_down (
  local placed = false
  if typeof(current_tab_target) == "string" and current_tab_target.contains(",") (
    local spl = current_tab_target.split(",")
    local dest_split = spl[1].toNum()
    if dest_split >= 1 and dest_split <= split_tabs.len (
      local dest @= split_tabs[dest_split]
      local dest_index = spl[2].toNum().clamp(1, dest.tabs.len + 1)
      dest.tabs.insert(dest_index, tab_drag_tab)
      dest.cur = dest_index
      split_tabs[dest_split] @= dest
      placed = true
    )
  )
  if !placed and current_split_target != 0 (
    split_tabs.insert(current_split_target, {tabs: [tab_drag_tab], cur: 1})
    placed = true
  )
  if !placed and tab_drag_from_split != 0 (
    local src @= split_tabs[tab_drag_from_split.clamp(1, split_tabs.len)]
    local idx = tab_drag_from_index.clamp(1, src.tabs.len + 1)
    src.tabs.insert(idx, tab_drag_tab)
    src.cur = idx
  )
  tab_dragging = false
  tab_drag_tab = null
  tab_drag_from_split = 0
  tab_drag_from_index = 0
  tab_drag_candidate = null
  current_tab_target = 0
  current_split_target = 0
  state.draw_highlight = [0, 0]
)

// ---- splits
frame w.left w.top - TAB_H right w.bottom + STATUS_H (
  ensureSplitSizes()
  local sections = split_tabs.len
  local total_w = frame.width

  if state.split_resizing != 0 and !mouse_down (
    state.split_resizing = 0
  )
  // grab the boundary between two splits to resize them
  local running = 0
  for i (sections - 1) (
    running += total_w * state.split_sizes[i]
    local split_x = frame.left + running
    if !file_dragging and !tab_dragging and state.split_resizing == 0 (
      if mouse_y > frame.bottom and mouse_y < frame.top and abs(mouse_x - split_x) < 6 (
        cursor "ew-resize"
        if mouse_ondown (
          state.split_resizing = i
          state.split_resize_start_x = mouse_x
          state.split_resize_start_left = state.split_sizes[i]
          state.split_resize_start_right = state.split_sizes[i + 1]
        )
      )
    )
  )
  if state.split_resizing != 0 (
    local idx = state.split_resizing
    local pair_sum = state.split_resize_start_left.toNum() + state.split_resize_start_right.toNum()
    local delta = (mouse_x - state.split_resize_start_x).toNum() / total_w
    local left_size = (state.split_resize_start_left.toNum() + delta).clamp(0.08, pair_sum - 0.08)
    state.split_sizes[idx] = left_size
    state.split_sizes[idx + 1] = pair_sum - left_size
  )

  local sx = 0
  for i sections (
    local fw = total_w * state.split_sizes[i]
    frame frame.left + sx frame.top frame.left + fw + sx frame.bottom 0 (
      local cur @= split_tabs[i]
      tabs @= cur.tabs
      current_tab = cur.cur
      func @= tabs[current_tab].func
      if typeof(func) == "function" (
        func()
      )
      cur.cur = current_tab
      cur.tabs @= tabs
    )
    sx += fw
    if i < sections (
      goto frame.left + sx 0
      square 0 frame.height 1 : c#edge_col
    )
  )

  if current_split_target != 0 (
    goto frame.left + state.draw_highlight[1] + (state.draw_highlight[2] / 2) 0
    effect "transparency" 80
    square state.draw_highlight[2] - 12 frame.height - 12 12 : c#global_accent
    effect "clear"
  )
)

// ---- explorer
if explorer_shown (
  frame right w.top - TAB_H w.right w.bottom + STATUS_H (
    draw_explorer
  )
  frame right w.top - TAB_H - TOOL_H w.right w.bottom + STATUS_H state.folder_list_len "cache@folders" (
    local drop_here = file_dragging and mouse_x > frame.left and mouse_x < frame.right and mouse_y > frame.bottom and mouse_y < frame.top
    if drop_here (
      current_tab_target = "folder_sidebar"
      goto 0 0
      effect "transparency" 80
      square frame.width - 16 frame.height - 16 12 : c#global_accent
      effect "clear"
      empty_state "folder" "Drop a folder to open it"
    ) else if state.folder != null (
      local children = open(state.folder)
      state.folder_list_len = children.len * 28 + 12
      // opening a file from here adds it to the last split
      local cur @= split_tabs[split_tabs.len]
      tabs @= cur.tabs
      current_tab = cur.cur
      goto 0 frame.top - 18 + frame.scroll
      drawFilesList(children, 0)
      cur.tabs @= tabs
      cur.cur = current_tab
    ) else (
      goto frame.left + 16 frame.top - 20
      text "No folder open" 9 : c#c_text
      goto frame.left + 16 frame.top - 42
      text "Drag a folder here to browse it".wrapText(frame.width - 32 / 8.5) 8.5 : c#muted
      local shown = 0
      for i recent_folders.len (
        local uuid @= recent_folders[i]
        file "uuid_exists" uuid
        if !exists (
          continue
        )
        if shown == 0 (
          goto frame.left + 16 frame.top - 96
          text "RECENT FOLDERS" 7.5 : c#muted
        )
        shown ++
        goto 0 frame.top - 98 - (shown * 28)
        hit frame.width - 12 26
        if mouse_touching (
          cursor "pointer"
          box frame.width - 12 26 10 : c#hover_col
        )
        if onclick (
          open_folder(uuid)
        )
        file "open" uuid "onlyaccess"
        goto frame.left + 26 y_position
        file "render" 0.75
        text fileGet(2).toStr().trimText(frame.width - 70 / 9) 9 : c#c_text chx#20
      )
    )
  )
)

// ---- status bar
local status_y = w.bottom + (STATUS_H / 2)
goto 0 w.bottom + STATUS_H
square w.width 0 1 : c#edge_col
local status_left = "Ready"
local status_right = ""
if status_tab != null and status_tab.type == "file" (
  local kind = file_types["." ++ status_tab.name.split(".").last()]
  status_right = (kind == null or kind[2] == "") ? "Plain Text" kind[2]
  status_left = status_tab.unsaved == true ? "Unsaved changes" "Saved"
  if status_cursor != null (
    status_left ++= "    Ln " ++ status_cursor.line ++ ", Col " ++ (status_cursor.char + 1)
  )
  local problems = (status_tab.errors ?? []).len
  if problems > 0 (
    status_left ++= "    " ++ problems ++ (problems == 1 ? " problem" " problems")
  )
  status_right ++= "    " ++ status_tab.data.len ++ " lines"
)
goto w.left + 14 status_y
text status_left 8 : c#muted
goto w.right - 14 status_y
rigtext status_right 8 : c#muted

// the tab being dragged follows the pointer
if tab_dragging and tab_drag_tab != null (
  frame w.left w.top w.right w.bottom (
    local name = (tab_drag_tab.name ?? "").toStr()
    goto mouse_x mouse_y
    box name.len * 9 + 30 30 12 : c#edge_col
    box name.len * 9 + 28 28 12 : c#c_prim
    centext name 9 : c#c_text
  )
)

import "win-buttons"
