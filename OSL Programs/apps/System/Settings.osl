def install_font(string title, string source) (
  local slug = title.toLower().replace("/[^a-z0-9]+/g", "_")
  file "open" "origin/(a) system/fonts/origin.ojff" "onlyaccess"
  local base @= fileGet(4).toStr().JsonParse()
  file "close"
  if typeof(base) != "object" or typeof(base.origin) != "object" (
    font_status = "Could not read the system font to build on"
    return null
  )
  base.origin.ttf = source
  base.origin.layout = "cell"
  base.origin.name = title
  file "download" slug ++ ".ojff" null base.JsonStringify() user_folder ++ "/Fonts"
  terminal "font use " ++ slug
  font_current = slug
  if !custom_fonts.contains(slug) (
    void custom_fonts.append(slug)
  )
  font_status = "Installed " ++ title
)

def install_google_font(string family) (
  if family == "" (
    return null
  )
  font_status = "Looking up " ++ family
  google_family = family
  void requests.getAsync("https://fonts.googleapis.com/css2?family=" ++ family.replace(" ", "+"))
    .then(resp -> (
      local found @= resp.body.toStr().match("/url[(]([^)]+)[)]/g")
      if resp.success != true or typeof(found) != "array" or found.len == 0 (
        font_status = "Google Fonts has no family called " ++ google_family
        return
      )
      local address = found.last().replace("url(", "").replace(")", "")
      install_font(google_family, address)
    ))
)

def install_font_file(string uuid) (
  file "open" uuid "onlyaccess"
  local kind = fileGet(1).toStr().toLower()
  local title = fileGet(2).toStr()
  local data = fileGet(4).toStr()
  file "close"
  if ![".ttf", ".otf", ".woff", ".woff2"].contains(kind) (
    font_status = "Pick a .ttf, .otf, .woff or .woff2 file"
    return null
  )
  if !data.startsWith("data:") (
    font_status = "That file is not stored as binary data, upload it to Files again"
    return null
  )
  install_font(title, data)
)
keybind_edit = ""
perm_app = ""
picker_id = ""
API = "https://api.rotur.dev"
LITE_KEY = "4f229157f0c40f5a98cbf28efd39cfe8"
PLAN_PRICES = {Plus: {Monthly: "£1.75", Yearly: "£14"}, Pro: {Monthly: "£5.75", Yearly: "£46"}}
billing = null
my_keys = null
interval = "Monthly"
contributors = null
supporters = null
extensions = null
slider_active = false
button_click = false
page_len = 0
sidebar_len = 0
row_n = 0
page_scroll = 0
wall = null
wall_time = 0
action_danger = false

window "dimensions" 920 640
window "set_dragbox" [[2, 2, SIDEBAR + 80, 0], [-2, 2, -92, -42]]

mainloop:
window.setGlass(100, "15px")
goto SIDEBAR / 2 0
square window.width - SIDEBAR - 10 window.height + 10 10 : c#window_colour
goto window.left + SIDEBAR + 12 0
square 20 window.height 4
c window_colour
pen "opacity" 55
icon "w 99999 dot 0 0" 10
pen "opacity" 0
frame "clear"

frame window.left window.top window.left + SIDEBAR window.bottom sidebar_len "cache@sidebar" (
  local sw = frame.width - 12
  local sy = frame.top - 20 + frame.scroll
  local top = sy

  goto 0 sy
  square sw - 12 15 12 : c#prim
  goto sw / -2 + 16 sy
  icon "search" 0.5 : c#muted
  goto 12 sy
  c prim
  input sw - 44 21 "search" "Search" 9 txtc
  sy -= 42

  local query = inputs.search.toStr().toLower().strip()
  if query == "" (
    goto 0 sy
    if category == "Account" (
      square sw - 12 32 12 : c#global_accent
    ) else (
      square sw - 12 32 12 0 1
      if mouse_touching (
        cursor "pointer"
        square sw - 12 32 12 : c#hover_col
      )
      if onclick (
        nav_cat = "Account"
      )
    )
    goto sw / -2 + 28 sy
    image pfp 34 34
    goto sw / -2 + 54 sy + 8
    if category == "Account" (
      text user.username.trimText(sw - 70 / 9.5) 9.5 : c#accent_txt
      goto sw / -2 + 54 sy - 9
      text "Rotur Account" 7.5
    ) else (
      text user.username.trimText(sw - 70 / 9.5) 9.5 : c#txtc
      goto sw / -2 + 54 sy - 9
      text "Rotur Account" 7.5 : c#muted
    )
    sy -= 36
  )

  local drawn = 0
  local gapped = false
  for i pages.len (
    local page @= pages[i]
    local available = page.link != true or roturlink.enabled
    local shown = available
    local target_sub = "none"
    if query != "" (
      shown = available and page.name.toLower().contains(query)
      for j search_index.len (
        if available and search_index[j][2] == page.name and search_index[j][1].contains(query) (
          shown = true
          target_sub = search_index[j][3]
        )
      )
    )
    if page.gap == true (
      gapped = true
    )
    if shown (
      if gapped and query == "" (
        sy -= 14
      )
      gapped = false
      drawn ++
      goto 0 sy
      local selected = category == page.name and query == ""
      if selected (
        square sw - 12 18 12 : c#global_accent
      ) else (
        square sw - 12 18 12 0 1
        if mouse_touching (
          cursor "pointer"
          square sw - 12 18 12 : c#hover_col
        )
        if onclick (
          nav_cat = page.name
          nav_sub = target_sub
          inputs.search = ""
        )
      )
      goto sw / -2 + 22 sy
      c page.col
      square 9 9 12
      icon page.icn 0.5 : c#fff
      if selected (
        text page.name 9 : c#accent_txt chx#20
      ) else (
        text page.name 9 : c#txtc chx#20
      )
      sy -= 30
    )
  )
  if drawn == 0 (
    goto 0 sy - 10
    centext "No results" 8.5 : c#muted
    sy -= 40
  )
  sidebar_len = top - sy + 24
)

goto window.left + SIDEBAR 0
square 0 window.height 1 : c#edge_col

local page_cw = min(window.width - SIDEBAR - 48, 640)
goto window.left + SIDEBAR + window.right / 2 - (page_cw / 2) + LABEL_X window.top - 21
if subcategory != "none" (
  change_x 6
  square 14 14 10 0 1
  local back = onclick
  if mouse_touching (
    cursor "pointer"
    square 14 14 10 : c#hover_col
  )
  if back (
    nav_sub = "back"
  )
  icon "left" 0.6 : c#global_accent
  change_x 22
)
local title = subcategory
if subcategory == "none" (
  title = category
)
text title 14 : c#txtc

frame window.left + SIDEBAR + 1 window.top - 48 window.right window.bottom page_len "cache@page_" ++ category ++ subcategory (
  ui_begin
  switch category (
    case "Account"
      page_account
      break
    case "Wi-Fi"
      page_wifi
      break
    case "Bluetooth"
      page_bluetooth
      break
    case "Network"
      page_network
      break
    case "General"
      page_general
      break
    case "Appearance"
      page_appearance
      break
    case "Wallpaper"
      page_wallpaper
      break
    case "Dock"
      page_dock
      break
    case "Display"
      page_display
      break
    case "Sound"
      page_sound
      break
    case "Mouse"
      page_mouse
      break
    case "Keyboard"
      page_keyboard
      break
    case "Game Controllers"
      page_controllers
      break
    case "Privacy & Security"
      page_privacy
      break
    case "Membership"
      page_membership
      break
    case "Credits"
      page_credits
      break
  )
  ui_end
)

if page_scroll > 2 (
  goto window.left + SIDEBAR + window.right / 2 window.top - 48
  square window.width - SIDEBAR 0 1 : c#edge_col
)

if !mouse_down (
  if nav_cat != "" (
    category = nav_cat
    subcategory = "none"
    if nav_sub != "" (
      subcategory = nav_sub
    )
    nav_cat = ""
    nav_sub = ""
    perm_app = ""
  )
  if nav_sub == "back" (
    subcategory = "none"
    nav_sub = ""
  )
  if nav_sub != "" (
    subcategory = nav_sub
    nav_sub = ""
  )
)
window.show()
import "win-buttons"
