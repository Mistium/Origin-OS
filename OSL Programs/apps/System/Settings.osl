// Developer: @Mistium
// Description: System settings for originOS

import "window_tools"
load_theme

permission "request" "save admin"
permission "request" "javascript"
permission "request" "terminal"
permission "request" "file admin"
permission "request" "account"
permission "request" "kernel"
permission "request" "display"
permission "request" "rotur token"


ROW = 42
LABEL_X = 16
GAP = 22
SIDEBAR = 240

def "ui_begin" (
  cw = min(frame.width - 48, 640)
  cy = frame.top - 8 + frame.scroll
  page_top = cy
  page_scroll = frame.scroll
)

def "ui_end" (
  page_len = page_top - cy + 28
)

def "ui_gap" "n" (
  cy -= n
)

def "ui_header" "txt" (
  goto cw / -2 + LABEL_X cy - 10
  text txt.toStr().toUpper() 7.5 : c#muted
  cy -= 26
)

def "ui_note" "txt" (
  local wrapped = txt.wrapText(cw - 32 / 8)
  goto cw / -2 + LABEL_X cy - 16
  text wrapped 8 : c#muted
  cy -= wrapped.split("\n").len * 17 + 26
)

def "ui_card" "x, y, w, h" (
  goto x y
  square w - 13 h - 13 15 : c#edge_col
  square w - 15 h - 15 14 : c#prim
)

def "ui_group" "rows, h" (
  row_h = h
  row_i = 0
  row_n = rows
  if rows > 0 (
    ui_card 0 cy - (rows * h / 2) cw rows * h
  )
)

def "ui_row" "clickable, indent" (
  row_i ++
  ry = cy - (row_h / 2)
  goto 0 ry
  square cw - 16 row_h - 16 14 0 1
  row_hover = mouse_touching
  row_click = onclick
  if clickable and row_hover (
    cursor "pointer"
    square cw - 16 row_h - 16 14 : c#hover_col
    if row_i > 1 (
      goto 0 ry + (row_h / 4)
      square cw - 4 row_h / 2 - 2 2
    )
    if row_i < row_n (
      goto 0 ry - (row_h / 4)
      square cw - 4 row_h / 2 - 2 2
    )
  ) else if row_i > 1 (
    local line_x = cw / -2 + LABEL_X + indent
    goto line_x + (cw / 2) / 2 cy
    square cw / 2 - line_x - 2 0 1 : c#edge_col
  )
  cy -= row_h
)

def "ui_label" "txt, icn, col" (
  goto cw / -2 + LABEL_X ry
  if icn != "" (
    change_x 11
    c col
    square 10 10 12
    icon icn 0.55 : c#fff
    change_x 23
  )
  text txt 9 : c#txtc
)

def "ui_value" "value, reserved" (
  goto cw / 2 - LABEL_X ry
  rigtext value.toStr().trimText(cw - 60 / 9 - reserved - 2) 9 : c#muted
)

def "ui_button" "icn, offset" (
  goto cw / 2 - offset ry
  square 14 14 10 0 1
  button_click = onclick
  if mouse_touching (
    square 14 14 10 : c#track_col
    cursor "pointer"
  )
  icon icn 0.6 : c#txtc
)

def "row_nav" "txt, icn, col, target" (
  local indent = 0
  if icn != "" (
    indent = 34
  )
  ui_row true indent
  if row_click (
    nav_sub = target
  )
  ui_label txt icn col
  goto cw / 2 - 22 ry
  icon "right" 0.5 : c#muted
)

def "row_info" "txt, value" (
  ui_row false 0
  ui_label txt "" ""
  ui_value value txt.len
)

def "ui_switch" "state" (
  goto cw / 2 - 36 ry
  local knob_x = x_position - 9
  if state (
    knob_x += 18
    square 18 0 22 : c#global_accent
  ) else (
    square 18 0 22 : c#track_col
  )
  goto knob_x ry
  effect "transparency" 75
  square 0 0 19 : c#000
  effect "clear"
  square 0 0 17 : c#fff
)

def "row_toggle" "txt, state, callback" (
  ui_row true 0
  ui_label txt "" ""
  ui_switch state
  if row_click (
    void callback()
  )
)

def "row_action" "txt, icn, callback, arg" (
  local indent = 0
  if icn != "" (
    indent = 34
  )
  ui_row true indent
  local col = global_accent
  if action_danger (
    col = "#f87171"
  )
  action_danger = false
  goto cw / -2 + LABEL_X ry
  if icn != "" (
    change_x 11
    icon icn 0.6 : c#col
    change_x 23
  )
  text txt 9 : c#col
  if row_click (
    void callback(arg)
  )
)

def "ui_keycap" "key" (
  goto cw / -2 + LABEL_X + 6 + (key.len * 4.5) ry
  square key.len * 9 6 12 : c#track_col
  goto cw / -2 + LABEL_X + 6 ry
  text key 9 : c#txtc
)

def "ui_file_icon" "path" (
  goto cw / -2 + LABEL_X + 12 ry
  square 12 12 12 : c#hover_col
  file "open" path "onlyaccess"
  file "render" 0.9
)

def "row_choice" "txt, options, current, callback" (
  ui_row false 0
  ui_label txt "" ""
  local longest = 0
  for i options.len (
    longest = max(longest, options[i].toStr().len)
  )
  local sw = longest * 8 + 22
  local total = options.len * sw
  local right = cw / 2 - LABEL_X
  goto right - (total / 2) ry
  square total - 12 12 12 : c#track_col
  for i options.len (
    goto right - total + (i - 0.5 * sw) ry
    square sw - 14 8 10 0 1
    local hit = onclick
    if mouse_touching (
      cursor "pointer"
    )
    if options[i] == current (
      square sw - 14 8 10 : c#global_accent
      centext options[i] 8 : c#accent_txt
    ) else (
      centext options[i] 8 : c#txtc
    )
    if hit and options[i] != current (
      void callback(options[i])
    )
  )
)

def "row_slider" "txt, id" (
  ui_row false 0
  ui_label txt "" ""
  slider_active = row_hover and mouse_down
  goto cw / 2 - LABEL_X - 94 ry
  slider 180 0 id 8 : c#track_col
  local vars @= Variables()
  goto cw / 2 - LABEL_X - 184 + (vars["slider_" ++ id] * 180) ry
  effect "transparency" 75
  square 0 0 17 : c#000
  effect "clear"
  square 0 0 15 : c#fff
)

def "row_input" "txt, id, w, placeholder, callback" (
  ui_row false 0
  ui_label txt "" ""
  goto cw / 2 - LABEL_X - (w / 2) ry
  square w - 12 14 12 : c#hover_col
  c hover_col
  input w - 16 24 id placeholder 9 txtc
  if "enter".onKeyDown() and inputs[id].toStr() != "" (
    void callback(inputs[id])
  )
)

def "row_colour" "txt, id" (
  ui_row true 0
  ui_label txt "" ""
  goto cw / 2 - LABEL_X - 11 ry
  square 0 0 22 : c#track_col
  c theme_select[id]
  square 0 0 19
  change_x -22
  rigtext theme_select[id] 8 : c#muted
  if row_click (
    colourpicker "setcol" theme_select[id]
    colourpicker "show"
    selected_col = id
  )
)

def "row_path" "path" (
  ui_row false 38
  ui_file_icon path
  text path.toStr().split("/").last().trimText(cw - 140 / 9) 9 : c#txtc chx#26
  ui_button "bin" 28
)

def "ui_empty" "txt" (
  ui_group 1 64
  goto 0 cy - 32
  centext txt 9 : c#muted
  cy -= 64
)

def "ui_spinner" "label" (
  goto 0 cy - 60
  direction timer * 360
  icon "w 2 cutcircle 0 0 10 0 90" 1 : c#txtc
  direction 90
  change_y -30
  centext label 9 : c#muted
  cy -= 120
)

def update_theme_flag(string key) (
  local theme = user.theme
  theme[key] = theme[key] == false
  network "update" "theme" theme
)

def hasTierOrHigher(string tier) boolean (
  array tiers = ["free", "lite", "plus", "drive", "pro", "max"]
  string mine = (user["sys.subscription"].tier ?? "free").toLower()
  return tiers.index(mine) >= tiers.index(tier.toLower())
)

def parseUserAgent(string ua) string (
  string browser = "Unknown Browser"
  string os = "Unknown OS"
  each name ["Opera", "Edg", "Firefox", "Chrome", "Safari"] (
    if ua.contains(name) and browser == "Unknown Browser" (
      browser = name == "Edg" ? "Edge" name
    )
  )
  each name ["Android", "iPhone", "Windows", "Mac", "Linux"] (
    if ua.contains(name) and os == "Unknown OS" (
      os = name == "Mac" ? "macOS" name
    )
  )
  return browser ++ " on " ++ os
)


def billingDate(number value) string (
  if value < 10000000000 (
    value *= 1000
  )
  return value.timestamp("to-date")
)

def displayTier() string (
  local sub = billing.subscription ?? user["sys.subscription"] ?? {}
  if sub.active != true (
    return "Free"
  )
  local tier = sub.tier.toStr()
  if ["Pro", "Drive", "Max"].contains(tier) (
    return "Pro"
  )
  if ["Lite", "Plus"].contains(tier) (
    return tier
  )
  return "Free"
)

def keyUserData(key) (
  if typeof(key) != "object" or typeof(key.users) != "object" (
    return null
  )
  local names = key.users.getKeys()
  for i names.len (
    if names[i].toLower() == username.toLower() (
      return key.users[names[i]]
    )
  )
  return null
)

def renewLabel(data) string (
  if typeof(data) != "object" (
    return "Active"
  )
  if data.cancel_at != null (
    return "Ends " ++ billingDate(data.cancel_at)
  )
  if data.next_billing != null (
    return "Renews " ++ billingDate(data.next_billing)
  )
  return "Active"
)

def "load_billing" (
  if roturToken() == "" (
    return
  )
  if billing == null (
    local status = (API ++ "/v2/me/billing?auth=" ++ roturToken()).getAsync()
    if status != "Loading" (
      billing = typeof(status) == "object" ? status {}
    )
  )
  if my_keys == null (
    local keys = (API ++ "/keys/mine?auth=" ++ roturToken()).getAsync()
    if keys != "Loading" (
      my_keys = typeof(keys) == "array" ? keys []
    )
  )
)

def openBilling(string path, body) (
  local resp = requests.post(API ++ "/v2/me/billing/" ++ path ++ "?auth=" ++ roturToken(), {body: body})
  if resp.success and typeof(resp.body) == "object" and resp.body.url != null (
    http "newtab" resp.body.url
  ) else if typeof(resp.body) == "object" (
    say resp.body.error ?? "Could not open billing"
  ) else (
    say "Could not open billing"
  )
)

def changeKey(string action, string key, string name) (
  local msg = "Cancel '" ++ name ++ "'? Future billing will stop and you keep access until the end of the current period."
  if action == "buy" (
    msg = "Subscribe to '" ++ name ++ "'? Credits are charged now and every billing period. You can cancel here."
  )
  if !msg.confirm() (
    return null
  )
  local resp = requests.get(API ++ "/keys/" ++ action ++ "/" ++ key ++ "?auth=" ++ roturToken())
  if resp.success (
    my_keys = null
    if action == "cancel" (
      say "Cancellation scheduled. Your access remains active until the date shown."
    )
  ) else if typeof(resp.body) == "object" (
    say resp.body.error ?? "Could not " ++ action
  ) else (
    say "Could not " ++ action
  )
)

def "row_benefit" "txt" (
  ui_row false 34
  ui_label txt.trimText(cw - 80 / 9) "tick" "#10b981"
)


def "page_account" (
  local tier = user["sys.subscription"].tier ?? "Free"
  switch subcategory (
    case "none"
      local bh = cw / 3.4
      ui_card 0 cy - (bh / 2) cw bh
      effect "transparency" 45
      image user.banner ++ "?radius=14" cw - 2 bh - 2
      effect "clear"

      goto cw / -2 + 62 cy - bh
      square 0 0 92 : c#window_colour
      image pfp 84 84
      square 84 84 0 0 1
      if mouse_touching (
        cursor "pointer"
        effect "transparency" 35
        square 0 0 84 : c#000
        effect "clear"
        centext "Change" 8 : c#fff
        if onclick and timer - upload_time > 1 (
          local picked @= askFile(null, "dataURL")
          if picked.name.endsWith(".gif") and !hasTierOrHigher("drive") (
            say "Upgrade to Drive or higher to have animated avatars"
          ) else if picked.name != "" (
            upload_time = timer
            network "update" "pfp" picked.data
          )
        )
      )

      goto cw / -2 + 120 cy - bh - 14
      text user.username.trimText(cw - 260 / 14) 14 : c#txtc
      local badges @= user["sys.badges"]
      if typeof(badges) == "array" (
        change_x 14
        for i badges.len (
          icon badges[i].icon 1 : tooltip#badges[i].name
          if onclick (
            say badges[i].description
          )
          change_x 26
        )
      )
      goto cw / -2 + 120 cy - bh - 36
      text user.system + "account -" + tier 8.5 : c#muted
      cy -= bh + 64

      ui_header "Bio"
      local bio = inputs.bio.join("\n")
      local bio_max = 200
      if hasTierOrHigher("drive") (
        bio_max = 500
      )
      if hasTierOrHigher("pro") (
        bio_max = 1000
      )
      ui_group 1 120
      goto 0 cy - 60
      textbox cw - 30 100 "bio" 10 {
        bg_colour: prim,
        line_numbers: false
      }
      cy -= 120
      if bio != (user.bio ?? "") (
        ui_gap 8
        ui_group 1 ROW
        row_action "Save Bio (" ++ bio.len ++ "/" ++ bio_max ++ ")" "save" def(limit) -> (
          local value = inputs.bio.join("\n").strip()
          if value.len > limit (
            say "Bio too long"
          ) else (
            network "update" "bio" value
          )
        ) bio_max
      )
      ui_gap GAP

      ui_header "Profile"
      ui_group 4 ROW
      row_action "Display Name (" ++ (user.display_name ?? user.username) ++ ")" "accounts" def() -> (
        local value = "Enter your display name".ask().toStr().strip()
        if value != "" (
          network "update" "display_name" value
        )
      ) null
      row_action "Pronouns (" ++ (user.pronouns ?? "not set") ++ ")" "tag" def() -> (
        local value = "Enter your pronouns, e.g. they/them".ask()
        if value != null (
          network "update" "pronouns" value.toStr().strip()
        )
      ) null
      row_nav "Banner" "image" "#8b5cf6" "Banner"
      row_nav "Recurring Payments" "reload" "#f59e0b" "Recurring Payments"
      ui_gap GAP

      local standing = (user["sys.standing"] ?? "good").toStr()
      if standing != "good" (
        ui_header "Account Status"
        ui_group 1 ROW
        row_info "Standing" standing.toTitle()
        local history = user["sys.standing_history"] ?? []
        local reason = ""
        if history.len > 0 (
          reason = " Reason recorded: " ++ history.last().reason
        )
        local recover = user["sys.standing_recover_at"] ?? 0
        if recover > 0 and standing != "banned" (
          reason ++= " Recovers " ++ billingDate(recover) ++ "."
        )
        ui_note "Your account is restricted." ++ reason
      )

      ui_header "Sign-in"
      ui_group 4 ROW
      row_action "Change Email (" ++ user.email ++ ")" "mail" def() -> (
        local value = "Enter your new email".ask()
        if value.toStr() != "" (
          network "update" "email" value
        )
      ) null
      row_action "Change Password" "key" def() -> (
        local value = "Enter your new password".ask()
        if value == null or value == "" (
          say "Cancelled"
        ) else (
          network "update" "password" value.hashMD5()
        )
      ) null
      row_action "Passkeys And Linked Accounts" "open" def() -> (
        http "newtab" "https://rotur.dev/me#security"
      ) null
      row_nav "Backups" "save" "#10b981" "Backups"
      ui_gap GAP

      ui_group 2 ROW
      row_action "Export Account Data" "download" def() -> (
        local data = user
        data["sys.transactions"] = null
        data["sys.logins"] = null
        file "download" "rotur-account.json" null data.JsonFormat() user_folder ++ "/Documents"
        say "Saved rotur-account.json to your Documents"
      ) null
      action_danger = true
      row_action "Log Out" "log-out" def() -> (
        network "logout"
        terminal "shutdown"
      ) null
      break
    case "Banner"
      local banner_free = hasTierOrHigher("pro") or user["sys.banner_unlocked"] == true or user["sys.banner"].toStr() != ""
      local label = "Upload New Banner (30 credits)"
      if banner_free (
        label = "Upload New Banner"
      )
      ui_group 1 ROW
      row_action label "upload" def(free) -> (
        if !free and user["sys.currency"] < 30 (
          say "You do not have enough credits for this"
          return
        )
        local picked @= askFile(null, "dataURL")
        if picked.name == "" (
          say "Please select a file"
        ) else if picked.name.endsWith(".gif") and !hasTierOrHigher("pro") (
          say "Upgrade to Pro to have animated banners"
        ) else (
          network "update" "banner" picked.data
        )
      ) banner_free
      ui_note "You have " ++ user["sys.currency"] ++ " credits. The first upload unlocks banners for good."
      if user["sys.banner"].toStr() != "" (
        ui_header "Current Banner"
        local bh = cw / 3
        ui_card 0 cy - (bh / 2) cw bh
        image user["sys.banner"] cw - 2 bh - 2
        cy -= bh
      )
      break
    case "Recurring Payments"
      load_billing
      if my_keys == null (
        ui_spinner "Fetching subscriptions"
        break
      )
      local subs = my_keys.filter(v -> (v.key != LITE_KEY and typeof(v.subscription) == "object" and v.creator.toStr().toLower() != username.toLower()))
      if subs.len == 0 (
        ui_empty "No product subscriptions"
      )
      for i subs.len (
        local cur @= subs[i]
        local mine = keyUserData(cur)
        ui_header cur.name ?? "Key subscription"
        ui_group 3 ROW
        row_info "Creator" "@" ++ cur.creator
        local period = cur.subscription.period ?? "billing cycle"
        local price = cur.price ++ " credits per " ++ period
        if period != "billing cycle" (
          price = cur.price ++ " credits every " ++ (cur.subscription.frequency ?? 1) ++ " " ++ period
        )
        row_info "Price" price
        if typeof(mine) == "object" and mine.cancel_at != null (
          row_info "Status" renewLabel(mine)
        ) else (
          action_danger = true
          row_action "Cancel (" ++ renewLabel(mine) ++ ")" "close" def(sub) -> (
            changeKey("cancel", sub.key, sub.name ?? "this subscription")
          ) cur
        )
        ui_gap GAP
      )
      ui_note "Subscriptions purchased with rotur credits. Your rotur plan is managed in Membership."
      ui_group 1 ROW
      row_action "Refresh" "reload" def() -> (
        my_keys = null
      ) null
      break
    case "Backups"
      local backups = (user["sys.backups"] ?? []).filter(v -> (typeof(v) == "object"))
      if backups.len == 0 (
        ui_note "You have no backups."
      ) else (
        ui_group backups.len ROW
        for i backups.len (
          row_action backups[i].name + "(" ++ round(backups[i].size / 1000) ++ "kb)" "reload" def(id) -> (
            if "Restore this backup?".confirm() (
              network "server" "restore_backup" id
            )
          ) backups[i].id
        )
      )
      break
  )
)


def "signal_icon" "strength" (
  goto cw / 2 - 28 ry
  icon "network" 0.7 : c#track_col
  icon ["", "w 4 dot 0 -6", "w 3 cutcircle 0 -6 7 0 50 w 4 dot 0 -6", "network"][strength + 1] 0.7 : c#txtc
)

def "page_wifi" (
  ui_group 2 ROW
  row_info "Network" roturlink.wifi.ssid
  row_info "Signal Strength" roturlink.wifi.signal_strength
  ui_gap GAP
  local networks @= roturlink.wifi.scan.sortBy("signal_strength").reverse()
  ui_header networks.len + "networks nearby"
  ui_group networks.len ROW
  for i networks.len (
    ui_row false 0
    ui_label networks[i].ssid "" ""
    signal_icon round(networks[i].signal_strength.clamp(0, 75) / 25)
  )
)

def "page_bluetooth" (
  local devices = roturlink.bluetooth.devices.filter(v -> (v.name != "unknown")).sortBy("rssi").reverse()
  ui_header devices.len + "devices"
  ui_group devices.len ROW
  for i devices.len (
    ui_row false 0
    ui_label devices[i].name "" ""
    signal_icon round((devices[i].rssi + 100).clamp(0, 75) / 25)
  )
)

def "page_network" (
  local status = "No Connection"
  if network.connected (
    status = "Connected"
  )
  ui_group 2 ROW
  row_info "Status" status
  row_info "IP Address" network.ip
  ui_gap GAP
  ui_header "Cors Proxy"
  ui_group 2 ROW
  row_info "Current" user.proxy ?? "https://apps.mistium.com/cors?url="
  row_input "New Proxy" "proxy" 300 "https://" def(value) -> (
    if value.startsWith("https://") (
      network "update" "proxy" value
      inputs.proxy = ""
    ) else (
      say "The proxy must start with https://"
    )
  )
  ui_note "Apps use this proxy to reach sites that block cross-origin requests. Press enter to save."
)


def "page_list_editor" "key, items, extension, defaults" (
  local added = ""
  if new_transmit (
    file "open" transmit_data "onlyaccess"
    added = fileGet(3) ++ "/" ++ fileGet(2) ++ fileGet(1)
    new_transmit = false
  )
  if file_dropped != 0 (
    local parts = open(file_dropped, ["location", "name", "type"])
    added = parts[1] ++ "/" ++ parts[2] ++ parts[3]
    file_dropped = 0
  )
  if added != "" (
    if added.toLower().endsWith("." ++ extension) (
      void items.append(added)
      network "update" key items
    ) else (
      say "Choose a ." ++ extension ++ " file"
    )
  )
  ui_group items.len ROW
  for i items.len (
    row_path items[i]
    if button_click (
      void items.delete(i)
      network "update" key items
      break
    )
    if i > 1 (
      ui_button "up" 56
      if button_click (
        void items.swap(i - 1, i)
        network "update" key items
      )
    )
  )
  ui_gap GAP
  ui_group 2 ROW
  row_action "Add A ." ++ extension ++ " File" "add" def(ext) -> (
    file "pick" ext
  ) extension
  row_action "Reset To Default" "reload" def(args) -> (
    network "update" args[1] args[2]
  ) [key, defaults]
)

def "page_storage" (
  number used = user.used_size.toNum()
  number max = user.max_size.toNum()
  ui_group 1 70
  ui_row false 0
  goto cw / -2 + 22 ry + 14
  text "Rotur Drive" 9 : c#txtc
  goto cw / 2 - 20 ry + 14
  rigtext formatFileSize(used) ++ " of " ++ formatFileSize(max) 9 : c#muted
  goto 0 ry - 14
  c track_col
  bar cw - 42 2 8 used / max global_accent
  ui_gap GAP
  ui_group 1 ROW
  row_action "Upgrade Storage" "up" def() -> (
    nav_cat = "Membership"
  ) null
  ui_gap GAP

  ui_header "Largest Files"
  if scan_left.len > 0 (
    loop 100 (
      if scan_left.len == 0 (
        break
      )
      file "open" scan_left[1] "onlyaccess"
      void scan_left.delete(1)
      if fileGet(1) == ".folder" (
        scan_left ++= fileGet(4)
      ) else (
        void scan_found.append({
          size: fileGet(4).toStr().len,
          name: fileGet(2) ++ fileGet(1)
        })
      )
    )
    ui_spinner scan_found.len + "files scanned"
    scan_top = null
  ) else (
    scan_top ??= scan_found.sortBy("size").reverse().trim(1, 20)
    ui_group scan_top.len ROW
    for i scan_top.len (
      row_info scan_top[i].name formatFileSize(scan_top[i].size)
    )
  )
)

def "page_general" (
  switch subcategory (
    case "none"
      ui_group 1 ROW
      row_nav "About" "info" "#6b7280" "About"
      ui_gap GAP
      ui_group 4 ROW
      row_nav "Date & Time" "alarm-clock" "#3b82f6" "Date & Time"
      row_nav "Login Items" "power" "#10b981" "Login Items"
      row_nav "Default Apps" "grid-apps" "#8b5cf6" "Default Apps"
      row_nav "File Types" "file" "#f59e0b" "File Types"
      ui_gap GAP
      ui_group 1 ROW
      row_nav "Storage" "save" "#6b7280" "Storage"
      break
    case "About"
      goto 0 cy - 40
      icon "origin-logo" 3 : c#txtc
      cy -= 96
      goto 0 cy
      centext "originOS" 14 : c#txtc
      cy -= 34
      ui_group 4 ROW
      local version = origin.version.toNum()
      if version < 100 (
        version *= 100
      )
      local digits = round(version).toStr()
      row_info "Version" digits.left(digits.len - 2) ++ "." ++ digits.right(2)
      row_info "Resolution" screensize_x ++ " x " ++ screensize_y
      row_info "Runtime" "vm.runtime.platform.name".eval()
      row_info "Browser" parseUserAgent("navigator.userAgent".eval())
      ui_note "originOS is a scratch-based desktop environment that runs the OSL programming language. Developed with <3 by Mistium."
      ui_group 1 ROW
      row_action "Buy Me A Monster :3" "open" def() -> (
        http "newtab" "https://ko-fi.com/mistium/tip"
      ) null
      break
    case "Date & Time"
      goto 0 cy - 24
      centext timestamp.timestamp("convert-time") 22 : c#txtc
      cy -= 64
      ui_group 2 ROW
      row_toggle "Show Seconds" user.timeformat.show_seconds def() -> (
        local format = user.timeformat
        format.show_seconds = format.show_seconds.not()
        network "update" "timeformat" format
      )
      row_choice "Clock" ["12h", "24h"] user.timeformat.hours def(value) -> (
        local format = user.timeformat
        format.hours = value
        network "update" "timeformat" format
      )
      ui_note "Your clock is corrected by " ++ time.offset ++ "ms to match the server."
      break
    case "Login Items"
      page_list_editor "onboot" user.onboot "osl" [
        "origin/(a) system/system apps/originWM.osl",
        "origin/(a) system/docks/Dock.osl",
        "origin/(a) system/system apps/Quick_Settings.osl"
      ]
      ui_note "These apps open when you log in. Drop an osl file here to add it."
      break
    case "Default Apps"
      local defaults @= app_defaults.current
      local kinds = defaults.getKeys()
      ui_group kinds.len ROW
      for i kinds.len (
        ui_row false 0
        if row_hover and file_dropped != 0 (
          local parts = open(file_dropped, ["location", "name", "type"])
          if parts[3] == ".shortcut" (
            parts = open(open(file_dropped), ["location", "name", "type"])
          )
          if parts[3] == ".osl" (
            defaults[kinds[i]] = parts[1] ++ "/" ++ parts[2] ++ parts[3]
            save "default_apps.json" "set" defaults
          ) else (
            say "Invalid file type, drop a .osl file"
          )
          file_dropped = 0
        )
        if row_hover and file_dragging (
          goto 0 ry
          square cw - 16 row_h - 16 14 : c#hover_col
        )
        ui_label kinds[i] "" ""
        ui_value defaults[kinds[i]].toStr().split("/").last() kinds[i].len
      )
      ui_note "Drop an app onto a row to make it the default for that kind of file."
      ui_group 1 ROW
      row_action "Reset Default Apps" "reload" def() -> (
        app_defaults.current = app_defaults.original
        save "default_apps.json" "set" app_defaults.current
      ) null
      break
    case "File Types"
      local keys = file_types.getKeys()
      local values @= file_types.getValues()
      ui_group keys.len ROW
      for i keys.len (
        ui_row false 38
        goto cw / -2 + LABEL_X + 12 ry
        square 12 12 12 : c#hover_col
        icon values[i][1] 0.7 : c#txtc
        text values[i][2] 9 : c#txtc chx#26
        ui_value keys[i] values[i][2].len + 4
      )
      break
    case "Storage"
      page_storage
      break
  )
)


def "apply_theme_preview" (
  prim = theme_select.primary
  seco = theme_select.secondary
  tert = theme_select.tertiary
  txtc = theme_select.text
  window_colour = theme_select.background
)

def "save_theme" "next" (
  next.show_outline = user.theme.show_outline
  next.use_blur = user.theme.use_blur
  theme_select = next
  network "update" "theme" next
  apply_theme_preview
)

def "page_appearance" (
  switch subcategory (
    case "none"
      ui_header "Theme"
      local names = themes.getKeys()
      local tw = cw - 20 / names.len
      ui_group 1 92
      for i names.len (
        local preset @= themes[names[i]]
        local tx = cw / -2 + 10 + (i - 0.5 * tw)
        goto tx cy - 36
        square tw - 28 30 12 0 1
        local hit = onclick
        if mouse_touching (
          cursor "pointer"
        )
        if preset.background == user.theme.background and preset.primary == user.theme.primary (
          square tw - 28 30 20 : c#global_accent
        ) else (
          square tw - 28 30 14 : c#edge_col
        )
        c preset.background
        square tw - 28 30 12
        c preset.primary
        square tw - 46 8 8 : chy#5
        c preset.text
        square tw - 56 0 3 : chy#-14 chx#-5
        c preset.accent
        square 0 0 5 : chx#(tw - 46 / 2)
        goto tx cy - 74
        centext names[i].toTitle() 8 : c#txtc
        if hit (
          local next = preset
          next.accent = user.theme.accent ?? preset.accent
          save_theme next
        )
      )
      cy -= 92
      ui_gap GAP

      ui_header "Accent Colour"
      ui_group 1 52
      ui_row false 0
      local custom = !accents.contains(user.theme.accent)
      for i accents.len + 1 (
        goto cw / -2 + LABEL_X + 13 + (i - 1 * 38) ry
        square 0 0 24 0 1
        local hit = onclick
        if mouse_touching (
          cursor "pointer"
        )
        local swatch = accents[i] ?? user.theme.accent
        local current = swatch == user.theme.accent and (i <= accents.len or custom)
        if current (
          square 0 0 30 : c#txtc
          square 0 0 26 : c#prim
        )
        c swatch
        square 0 0 22
        if i > accents.len (
          icon "pen" 0.45 : c#accent_txt
          if hit (
            nav_sub = "Custom Colours"
            selected_col = "accent"
            colourpicker "setcol" user.theme.accent
            colourpicker "show"
          )
        ) else if hit (
          local next = user.theme
          next.accent = accents[i]
          save_theme next
        )
      )
      ui_gap GAP

      ui_header "Windows"
      ui_group 3 ROW
      row_toggle "Show Window Border" user.theme.show_outline != false def() -> (
        update_theme_flag("show_outline")
      )
      row_toggle "Blur" user.theme.use_blur != false def() -> (
        update_theme_flag("use_blur")
      )
      if slider_active != true (
        slider_glass = (user.theme.glass_transparency ?? 100) / 100
      )
      row_slider "Glass Transparency (" ++ round(slider_glass * 100) ++ "%)" "glass"
      if slider_active (
        glass_dragging = true
        user.theme.glass_transparency = round(slider_glass * 100)
      ) else if glass_dragging == true (
        glass_dragging = false
        local theme = user.theme
        theme.glass_transparency = round(slider_glass * 100)
        network "update" "theme" theme
      )
      ui_note "The border uses your accent colour on the focused window. Blur looks better but can slow down older devices. Glass transparency at 0% shows the plain window colour."

      ui_group 2 ROW
      row_nav "Custom Colours" "pen" "#ec4899" "Custom Colours"
      row_nav "Fonts" "w 2.5 line -6 -8 0 8 cont 6 -8 line -3.5 -2 3.5 -2" "#64748b" "Fonts"
      break
    case "Custom Colours"
      if selected_col != "" (
        theme_select[selected_col] = picker_colour
        apply_theme_preview
      )
      ui_group 6 ROW
      row_colour "Accent" "accent"
      row_colour "Window Background" "background"
      row_colour "Primary" "primary"
      row_colour "Secondary" "secondary"
      row_colour "Tertiary" "tertiary"
      row_colour "Text And Icons" "text"
      ui_note "Changes preview in this window only until you save."
      ui_group 2 ROW
      row_action "Save And Apply Theme" "save" def() -> (
        network "update" "theme" theme_select
        selected_col = ""
      ) null
      row_action "Discard Changes" "reload" def() -> (
        theme_select = user.theme
        selected_col = ""
        apply_theme_preview
      ) null
      break
    case "Fonts"
      if typeof(font_list) != "array" (
        ui_spinner "Fetching fonts"
        local data = "https://api.github.com/repos/Mistium/Origin-OS/contents/Fonts".getAsync()
        if typeof(data) == "array" (
          font_list = data.map(v -> (v.name)).filter(v -> (v.endsWith(".ojff"))).map(v -> (v.replace(".ojff", "")))
        )
      ) else (
        ui_group 1 ROW
        ui_row true 0
        ui_label "System Default (Source Code Pro)" "" ""
        if font_current == "" (
          goto cw / 2 - 28 ry
          icon "tick" 0.6 : c#global_accent
        )
        if row_click (
          terminal "font.load origin"
          font_current = ""
        )
        ui_gap GAP
        ui_header "More Fonts"
        ui_group font_list.len ROW
        for i font_list.len (
          ui_row true 0
          ui_label font_list[i].toTitle() "" ""
          if font_list[i] == font_current (
            goto cw / 2 - 28 ry
            icon "tick" 0.6 : c#global_accent
          )
          if row_click (
            terminal "font install " ++ font_list[i]
            terminal "font use " ++ font_list[i]
            font_current = font_list[i]
          )
        )
        ui_note "Fonts download into your Fonts folder. The choice lasts until you restart originOS."
        ui_gap GAP

        if !fonts_scanned (
          fonts_scanned = true
          local found @= (user_folder ++ "/Fonts").listFolder()
          if typeof(found) == "array" (
            for i found.len (
              local entry = found[i].toStr()
              local slug = entry.replace(".ojff", "")
              if entry.endsWith(".ojff") and !font_list.contains(slug) and !custom_fonts.contains(slug) (
                void custom_fonts.append(slug)
              )
            )
          )
        )
        ui_header "Custom Fonts"
        ui_group 2 ROW
        row_input "Google Fonts" "gfont" 220 "Family, e.g. Inter" def(family) -> (
          install_google_font(family.toStr().strip())
        )
        row_action "Install A Font File (.ttf .otf .woff2)" "add" def() -> (
          font_picking = true
          file "pick"
        ) null
        if font_status != "" (
          ui_note font_status
        )
        if new_transmit and font_picking (
          font_picking = false
          if transmit_data != "closed" (
            install_font_file(transmit_data.toStr())
          )
          new_transmit = false
        )
        if custom_fonts.len > 0 (
          ui_gap GAP
          ui_group custom_fonts.len ROW
          for i custom_fonts.len (
            ui_row true 0
            ui_label custom_fonts[i].toTitle() "" ""
            if custom_fonts[i] == font_current (
              goto cw / 2 - 28 ry
              icon "tick" 0.6 : c#global_accent
            )
            if row_click (
              terminal "font use " ++ custom_fonts[i]
              font_current = custom_fonts[i]
            )
          )
        )
        ui_note "A custom font keeps the system glyphs as a fallback and is laid out on origin's character grid, so every app still lines up. Press enter to install a Google font."
      )
      break
  )
)

def wallpaper_info() (
  return ("(()=>{const w=origin.wallpaper||{};const el=window.__osldomWall&&window.__osldomWall.querySelector('video,img');const video=!!el&&el.tagName==='VIDEO';let thumb='';try{const c=document.createElement('canvas');c.width=320;c.height=176;const sw=video?el.videoWidth:el.naturalWidth,sh=video?el.videoHeight:el.naturalHeight;const k=Math.max(320/sw,176/sh);c.getContext('2d').drawImage(el,(320-sw*k)/2,(176-sh*k)/2,sw*k,sh*k);thumb=c.toDataURL('image/jpeg',0.7)}catch(e){thumb=el&&!video?el.src:''}const cur=String(w.current||'');const src=String(w.video||w.data||cur);let name=decodeURIComponent(cur.split('/').pop().split('?')[0]);if(cur==='local'||src.startsWith('data:'))name='Custom '+(video?'Video':'Image');return {thumb:thumb,name:name||'None',kind:video?'Live wallpaper':'Still image'}})()").eval()
)

def "page_wallpaper" (
  if timer - wall_time > 2 or wall == null (
    wall = wallpaper_info()
    wall_time = timer
  )
  ui_group 1 112
  goto cw / -2 + 96 cy - 56
  square 148 76 14 : c#edge_col
  square 148 76 12 : c#hover_col
  if wall.thumb == "" (
    icon "image" 1.2 : c#muted
  ) else (
    style {rounding: 6}
    image wall.thumb 160 88
  )
  goto cw / -2 + 196 cy - 38
  text "CURRENT WALLPAPER" 7.5 : c#muted
  goto cw / -2 + 196 cy - 58
  text wall.name.trimText(cw - 230 / 10) 10 : c#txtc
  goto cw / -2 + 196 cy - 78
  text wall.kind 8 : c#muted
  cy -= 112
  ui_gap GAP

  ui_group 2 ROW
  row_action "Choose A Custom Wallpaper" "image" def() -> (
    local picked @= askFile(null, "dataURL")
    if picked.name != "" (
      terminal "system wallpaper_local " ++ picked.data
    )
  ) null
  local mode = (user.wallpaper_mode ?? "Fill").toStr().toTitle()
  row_choice "Fit" ["Fill", "Center", "Fit", "Stretch"] mode def(picked) -> (
    terminal "system wallpapermode " ++ picked
    network "update" "wallpaper_mode" picked
  )
  ui_gap GAP

  local cols = 2
  local tw = cw / cols
  local th = tw * 0.56
  local names = wallpaper_categories.getKeys()
  for i names.len (
    local wallpapers @= wallpaper_categories[names[i]]
    ui_header names[i]
    for j wallpapers.len (
      local col = j - 1 % cols
      goto cw / -2 + (col + 0.5 * tw) cy - (th / 2)
      if y_position < frame.top + th and y_position > frame.bottom - th (
        square tw - 26 th - 26 14 0 1
        local hit = onclick and mouse_y < frame.top
        local over = mouse_touching
        if over (
          cursor "pointer"
        )
        if wall.name == wallpapers[j] (
          square tw - 26 th - 26 22 : c#global_accent
        ) else if over (
          square tw - 26 th - 26 18 : c#track_col
        ) else (
          square tw - 26 th - 26 16 : c#edge_col
        )
        square tw - 26 th - 26 14 : c#prim
        style {rounding: 7}
        image wallpaper_provider ++ "preview/" ++ wallpapers[j] tw - 12 th - 12
        if hit (
          terminal "system wallpaper " ++ wallpaper_provider ++ "static/" ++ wallpapers[j]
        )
      )
      if col == cols - 1 or j == wallpapers.len (
        cy -= th
      )
    )
    ui_gap 6
  )
)

def "page_dock" (
  page_list_editor "origin_dock" user.origin_dock "ode" [
    "Origin/(A) System/Docks/Modules/main.ode",
    "Origin/(A) System/Docks/Modules/applications.ode",
    "Origin/(A) System/Docks/Modules/folders.ode",
    "Origin/(A) System/Docks/Modules/time.ode",
    "Origin/(A) System/Docks/Modules/battery.ode"
  ]
  ui_note "Dock modules draw left to right in this order. Use the arrows to reorder them, or drop an ode file here to add one."
)

def "display_slider" "label, effect, low, span" (
  display effect "get"
  local current = data.toNum()
  local vars @= Variables()
  vars["slider_fx_" ++ effect] = (current - low / span).clamp(0, 1)
  row_slider label "fx_" ++ effect
  local wanted = round(vars["slider_fx_" ++ effect] * span + low)
  if slider_active and wanted != round(current) (
    display effect "set" wanted
  )
)

def "page_display" (
  ui_group 1 ROW
  row_info "Resolution" screensize_x ++ " x " ++ screensize_y
  ui_gap GAP

  ui_header "Picture"
  ui_group 3 ROW
  display_slider "Brightness" "brightness" 40 120
  display_slider "Contrast" "contrast" 50 100
  display_slider "Saturation" "saturation" 0 200
  ui_gap GAP

  ui_header "Filters"
  ui_group 3 ROW
  display "invert" "get"
  row_toggle "Invert Colours" data.toNum() == 100 def() -> (
    display "invert" "get"
    display "invert" "set" 100 - data.toNum()
  )
  display "saturation" "get"
  row_toggle "Greyscale" data.toNum() == 0 def() -> (
    display "saturation" "get"
    local next = 0
    if data.toNum() == 0 (
      next = 100
    )
    display "saturation" "set" next
  )
  display "sepia" "get"
  row_toggle "Warm Tint" data.toNum() > 0 def() -> (
    display "sepia" "get"
    local next = 40
    if data.toNum() > 0 (
      next = 0
    )
    display "sepia" "set" next
  )
  ui_gap GAP

  ui_header "Performance"
  ui_group 1 ROW
  row_choice "Frame Rate Limit" ["30", "60", "120"] fps_limit def(value) -> (
    fps_limit = value
    terminal "system runtime fps_limit " ++ value
  )
  ui_note "Lower limits save battery. Display settings last until you restart originOS."

  ui_group 1 ROW
  row_action "Reset Display" "reload" def() -> (
    display "reset"
    fps_limit = "60"
    terminal "system runtime fps_limit 60"
  ) null
)

def "page_sound" (
  terminal "system sound get volume"
  local volume = data.toNum()
  slider_volume = volume / 100
  ui_group 1 ROW
  row_slider "Volume (" ++ round(volume) ++ "%)" "volume"
  if slider_active and round(slider_volume * 100) != round(volume) (
    terminal "system sound set volume " ++ round(slider_volume * 100)
  )
  ui_gap GAP

  if media == "" (
    terminal "get access camera"
    local camera = data
    terminal "get access microphone"
    if [data, camera].contains("granted") (
      terminal "get mediadevices"
      media = data.JsonParse()
    ) else (
      media = "denied"
    )
  )
  ui_header "Devices"
  if typeof(media) != "object" (
    ui_note "Grant originOS microphone and camera access in your browser to see your devices."
    return
  )
  local names = media.getKeys()
  local kinds = media.getValues().getKeys("type")
  ui_group names.len ROW
  for i names.len (
    ui_row false 0
    local icn = "volume-max"
    if kinds[i] == "audioinput" (
      icn = "microphone"
    )
    if kinds[i] == "videoinput" (
      icn = "camera"
    )
    ui_label names[i].toStr().trimText(cw / 9 - 10) icn "#6b7280"
  )
)


def "page_mouse" (
  terminal "get scrollspeed"
  local speed = data.toNum()
  local sign = 1
  if speed < 0 (
    sign = -1
  )
  slider_scroll = abs(speed).clamp(1, 10) - 1 / 9
  ui_group 2 ROW
  row_slider "Scroll Speed (" ++ (round(abs(speed) * 10) / 10) ++ "x)" "scroll"
  local wanted = round(slider_scroll * 9 + 1 * 10) / 10 * sign
  if slider_active and wanted != speed (
    terminal "system scrollspeed " ++ wanted
  )
  if !mouse_down and speed != user.scrollspeed (
    network "update" "scrollspeed" speed
  )
  row_toggle "Natural Scrolling" sign == -1 def() -> (
    terminal "get scrollspeed"
    terminal "system scrollspeed " ++ (data.toNum() * -1)
  )
)

def "page_keyboard" (
  local keybinds @= "origin.keyboard?.keybinds".eval()
  local groups = keybinds.getKeys()
  for i groups.len (
    local group = groups[i]
    local binds @= keybinds[group].getKeys()
    ui_header group
    ui_group binds.len + 1 ROW
    for j binds.len (
      local key = binds[j]
      if keybind_edit == group ++ "/" ++ key (
        ui_row false 0
        ui_keycap key
        ui_button "save" 28
        if button_click (
          keybinds[group][key] = inputs.bind.join("\n")
          save "keybinds.json" "set" keybinds.JsonFormat()
          keybind_edit = ""
        )
      ) else (
        ui_row true 0
        ui_keycap key
        ui_value keybinds[group][key].toStr().split("\n")[1] key.len + 8
        if row_click (
          keybind_edit = group ++ "/" ++ key
          inputs.bind = keybinds[group][key].toStr().split("\n")
        )
      )
    )
    row_action "Add A Keybind" "add" def(name) -> (
      local key = "What key?".ask().toStr()
      local all @= "origin.keyboard?.keybinds".eval()
      if key == "" or all[name].contains(key) (
        say "That key is empty or already bound"
      ) else (
        all[name][key] = ""
        save "keybinds.json" "set" all.JsonFormat()
      )
    ) group
    if keybind_edit.startsWith(group ++ "/") (
      ui_gap 8
      ui_group 1 90
      goto 0 cy - 45
      textbox cw - 30 70 "bind" 0 {
        line_numbers: false,
        bg_colour: prim,
        sel_colour: seco,
        text_colour: txtc
      }
      cy -= 90
      ui_gap 8
      ui_group 1 ROW
      action_danger = true
      row_action "Delete This Keybind" "bin" def(path) -> (
        local parts = path.split("/")
        local all @= "origin.keyboard?.keybinds".eval()
        void all[parts[1]].delete(parts[2])
        save "keybinds.json" "set" all.JsonFormat()
        keybind_edit = ""
      ) keybind_edit
    )
    ui_gap GAP
  )
  ui_note "Click a keybind to edit the OSL it runs."
)

def "page_controllers" (
  local gamepads = getGamepads()
  ui_group 1 ROW
  row_info "Connected" gamepads.len ++ " of 4"
  ui_gap GAP
  for i gamepads.len (
    local pad @= gamepads[i]
    ui_header pad.id.trimText(cw / 8 - 6)
    ui_group 1 110
    goto cw / -2 + 40 cy - 30
    for j pad.axes.len (
      square 0 0 30 : c#track_col
      change pad.axes[j].x * 10 pad.axes[j].y * 10
      square 0 0 6 : c#txtc
      change pad.axes[j].x * -10 + 44 pad.axes[j].y * -10
    )
    goto cw / -2 + 34 cy - 78
    for j pad.buttons.len (
      if pad.buttons[j]["pressed"] (
        square 0 0 22 : c#global_accent
      ) else (
        square 0 0 22 : c#track_col
      )
      centext j 7 : c#txtc
      change_x 28
    )
    cy -= 110
    ui_gap GAP
  )
)


def "save_permissions" "perms" (
  file "open" "~/application data/permissions.json" "onlyaccess"
  file "set" 4 perms
  file "close"
)

def "page_permissions" (
  file "open" "~/application data/permissions.json" "onlyaccess"
  local perms = fileGet(4)
  if typeof(perms) != "object" (
    perms = {}
  )
  if new_transmit (
    if transmit_source == picker_id (
      file "open" transmit_data "onlyaccess"
      if fileGet(1) == ".osl" (
        perms[fileGet(14)] ??= []
        perm_app = fileGet(14)
        save_permissions perms
      ) else (
        say "Invalid file type, select a .osl file"
      )
    )
    new_transmit = false
  )
  if perm_app != "" (
    local mine = perms[perm_app] ?? []
    file "open" perm_app "onlyaccess"
    goto 0 cy - 30
    file "render" 2
    cy -= 70
    goto 0 cy
    centext fileGet(2) 10 : c#txtc
    cy -= 30
    ui_group mine.len + 2 ROW
    for i mine.len (
      ui_row false 0
      ui_label mine[i] "" ""
      ui_button "minus" 28
      if button_click (
        void mine.delete(i)
        perms[perm_app] = mine
        save_permissions perms
        break
      )
    )
    row_action "Add A Permission" "add" def(args) -> (
      local name = "Enter the permission name".ask().toStr()
      if name != "" (
        local all = args[1]
        all[args[2]] = (all[args[2]] ?? []).prepend(name)
        save_permissions all
      )
    ) [perms, perm_app]
    row_action "Back To All Apps" "left" def() -> (
      perm_app = ""
    ) null
    return
  )
  local apps = perms.getKeys().filter(v -> (perms[v].len > 0))
  ui_group apps.len + 1 ROW
  for i apps.len (
    file "uuid_exists" apps[i]
    ui_row true 38
    if exists (
      ui_file_icon apps[i]
      text fileGet(2) 9 : c#txtc chx#26
      ui_value perms[apps[i]].len ++ " permissions" fileGet(2).len + 4
    ) else (
      ui_label "Deleted app" "" ""
    )
    if row_click (
      perm_app = apps[i]
    )
  )
  row_action "Choose An App" "open" def() -> (
    file "pick"
    picker_id = data
  ) null
)

def "page_privacy" (
  switch subcategory (
    case "none"
      ui_group 1 ROW
      row_toggle "Private Account" user.private def() -> (
        network "update" "private" user.private.not()
      )
      ui_note "A private account hides your profile from other rotur users."
      ui_group 3 ROW
      row_nav "App Permissions" "permissions" "#3b82f6" "App Permissions"
      row_nav "Recent Logins" "list" "#6b7280" "Recent Logins"
      row_nav "Blocked IPs" "deny" "#ef4444" "Blocked IPs"
      ui_gap GAP
      ui_gap -14
      ui_note "Other rotur users can always see your username, profile picture, banner, bio, theme, credit total, operating system and account creation date."
      break
    case "App Permissions"
      page_permissions
      break
    case "Recent Logins"
      local logins = (user["sys.logins"] ?? []).sortBy("timestamp").reverse().trim(1, 20)
      if logins.len == 0 (
        ui_note "No logins recorded."
      )
      for i logins.len (
        ui_header logins[i].timestamp.timestamp("to-relative")
        ui_group 3 ROW
        row_info "Location" logins[i].country
        row_info "Site" logins[i].origin
        row_info "Device" parseUserAgent(logins[i].userAgent)
        ui_gap GAP
      )
      break
    case "Blocked IPs"
      local blocked = user["blocked_ips"]
      if typeof(blocked) != "array" (
        blocked = []
      )
      ui_group blocked.len + 1 ROW
      for i blocked.len (
        ui_row false 0
        ui_label blocked[i] "" ""
        ui_button "bin" 28
        if button_click (
          void blocked.delete(i)
          network "update" "blocked_ips" blocked
          break
        )
      )
      row_action "Block An IP" "add" def(list) -> (
        local ip = "Enter an ip".ask().toStr().strip()
        if ip == "" or list.contains(ip) (
          say "That ip is empty or already blocked"
        ) else (
          network "update" "blocked_ips" list.append(ip)
        )
      ) blocked
      ui_note "Blocked addresses cannot log into your account. Your ip is " ++ network.ip ++ "."
      break
  )
)


def "plan_paid" "plan, benefits" (
  local tier = displayTier()
  local stripe = billing.provider == "stripe" and billing.stripe_portal == true and ["Plus", "Pro"].contains(tier)
  local price = PLAN_PRICES[plan][interval]
  local period = interval == "Yearly" ? "year" "month"
  local trial = plan == "Plus" and tier == "Free" and billing.plus_trial_eligible == true
  local days = billing.plus_trial_days ?? 7
  local title = plan ++ " (" ++ price ++ "/" ++ period ++ ")"
  if trial (
    title = plan ++ " (" ++ days ++ " days free, then " ++ price ++ "/" ++ period ++ ")"
  )
  ui_header title
  ui_group benefits.len + 1 ROW
  for i benefits.len (
    row_benefit benefits[i]
  )
  if tier == "Pro" and plan == "Plus" (
    row_info "Included in Pro" ""
  ) else if tier == plan and !stripe (
    row_info "Current plan" ""
  ) else if tier == plan or stripe (
    local label = "Switch To " ++ plan
    if tier == plan (
      label = "Manage Billing"
    )
    row_action label "open" def() -> (
      openBilling("portal", null)
    ) null
  ) else (
    local label = "Choose " ++ plan
    if trial (
      label = "Start " ++ days ++ " Day Free Trial"
    )
    local lookup = "rotur_" ++ plan.toLower() ++ "_" ++ interval.toLower()
    row_action label "open" def(key) -> (
      openBilling("checkout", {lookup_key: key})
    ) lookup
  )
  if trial (
    ui_note "No charge today. Cancel before the trial ends to avoid being billed."
  ) else (
    ui_gap GAP
  )
)

def "page_membership" (
  load_billing
  if billing == null or my_keys == null (
    ui_spinner "Fetching your plan"
    return
  )
  if billing.error != null (
    ui_note "Could not load billing: " ++ billing.error
  )
  local tier = displayTier()
  local sub = billing.subscription ?? user["sys.subscription"] ?? {}
  local lite_keys = my_keys.filter(v -> (v.key == LITE_KEY))
  local lite = null
  if lite_keys.len > 0 (
    lite = keyUserData(lite_keys[1])
  )
  local stripe = billing.provider == "stripe" and billing.stripe_portal == true and ["Plus", "Pro"].contains(tier)

  local rows = 1
  if stripe (
    rows ++
  )
  if lite != null (
    rows ++
  )
  ui_group rows ROW
  row_info "Current Plan" tier
  if stripe (
    local state = "Renews "
    if sub.cancel_at_period_end == true (
      state = "Ends "
    )
    row_info "Billing" state ++ billingDate(sub.next_billing ?? 0)
  )
  if lite != null (
    row_info "Lite" "15 credits/month, " ++ renewLabel(lite)
  )
  ui_note "Manage your rotur plan, payment method, and billing period. Lite is paid with rotur credits, Plus and Pro are billed through Stripe."

  if billing.stripe_portal == true (
    ui_header "Billing Settings"
    ui_group 1 ROW
    row_action "Manage Billing" "open" def() -> (
      openBilling("portal", null)
    ) null
    ui_note "Update your payment method, view invoices, or cancel your subscription. Paying monthly? Choose yearly in billing settings to get 4 months free."
  ) else if billing.legacy_kofi == true (
    ui_header "Billing Settings"
    ui_group 1 ROW
    row_action "Manage On Ko-Fi" "open" def() -> (
      http "newtab" "https://ko-fi.com/mistium/tiers"
    ) null
    ui_note "Your plan is billed through Ko-Fi. Plans started here move to Stripe."
  )

  if tier == "Free" (
    ui_header "Choose A Membership"
  ) else (
    ui_header "Change Your Plan"
  )
  ui_group 1 ROW
  row_choice "Billing Period" ["Monthly", "Yearly"] interval def(value) -> (
    interval = value
  )
  ui_note "4 months free with yearly billing. You can start monthly and switch to yearly later in billing settings."

  if interval == "Monthly" (
    ui_header "Lite (15 credits/month)"
    ui_group 5 ROW
    row_benefit "25 MB storage and 10 access products"
    row_benefit "All bio templates and 300-character bios"
    row_benefit "Six months of transaction history"
    row_benefit "400-character Claw posts"
    if lite != null (
      if lite.cancel_at != null (
        row_info renewLabel(lite) ""
      ) else (
        action_danger = true
        row_action "Cancel Lite (" ++ renewLabel(lite) ++ ")" "close" def() -> (
          changeKey("cancel", LITE_KEY, "Lite")
        ) null
      )
    ) else if tier == "Free" (
      row_action "Subscribe With Credits" "up" def() -> (
        changeKey("buy", LITE_KEY, "Lite")
      ) null
    ) else (
      row_info "Included in your current plan" ""
    )
    ui_gap GAP
  )
  plan_paid "Plus" [
    "Animated profile media and custom overlays",
    "100 MB storage and one year of transactions",
    "2x daily credits"
  ]
  plan_paid "Pro" [
    "Everything in Plus",
    "Custom overlays, video backgrounds, and permanent banner access",
    "1 GB storage, 50 access products, and unlimited transactions"
  ]

  ui_header "Credits"
  ui_group 5 ROW
  row_info "Balance" user["sys.currency"] ++ " credits"
  row_action "Buy 50 Credits (£1.99)" "add" def(key) -> (
    openBilling("checkout", {lookup_key: key})
  ) "rotur_credits_50"
  row_action "Buy 250 Credits (£8.99)" "add" def(key) -> (
    openBilling("checkout", {lookup_key: key})
  ) "rotur_credits_250"
  row_action "Buy 500 Credits (£15.99)" "add" def(key) -> (
    openBilling("checkout", {lookup_key: key})
  ) "rotur_credits_500"
  row_action "Open Wallet" "open" def() -> (
    window.create("Wallet")
  ) null
  ui_note "Add credits for cosmetics, access products, groups, gifts, and services. Daily claims and your transaction history live in Wallet."

  ui_group 1 ROW
  row_action "Refresh" "reload" def() -> (
    billing = null
    my_keys = null
  ) null
  ui_note "A plan bought on rotur.dev shows here after you log in again."
)

def "page_credits" (
  switch subcategory (
    case "none"
      ui_group 2 ROW
      row_action "Made With " ++ "vm.runtime.platform.name".eval() "open" def() -> (
        http "newtab" "vm.runtime.platform.url".eval()
      ) null
      row_action "Built On TurboWarp" "open" def() -> (
        http "newtab" "https://turbowarp.org"
      ) null
      ui_note "Thanks to GarboMuffin and the Scratch team for making TurboWarp possible."
      ui_group 3 ROW
      row_nav "Community Supporters" "favorites" "#ec4899" "Supporters"
      row_nav "Github Contributors" "script" "#6b7280" "Contributors"
      row_nav "Loaded Extensions" "cube" "#3b82f6" "Extensions"
      break
    case "Extensions"
      extensions ??= "Object.keys(Object.fromEntries(vm.extensionManager._loadedExtensions))".eval()
      ui_header extensions.len + "extensions"
      ui_group extensions.len ROW
      for i extensions.len (
        ui_row false 0
        ui_label extensions[i] "" ""
      )
      break
    case "Contributors"
      if typeof(contributors) != "array" (
        ui_spinner "Fetching contributors"
        local data = "https://raw.githubusercontent.com/Mistium/Origin-OS/refs/heads/main/contributors.json".getAsync()
        if typeof(data) == "array" (
          contributors = data.filter(v -> (v["type"] == "User"))
        )
      ) else (
        ui_group contributors.len ROW
        for i contributors.len (
          ui_row true 38
          goto cw / -2 + LABEL_X + 12 ry
          style {rounding: 13}
          image contributors[i].avatar_url 26 26
          text contributors[i].login 9 : c#txtc chx#26
          ui_value contributors[i].contributions ++ " commits" contributors[i].login.len + 4
          if row_click (
            http "newtab" "https://github.com/" ++ contributors[i].login
          )
        )
      )
      break
    case "Supporters"
      if typeof(supporters) != "array" (
        ui_spinner "Fetching supporters"
        local data = "https://social.rotur.dev/supporters".getAsync()
        if typeof(data) == "array" (
          supporters = data
        )
      ) else (
        ui_group 1 ROW
        row_action "Support Me!" "open" def() -> (
          http "newtab" "https://ko-fi.com/mistium"
        ) null
        ui_gap GAP
        each tier ["Pro", "Drive", "Plus", "Lite"] (
          local members = supporters.filter(u -> (u.subscription == tier))
          if members.len > 0 (
            ui_header tier
            ui_group members.len ROW
            for i members.len (
              ui_row false 38
              goto cw / -2 + LABEL_X + 12 ry
              image "https://avatars.rotur.dev/" ++ members[i].username ++ "?radius=128" 24 24
              text members[i].username 9 : c#txtc chx#26
            )
            ui_gap GAP
          )
        )
      )
      break
  )
)


