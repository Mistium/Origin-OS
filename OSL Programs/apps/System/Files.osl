// Developer: @Mistium
// Description: File browser and file picker for originOS
//
// Layout: glass sidebar, then a column of tab strip, toolbar, file view and
// status bar. `inputs.path` is the folder being shown. Sizes passed to `box`
// are the visible size, OSL arithmetic runs left to right.

import "window_tools"

permission "request" "file admin"
permission "request" "terminal"

file "use_type" "folder"
save "files@system" "set_directory"

files_paths @= "window.origin.files.index.value".eval()

window.resize(1000, 600)
window.show()

SIDEBAR = 210
// types the preview pane draws and that space opens in Previewer
PICTURE_TYPES = [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".ico"]
MOVIE_TYPES = [".mp4", ".mov", ".webm", ".m4v"]
TABS_H = 44
TOOL_H = 44
HEAD_H = 28
STATUS_H = 38
ROW_H = 34
CELL = 104

user_path = "/(c) users/" ++ username ++ "/"
inputs.path = "/(c) users/" ++ username
inputs.search_input = ""

hidden = []
tabs = []
current_tab = 1
files = []
selected_files = []
drag_id = 0
local_dirs = {}
file_open = ""
current_drive = null
path_edit = false
can = true
deselect = false
file_clicked = false
button_click = false
sidebar_len = 0
current_folder_uuid = ""
cached_search_results = []

string mode = "browse"
array type_filter = []
string current_display_type = "list"
string sorting_mode = "Name"
string sorting_direction = "ascending"
any current_folder_update = null
last_search_query = ""
temp_sorting_mode = ""

// ---------------------------------------------------------------- drawing helpers
// `box`, `hit` and the derived colours (muted, hover_col, edge_col, track_col, accent_txt) come from window_tools

// a 30px icon button at the pen position, result in `button_click`
def "icon_button" "icn, tip, enabled" (
  local x = x_position
  hit 30 30
  button_click = onclick and enabled
  if enabled (
    if mouse_touching (
      cursor "pointer"
      box 30 30 12 : c#hover_col tooltip#tip
    )
    icon icn 0.7 : c#txtc
  ) else (
    icon icn 0.7 : c#track_col
  )
  set_x x
)

// a text button, result in `button_click`
def "text_button" "label, w, fill, ink, enabled" (
  hit w 26
  button_click = onclick and enabled
  if mouse_touching and enabled (
    cursor "pointer"
  )
  if enabled (
    box w 26 12 : c#fill
    centext label 8.5 : c#ink
  ) else (
    box w 26 12 : c#hover_col
    centext label 8.5 : c#muted
  )
)

def plural(number n, string word) string (
  if n == 1 (
    return n ++ " " ++ word
  )
  return n ++ " " ++ word ++ "s"
)

// ---------------------------------------------------------------- navigation

def "navigate" "path" (
  // JsonParse strips osl quotes from around a string
  path = path.JsonParse()
  local entry = {
    "title": path.split("/").last(),
    "url": path,
    "icon": file_types[".folder"][1]
  }
  local tab @= tabs[current_tab]
  tab.type = "folder"
  tab.url = path
  tab.position ++
  tab.history = tab.history.trim(1, tab.position - 1).append(entry)
  inputs.path = path
  path_edit = false
  cur_tab_type = "folder"
  selected_files = []
  // force the listing to rebuild, a search may have replaced `files`
  current_folder_update = null
)

def "refresh" (
  local tab @= tabs[current_tab]
  local entry @= tab.history[tab.position]
  tab.type = entry.type ?? "folder"
  // keep the frame's view of the tab in step, this runs mid-frame on a tab click
  cur_tab_type = tab.type
  current_folder_update = null
  if tab.type == "search" (
    inputs.search_input = entry.search_query ?? ""
  ) else (
    inputs.path = entry.url
  )
)

def "new_tab" "kind" (
  if tabs.len >= 10 (
    return
  )
  local entry = {
    icon: file_types[".folder"][1],
    title: username,
    url: user_folder
  }
  if kind == "search" (
    entry = {
      "type": "search",
      "title": "Search",
      "icon": "search",
      "search_query": ""
    }
  )
  void tabs.append({
    history: [entry],
    position: 1,
    type: kind
  })
  current_tab = tabs.len
  selected_files = []
  refresh
)

def "setup_tabs" (
  tabs = [{
    history: [],
    position: 0,
    type: "folder"
  }]
  current_tab = 1
)

// ---------------------------------------------------------------- listing

def searchFiles(term) (
  if term == "" (
    return []
  )
  return files_paths.search(term).map(v -> v.item)
)

def file_allowed_by_filter(item) (
  if mode != "picker" or type_filter.len == 0 (
    return true
  )
  local ext = ""
  if item.isType("object") (
    ext = item["type"] == "directory" ? ".folder" item.extension
  ) else (
    file "open" item "onlyaccess"
    ext = fileGet(1)
  )
  if ext != ".folder" and ext.startsWith(".").not() (
    ext = "." ++ ext
  )
  return ext == ".folder" or type_filter.contains("*") or type_filter.contains(ext) or type_filter.contains(ext.trim(2, -1))
)

def filter_files_for_picker(file_list) (
  if mode != "picker" or type_filter.len == 0 (
    return file_list
  )
  return file_list.filter(item -> (file_allowed_by_filter(item)))
)

def file_type_label(ext) (
  local info @= file_types[ext]
  if info == null or info[2] == "" (
    return "Document"
  )
  return info[2]
)

def file_display_name(name, ext) (
  if ext == ".folder" (
    return name
  )
  return name ++ ext
)

// uuids sorted by the active column
def sort_files(uuids) (
  local rows = []
  each uuid uuids (
    file "open" uuid "onlyaccess"
    local ext = fileGet(1)
    local row = {
      uuid: uuid,
      name: fileGet(2) ++ ext,
      modified: timestamp - fileGet(10).toNum(),
      filetype: file_type_label(ext),
      size: fileGet(12).toNum()
    }
    if ext == ".folder" (
      row.size = fileGet(4).len
    )
    void rows.append(row)
  )
  return rows.sortBy(sorting_mode.toLower(), sorting_direction).getKeys("uuid")
)

// entries from a roturlink drive listing, sorted by the active column
def sort_local_files(entries) (
  local rows = []
  for i entries.len (
    local entry @= entries[i]
    local ext = entry["type"] == "directory" ? ".folder" entry.extension
    local row = {
      path: entry.path,
      name: entry.name,
      modified: entry.modified,
      filetype: file_type_label(ext),
      extension: ext,
      size: entry.size.toNum()
    }
    if ext == ".folder" (
      row.size = entry.size.len
    )
    void rows.append(row)
  )
  return rows.sortBy(sorting_mode.toLower(), sorting_direction)
)

// fills `files` for the folder, drive or search the current tab shows
def "load_files" (
  current_folder_uuid = ""
  window.drop_location = null
  if cur_tab_type == "search" (
    local query = inputs.search_input ?? ""
    if query != last_search_query (
      last_search_query = query
      cached_search_results @= searchFiles(query)
    )
    files = filter_files_for_picker(cached_search_results ?? [])
    return
  )
  if inputs.path == "origin" (
    files @= open("/")
    return
  )
  if inputs.path.startsWith("/dev") and roturlink.enabled (
    local base = inputs.path.split("/", 3).join("/")
    current_drive @= roturlink.drives.filter(v -> (v.device_node == base))[1]
    local entries = []
    if base == inputs.path (
      entries @= current_drive.files
    ) else (
      local path = current_drive.name ++ "/" ++ inputs.path.split("/").trim(4, -1).join("/")
      entries @= local_dirs[path]
      if entries == null (
        local_dirs[path] = "requesting"
        local pr @= promise.new(def() -> (
          // the local roturLink endpoint for reading the fs
          local resp @= ("http://127.0.0.1:5001/fs/list/Volumes/" ++ self.path).httpGet().JsonParse()
          local_dirs[self.path] = resp.contents
        ))
        pr.worker.path = path
      )
      if typeof(entries) != "array" (
        entries = []
      )
    )
    files @= filter_files_for_picker(sort_local_files(entries.filter(v -> (v.name.startsWith(".").not()))))
    return
  )
  file "exists" inputs.path ++ ".folder"
  if !exists (
    files = []
    return
  )
  file "open" inputs.path ++ ".folder" "onlyaccess"
  current_folder_uuid = fileGet(14)
  local children = (fileGet(4) ?? "").JsonParse()
  window.drop_location = inputs.path
  local sort_key = sorting_mode + sorting_direction + type_filter.JsonStringify()
  if children != current_folder_update or sort_key != temp_sorting_mode (
    current_folder_update = children
    temp_sorting_mode = sort_key
    files = filter_files_for_picker(sort_files(children))
  )
)

// ---------------------------------------------------------------- favourites

array default_favorites = [
  "user/desktop",
  "user/documents",
  "user/applications",
  "user/downloads",
  "user/bin"
]
array favorites = default_favorites

if "favorites.json".saveExists() (
  favorites = "favorites.json".saveGet().map(val -> (val.replace(".folder", "")))
) else (
  save "favorites.json" "set" default_favorites
)

def saveFavorites() (
  save "favorites.json" "set" favorites
)

// ---------------------------------------------------------------- sidebar

def "sidebar_header" "txt" (
  local collapsed = hidden.contains(txt)
  sy -= 8
  goto 0 sy
  hit sw 24
  if mouse_touching (
    cursor "pointer"
  )
  if onclick (
    if collapsed (
      void hidden.delete(txt)
    ) else (
      void hidden.append(txt)
    )
  )
  goto sw / -2 + 10 sy
  text txt.toUpper() 7.5 : c#muted
  goto sw / 2 - 12 sy
  icon collapsed ? "right" "down" 0.45 : c#muted
  sy -= 28
)

def "sidebar_item" "txt, section" (
  if hidden.contains(section) (
    return
  )
  local entry = []
  if txt.startsWith("/dev") (
    local node = txt
    local drive @= roturlink.drives.filter(v -> (v.device_node == node))[1]
    entry = [txt, drive.name, ".folder"]
  ) else (
    entry = open(txt ++ ".folder", ["location", "name", "type"])
    entry[1] = entry.left(2).join("/")
  )
  local active = cur_tab_type != "search" and entry[1].toLower() == inputs.path.toLower()

  goto 0 sy
  hit sw 28
  local over = mouse_touching
  if onclick (
    navigate entry[1]
  )
  if active (
    box sw 28 12 : c#global_accent
  ) else if over (
    cursor "pointer"
    box sw 28 12 : c#hover_col
  )
  if over and section == "Favourites" (
    local idx = favorites.index(txt)
    if mouse_right (
      local move = ["Move Pin"]
      if idx > 1 (
        void move.append({"Up": def(path) -> (
          local at = favorites.index(path)
          favorites.swap(at, at - 1)
          saveFavorites()
        )})
      )
      if idx < favorites.len (
        void move.append({"Down": def(path) -> (
          local at = favorites.index(path)
          favorites.swap(at, at + 1)
          saveFavorites()
        )})
      )
      rightclick [
        {"Open In New Window": def(val) -> (
          if val.startsWith("user/") (
            val = user_folder ++ val.trim(5, -1) ++ ".folder"
          )
          window.create(window.file.uuid, {passed_data: val})
        )},
        "-",
        move,
        {"Unpin": def(path) -> (
          void favorites.delete(path)
          saveFavorites()
        )}
      ] txt
    )
    // dropping a folder here pins it above this row
    if file_dropped != 0 (
      file "open" file_dropped "onlyaccess"
      if fileGet(1) == ".folder" (
        void favorites.insert(idx, fileGet(3) ++ "/" ++ fileGet(2))
        saveFavorites()
        file_dropped = 0
      )
      file "open" txt ++ ".folder" "onlyaccess"
    )
  )
  goto sw / -2 + 20 sy
  stretch [100, 100]
  file "render" 0.85
  c active ? accent_txt txtc
  text entry[2].toStr().trimText(sw - 52 / 9) 9 : chx#22
  sy -= 30
)

// ---------------------------------------------------------------- file view

def "draw_empty" (
  local message = "This folder is empty"
  local icn = "folder"
  if cur_tab_type == "search" (
    icn = "search"
    message = "No matching files"
    if (inputs.search_input ?? "") == "" (
      message = "Type to search your files"
    )
  ) else if mode == "picker" and type_filter.len > 0 (
    message = "No compatible files here"
  )
  goto 0 20
  icon icn 2.2 : c#track_col
  goto 0 -36
  centext message 9.5 : c#muted
)

// draws files[count] at (file_x, file_y) in the current view and runs its click, drag and open logic
def "draw_file" (
  current_file = files[count]
  local use_file_obj = current_file.isType("object")
  file_id = current_file
  if use_file_obj (
    file = [
      current_file["type"] == "directory" ? ".folder" current_file.extension,
      current_file.name,
      inputs.path,
      current_file.modified * 1000,
      current_file.size
    ]
    file_id = current_file.path
  ) else (
    file = open(current_file, [1, 2, 3, 10, 12])
    if file[1] == ".folder" (
      file[5] = open(current_file).len
    )
  )
  local is_folder = file[1] == ".folder"
  local selected = selected_files.contains(file_id)
  local label = file[2]
  if !is_folder and !use_file_obj (
    label ++= file[1]
  )

  goto file_x file_y
  if current_display_type == "list" (
    hit row_w ROW_H - 2
  ) else (
    hit CELL - 8 CELL - 8
  )
  local over = mouse_touching

  // a file dropped onto the list goes to the end of its folder
  if over and file_dropped != 0 and !mouse_down (
    file "open" file_dropped "onlyaccess"
    file "open" fileGet(3) ++ ".folder" "onlyaccess"
    local order @= fileGet(4) ?? []
    void order.delete(file_dropped)
    void order.append(file_dropped)
    file "set" 4 order
    current_folder_update = order
    refresh
    file_dropped = 0
    file "open" current_file "onlyaccess"
  )

  if !use_file_obj (
    rightclick "file" selected_files
  )

  if onclick (
    file_clicked = true
  )
  if onclick and drag_id == 0 (
    if "control".isKeyDown() (
      // add or remove a single file from the selection
      if selected (
        void selected_files.delete(file_id)
      ) else (
        void selected_files.append(file_id)
      )
    ) else if "shift".isKeyDown() and selected_files.len > 0 (
      // select the range from the last selected file to this one
      local anchor = files.index(selected_files.last())
      if anchor < count (
        selected_files ++= files.trim(anchor + 1, count)
      ) else (
        selected_files ++= files.trim(count, anchor - 1)
      )
    ) else (
      // pressing a file that is part of a multi selection keeps it, so the whole selection can be dragged
      if !(selected and selected_files.len > 1) (
        selected_files @= [file_id]
      )
      drag_id = file_id
      can = false
    )
  ) else if drag_id == file_id and selected_files.len > 1 (
    if !over (
      drag_id = 0
      if mouse_down and !use_file_obj (
        file "move" current_file
      )
    ) else if !mouse_down (
      // released without dragging, so it was a plain click
      selected_files @= [file_id]
    )
  ) else if (drag_id == file_id or ("enter".onKeyDown() and selected_files[1] == file_id and !path_edit)) and selected_files.len == 1 (
    if !over (
      // the pointer left the file while held, so this is a drag
      drag_id = 0
      if mouse_down and !use_file_obj (
        file "move" current_file
      )
    )
    if (over and clicked and can) or "enter".onKeyDown() (
      // second click or enter opens it
      drag_id = 0
      if is_folder (
        navigate file[3] ++ "/" ++ file[2]
      ) else if !use_file_obj (
        file "start"
      ) else if origin.build >= 600 (
        local pr @= promise.new(def() -> (
          // the local roturLink endpoint for reading the fs
          local resp @= ("http://127.0.0.1:5001/fs/read/Volumes/" ++ self.path).httpGet().JsonParse()
          local path = ouidNew() ++ "." ++ self.path.split(".")[-1]
          file "goto_dir" "/(d) temp"
          file "set_file" path resp.content
          file "open" path "onlyaccess"
          file "start"
          wait 1
          file "delete"
          file "close"
        ))
        pr.worker.path = file[3].replaceFirst(current_drive.device_node, current_drive.name) ++ "/" ++ file[2]
      )
    )
  ) else if onclick and drag_id != 0 (
    drag_id = 0
  )

  local ink = txtc
  local dim = muted
  goto file_x file_y
  if current_display_type == "list" (
    if selected (
      box row_w ROW_H - 4 12 : c#global_accent
      ink = accent_txt
      dim = accent_txt
    ) else if over (
      box row_w ROW_H - 4 12 : c#hover_col
    )
    goto file_x - (row_w / 2) + 22 file_y
    if use_file_obj (
      icon (file_types[file[1]] ?? file_types[".txt"])[1] 0.85 : c#ink
    ) else (
      file "render" 0.85
    )
    goto file_x - (row_w / 2) + 44 file_y
    text label.trimText(name_chars) 9 : c#ink

    local edited = file[4].toNum()
    if wide (
      goto file_x + (row_w / 2) - 330 file_y
      text timestamp - edited < 172800000 ? edited.timestamp("convert-relative") edited.timestamp("convert-date") 8.5 : c#dim
    )
    goto file_x + (row_w / 2) - 215 file_y
    text file_type_label(file[1]).trimText(14) 8.5 : c#dim
    goto file_x + (row_w / 2) - 14 file_y
    if is_folder (
      rigtext plural(file[5], "item") 8.5 : c#dim
    ) else (
      rigtext formatFileSize(file[5]) 8.5 : c#dim
    )
  ) else (
    if selected or over (
      goto file_x file_y + 12
      box 64 60 16 : c#hover_col
    )
    goto file_x file_y + 12
    if use_file_obj (
      icon (file_types[file[1]] ?? file_types[".txt"])[1] 1.6 : c#txtc
    ) else (
      file "render" 1.6
    )
    local short = label.trimText(11)
    goto file_x file_y - 32
    if selected (
      box short.len * 8 + 12 18 10 : c#global_accent
      ink = accent_txt
    )
    centext short 8 : c#ink
  )
)

def "sort_header" "label, x, align_right" (
  local width = label.len * 8 + 18
  local hit_x = x + (width / 2) - 4
  if align_right (
    hit_x = x - (width / 2) + 4
  )
  goto hit_x head_y
  hit width 22
  if mouse_touching (
    cursor "pointer"
  )
  if onclick (
    if sorting_mode == label (
      sorting_direction = sorting_direction == "ascending" ? "descending" "ascending"
    ) else (
      sorting_mode = label
      sorting_direction = "ascending"
    )
  )
  local active = sorting_mode == label
  goto x head_y
  c active ? txtc muted
  if align_right (
    rigtext label 8
    if active (
      goto x - (label.len * 8) - 10 head_y
      icon sorting_direction == "ascending" ? "up" "down" 0.35
    )
  ) else (
    text label 8
    if active (
      icon sorting_direction == "ascending" ? "up" "down" 0.35 : chx#10
    )
  )
)

def "draw_preview" (
  local pw = PREVIEW - 16
  local ph = view_top - view_bottom
  goto view_right + (PREVIEW / 2) view_bottom + (ph / 2)
  box pw + 2 ph + 2 18 : c#edge_col
  box pw ph 16 : c#prim
  local px = x_position
  local left = px - (pw / 2) + 16
  local py = view_top - 70

  if selected_files.len != 1 (
    local total_size = 0
    local folder_count = 0
    each uuid selected_files (
      file "open" uuid "onlyaccess"
      if fileGet(1) == ".folder" (
        folder_count ++
      ) else (
        total_size += fileGet(12).toNum()
      )
    )
    goto px py
    icon "copy" 2.4 : c#muted
    goto px py - 70
    centext selected_files.len ++ " selected" 11 : c#txtc
    goto px py - 96
    centext plural(selected_files.len - folder_count, "file") ++ ", " ++ plural(folder_count, "folder") 8.5 : c#muted
    goto px py - 118
    centext formatFileSize(total_size) ++ " in total" 8.5 : c#muted
    return
  )

  file "open" selected_files[1] "onlyaccess"
  local ext = fileGet(1)
  local name = file_display_name(fileGet(2), ext)
  // images show themselves, everything else shows its icon
  local pictured = false
  if PICTURE_TYPES.contains(ext.toStr().toLower()) and fileGet(12).toNum() < 4000000 (
    local pic = fileGet(4).toStr()
    if pic.startsWith("data:image") or pic.startsWith("http") (
      local iw = pic.imageinfo("width")
      local ih = pic.imageinfo("height")
      if iw > 0 and ih > 0 (
        local k = min((pw - 32) / iw, 110 / ih)
        goto px py + 5
        image pic iw * k ih * k
        pictured = true
      )
    )
  )
  if !pictured (
    goto px py
    file "render" 3
  )
  goto px py - 70
  centext name.trimText(pw - 24 / 10) 10 : c#txtc
  goto px py - 92
  centext file_type_label(ext) 8.5 : c#muted

  local rows = [
    ["Location", fileGet(3)],
    ["Created", fileGet(9).timestamp("convert-relative")],
    ["Edited", fileGet(10).timestamp("convert-relative")],
    ["Size", formatFileSize(fileGet(12).toNum())],
    ["UUID", fileGet(14)]
  ]
  if ext == ".folder" (
    rows[4] = ["Contents", plural(fileGet(4).len, "item")]
  )
  local ry = py - 130
  for i rows.len (
    goto px ry + 13
    square pw - 32 0 1 : c#edge_col
    goto left ry
    text rows[i][1] 8 : c#muted
    goto px + (pw / 2) - 16 ry
    rigtext rows[i][2].toStr().trimText(pw - 110 / 8) 8 : c#txtc
    ry -= 26
  )

  goto px view_bottom + 30
  text_button "Copy Path" pw - 32 hover_col txtc true
  if button_click (
    clipboard "set" fileGet(3) ++ "/" ++ name
  )
)

// ---------------------------------------------------------------- startup

setup_tabs

if passed_data != "" (
  if typeof(passed_data) == "object" (
    if ["browse", "picker"].contains(passed_data.mode) and typeof(passed_data.types ?? []) == "array" and typeof(passed_data.path ?? "") == "string" (
      mode = passed_data.mode
      type_filter = passed_data.types ?? []
      navigate passed_data.path ?? user_folder
    ) else (
      error "Invalid configuration passed to Files app, closing"
      window.close()
    )
  ) else (
    file "open" passed_data "onlyaccess"
    if fileGet(1) == ".folder" (
      navigate fileGet(3) ++ "/" ++ fileGet(2)
    ) else (
      // navigate clears the selection, so select the file afterwards
      local reveal = fileGet(14)
      navigate fileGet(3)
      selected_files = [reveal]
    )
  )
) else (
  navigate user_folder
)

mainloop:
load_theme

if typeof(tabs) != "array" or tabs.len == 0 (
  setup_tabs
  navigate user_folder
)
if !mouse_down (
  can = true
)

cur_tab_type = tabs[current_tab].type ?? "folder"
// not named sidebar: names are case-insensitive and that would overwrite SIDEBAR
local side_w = window.width > 700 ? SIDEBAR 0
PREVIEW = 0
if window.width > 1000 and selected_files.len > 0 (
  PREVIEW = 270
)
local cl = window.left + side_w
local cr = window.right
local cmid = cl + cr / 2
local in_bin = cur_tab_type != "search" and inputs.path.toLower() == (user_folder ++ "/bin").toLower()

// page background, squared off where it meets the glass sidebar
window.setGlass(100, "15px")
goto side_w / 2 0
square window.width - side_w - 10 window.height + 10 10 : c#window_colour
if side_w > 0 (
  goto cl + 12 0
  square 20 window.height 4
  c window_colour
  pen "opacity" 55
  icon "w 99999 dot 0 0" 10
  pen "opacity" 0
  frame "clear"
)

// ---- sidebar
if side_w > 0 (
  // the first header sits on the window buttons' centre line, 21 below the top,
  // and the rows keep the same 6 inset at the sides as they have at the top
  frame window.left window.top cl window.bottom sidebar_len "sidebar" (
    sw = frame.width - 12
    sy = frame.top - 12 + frame.scroll
    local top = sy
    sidebar_header "Favourites"
    each fav favorites (
      sidebar_item fav "Favourites"
    )
    sidebar_header "Locations"
    sidebar_item "/(a) system" "Locations"
    sidebar_item "/(b) local" "Locations"
    sidebar_item "/(c) users/" ++ username "Locations"
    if roturlink.enabled and roturlink.drives.len > 0 (
      sidebar_header "External"
      for i roturlink.drives.len (
        sidebar_item roturlink.drives[i].device_node "External"
      )
    )
    sidebar_len = top - sy + 30
  )
  goto cl 0
  square 0 window.height 1 : c#edge_col
)

// ---- tab strip, the rest of this row drags the window
local tab_y = window.top - 21
local tab_w = (cr - cl - 190 / tabs.len).clamp(70, 190)
// tabs, toolbar, file view and status bar all keep a 6 inset from the pane edges, like the window buttons
local tx = cl + 4
// `count` stays global for draw_file, so this loop must not shadow it
for ti tabs.len (
  local tab @= tabs[ti]
  local entry @= tab.history[tab.position]
  local title = entry.title
  if entry.url == user_folder (
    title = username
  )
  if title.toStr() == "" (
    title = "Search"
  )
  goto tx + (tab_w / 2) tab_y
  hit tab_w - 4 27
  local over = mouse_touching
  if onclick and ti != current_tab (
    current_tab = ti
    selected_files = []
    refresh
  )
  if ti == current_tab (
    box tab_w - 2 29 14 : c#edge_col
    box tab_w - 4 27 12 : c#prim
  ) else if over (
    cursor "pointer"
    box tab_w - 4 27 12 : c#hover_col
  )
  goto tx + 18 tab_y
  icon entry.icon 0.65 : c#txtc
  c ti == current_tab ? txtc muted
  text title.toStr().trimText(tab_w - 62 / 8.5) 8.5 : chx#16
  if tabs.len > 1 and (over or ti == current_tab) (
    goto tx + tab_w - 18 tab_y
    hit 18 18
    if mouse_touching (
      cursor "pointer"
      box 18 18 9 : c#track_col
    )
    icon "close" 0.4 : c#txtc
    if onclick (
      void tabs.delete(ti)
      if current_tab > tabs.len (
        current_tab = tabs.len
      )
      selected_files = []
      refresh
      break
    )
  )
  tx += tab_w
)
goto tx + 20 tab_y
icon_button "add" "New tab" tabs.len < 10
if button_click (
  new_tab "folder"
)
window.setDragbox([2, 2, side_w + (tx - cl) + 44, 0], [-2, 2, -92, 0 - TABS_H])

// ---- toolbar
local tool_y = window.top - TABS_H - (TOOL_H / 2) + 4
local tab @= tabs[current_tab]
goto cl + 21 tool_y
icon_button "left-arrow" "Back" tab.position > 1
if button_click or ("arrowleft".onKeyDown() and "alt".isKeyDown() and tab.position > 1) (
  tab.position --
  refresh
)
goto cl + 55 tool_y
icon_button "right-arrow" "Forward" tab.position < tab.history.len
if button_click (
  tab.position ++
  refresh
)
goto cl + 89 tool_y
icon_button "up-arrow" "Enclosing folder" cur_tab_type != "search" and inputs.path != "origin"
if button_click (
  navigate inputs.path.split("/").trim(1, -2).join("/")
)

goto cr - 38 tool_y
local view_names = ["list", "grid"]
box 64 30 12 : c#prim
for i 2 (
  goto cr - 70 + (i * 32) - 16 tool_y
  hit 28 26
  if mouse_touching (
    cursor "pointer"
  )
  if onclick (
    current_display_type = view_names[i]
  )
  if current_display_type == view_names[i] (
    box 28 26 10 : c#track_col
  )
  local view_icon_size = i == 2 ? 0.55 0.7
  icon view_names[i] view_icon_size : c#txtc
)
goto cr - 94 tool_y
icon_button "folder" "New folder" cur_tab_type != "search"
if button_click (
  file "download" "new folder.folder" null null inputs.path
)
goto cr - 128 tool_y
icon_button "file" "New file" cur_tab_type != "search"
if button_click (
  window "add" "New_File" inputs.path
)
goto cr - 162 tool_y
icon_button "search" "Search in a new tab" tabs.len < 10
if button_click (
  new_tab "search"
  input "focus" "search_input"
)

// path bar: breadcrumbs until clicked, then an editable path
local bar_l = cl + 113
local bar_r = cr - 186
local bar_w = bar_r - bar_l
goto bar_l + bar_r / 2 tool_y
hit bar_w 30
local bar_click = onclick
box bar_w 30 12 : c#prim
if cur_tab_type == "search" (
  goto bar_l + 18 tool_y
  icon "search" 0.5 : c#muted
  goto bar_l + bar_r / 2 + 12 tool_y
  c prim
  input bar_w - 44 24 "search_input" "Search files" 9 txtc
  local entry @= tab.history[tab.position]
  if (inputs.search_input ?? "") != (entry.search_query ?? "") (
    entry.search_query = inputs.search_input ?? ""
    entry.title = inputs.search_input ?? ""
  )
) else if path_edit (
  goto bar_l + bar_r / 2 tool_y
  c prim
  input bar_w - 20 24 "path" null 9 txtc
  if "enter".onKeyDown() (
    navigate inputs.path
  ) else if selected_input != "path" or "escape".onKeyDown() (
    path_edit = false
    refresh
  )
) else (
  local parts = inputs.path.split("/").filter(v -> (v != ""))
  // drop leading folders until the trail fits
  local start = 1
  local used = parts.join("").len * 9 + (parts.len * 22)
  while used > bar_w - 40 and start < parts.len (
    used -= parts[start].len * 9 + 22
    start ++
  )
  local bx = bar_l + 14
  if start > 1 (
    goto bx tool_y
    text "..." 9 : c#muted
    bx += 36
  )
  local crumb_hit = false
  for i parts.len - start + 1 (
    local idx = start + i - 1
    local part = parts[idx].toStr()
    local part_w = part.len * 9
    goto bx + (part_w / 2) tool_y
    hit part_w + 10 24
    if mouse_touching (
      cursor "pointer"
      box part_w + 10 24 10 : c#hover_col
    )
    if onclick (
      crumb_hit = true
      if idx < parts.len (
        navigate parts.trim(1, idx).join("/")
      )
    )
    goto bx tool_y
    c idx == parts.len ? txtc muted
    text part 9
    bx += part_w + 22
    if idx < parts.len (
      goto bx - 11 tool_y
      icon "right" 0.35 : c#muted
    )
  )
  if bar_click and !crumb_hit (
    path_edit = true
    input "focus" "path"
  )
)

// ---- file view
view_left = cl + 8
view_right = cr - PREVIEW - 8
view_top = window.top - TABS_H - TOOL_H
view_bottom = window.bottom + STATUS_H
wide = view_right - view_left > 600
load_files

local list_top = view_top
if current_display_type == "list" and files.len > 0 (
  list_top -= HEAD_H
  head_y = view_top - (HEAD_H / 2) + 2
  // scrolling frames keep a 10px scrollbar gutter on the right, so columns end there
  local list_right = view_right - 10
  sort_header "Name" view_left + 50 false
  if wide (
    sort_header "Modified" list_right - 336 false
  )
  sort_header "Filetype" list_right - 221 false
  sort_header "Size" list_right - 20 true
  goto view_left + view_right / 2 list_top
  square view_right - view_left - 16 0 1 : c#edge_col
)

local scroll_len = files.len * ROW_H + 12
local per_line = max(1, floor(view_right - view_left - 12 / CELL))
if current_display_type == "grid" (
  scroll_len = ceil(files.len / per_line) * CELL + 12
)

// the engine drags every file listed here when one of them starts a drag
window.file_selection = selected_files
frame view_left list_top view_right view_bottom scroll_len "files_" ++ current_tab (
  if current_folder_uuid != "" (
    // background of the folder takes drops and the folder menu
    goto 0 0
    hit frame.width frame.height
    rightclick ["New Folder Inside", "New File", "Edit Folder Contents", "-", "Info"] [current_folder_uuid]
    if onclick and !"control".isKeyDown() and !"shift".isKeyDown() (
      deselect = true
    )
  )
  if files.len == 0 (
    draw_empty
  ) else if current_display_type == "list" (
    row_w = frame.width - 12
    name_chars = row_w - (wide ? 395 280) / 9
    count = max(0, floor(frame.scroll / ROW_H))
    loop min(files.len - count, ceil(frame.height / ROW_H) + 1) (
      count ++
      file_x = 0
      file_y = frame.top - 6 + frame.scroll - (count - 0.5 * ROW_H)
      draw_file
    )
  ) else (
    local cell_w = frame.width - 12 / per_line
    local first = max(0, floor(frame.scroll / CELL)) * per_line
    count = first
    loop min(files.len - first, (ceil(frame.height / CELL) + 1) * per_line) (
      count ++
      file_x = frame.left + 6 + ((count - 1 % per_line) + 0.5 * cell_w)
      file_y = frame.top - 6 + frame.scroll - (floor(count - 1 / per_line) + 0.5 * CELL)
      draw_file
    )
  )
  // a click on empty space clears the selection, a click on a file sets drag_id first
  if deselect and !file_clicked (
    selected_files = []
  )
  deselect = false
  file_clicked = false

  if selected_files.len == 1 and !path_edit (
    local at = files.index(selected_files[1])
    local step = current_display_type == "grid" ? per_line 1
    if "arrowup".onKeyDown() and at > step (
      selected_files = [files[at - step]]
    )
    if "arrowdown".onKeyDown() and at + step <= files.len (
      selected_files = [files[at + step]]
    )
    if current_display_type == "grid" (
      if "arrowleft".onKeyDown() and !"alt".isKeyDown() and at > 1 (
        selected_files = [files[at - 1]]
      )
      if "arrowright".onKeyDown() and at < files.len (
        selected_files = [files[at + 1]]
      )
    )
  )
)

// space on a picture or a video opens it in Previewer, without changing the default app
if "space".onKeyDown() and selected_files.len == 1 and mode != "picker" and !path_edit and cur_tab_type != "search" (
  file "open" selected_files[1] "onlyaccess"
  local quick_ext = fileGet(1).toStr().toLower()
  if PICTURE_TYPES.contains(quick_ext) or MOVIE_TYPES.contains(quick_ext) (
    window.create("/(a) system/user applications/Previewer.osl", selected_files[1])
  )
)

if PREVIEW > 0 (
  draw_preview
)

// ---- status bar
local status_y = window.bottom + (STATUS_H / 2)
goto cmid window.bottom + STATUS_H
square cr - cl 0 1 : c#edge_col
goto cl + 16 status_y
local status = plural(files.len, "item")
if cur_tab_type == "search" (
  status = plural(files.len, "result")
)
if selected_files.len > 0 (
  status ++= ", " ++ selected_files.len ++ " selected"
)
if mode == "picker" and type_filter.len > 0 (
  status ++= "  -  " ++ type_filter.join(", ")
)
text status 8.5 : c#muted

if mode == "picker" (
  goto cr - 44 status_y
  text_button "Open" 76 global_accent accent_txt selected_files.len > 0
  if button_click (
    local picked @= selected_files.len == 1 ? selected_files[1] selected_files
    transmit picked window.parent.id
    window.close()
  )
  goto cr - 130 status_y
  text_button "Cancel" 76 hover_col txtc true
  if button_click (
    transmit "closed" window.parent.id
    window.close()
  )
) else if selected_files.len == 1 and !selected_files[1].isType("object") and !selected_files[1].toStr().contains("/") (
  file_open = selected_files[1]
  file "open" file_open "onlyaccess"
  file "get" 13
  local actions = ["open", "edit", "copy", "rename", "bin", "info"]
  if "System" in data (
    actions = ["open", "copy", "info"]
  )
  for i actions.len (
    local action = actions[actions.len - i + 1]
    goto cr + 11 - (i * 32) status_y
    icon_button action action.toTitle() true
    if button_click (
      file "open" file_open "onlyaccess"
      switch action (
        case "open"
          file "start"
          break
        case "edit"
          window "add" "studio" file_open
          break
        case "copy"
          clipboard "set" file
          break
        case "rename"
          window "add" "Rename-Helper" file_open
          break
        case "info"
          window "add" "Files_Info" file_open
          break
        case "bin"
          // the file may already be gone
          try (
            file "move_to_bin"
          )
          selected_files = []
          break
      )
    )
  )
) else if in_bin and files.len > 0 (
  goto cr - 54 status_y
  text_button "Empty Bin" 96 "#f87171" "#111111" true
  if button_click and "Permanently delete everything in the bin?".confirm() (
    each uuid files (
      file "open" uuid "onlyaccess"
      file "delete"
    )
    file "open" inputs.path ++ ".folder" "onlyaccess"
    file "set" 4 []
    selected_files = []
  )
)

import "win-buttons"
