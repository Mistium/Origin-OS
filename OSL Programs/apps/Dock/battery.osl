self.width = 60
self.enabled = false

def conditions() (
  return battery_percent < 100 and battery_percent > 0 or !battery_charging
)

def main() (
  self.width = 60

  square self.width height 20 1 0 1 : chx#30
  if clicked (
    open_path = "Origin/(A) System/Docks/Battery_Info.osl"
  )
  centext `${battery_percent}%` 10 : c#icon_colour
)
