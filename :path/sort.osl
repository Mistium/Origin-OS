// sort [-r] [-u] [-n] [file]
local flags = ""
local filePath = null
for i args.len (
  local a = "" ++ args[i]
  if a.startsWith("-") and a.len > 1 (
    flags ++= a.trim(2, -1)
  ) else (
    filePath = terminal.resolvePath(a)
  )
)
local input = null
if terminal.stdin != null (
  input = terminal.stdin
) else if filePath != null (
  file "exists" filePath
  if !exists (
    terminal.writeLine("sort: cannot read '" ++ args[args.len] ++ "': No such file or directory")
    return
  )
  input = "" ++ open(filePath)
)
if input == null (
  terminal.writeLine("usage: sort [-r] [-u] [-n] [file]")
  return
)
local lines = input.split("\n")
if flags.contains("n") (
  local keyed = []
  for i lines.len (
    void keyed.append({k: lines[i].strip().toNum() ?? 0, v: lines[i]})
  )
  keyed = keyed.sortBy("k")
  lines = []
  for i keyed.len (
    void lines.append(keyed[i].v)
  )
) else (
  lines = lines.sort()
)
if flags.contains("r") (
  lines = lines.reverse()
)
if flags.contains("u") (
  local unique = []
  local prev = null
  for i lines.len (
    if i == 1 or lines[i] != prev (
      void unique.append(lines[i])
    )
    prev = lines[i]
  )
  lines = unique
)
for i lines.len (
  terminal.writeLine(lines[i])
)
