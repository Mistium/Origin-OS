// touch file ...   create empty files (or update the edited time). Names without an extension become folders.
if args.len == 0 (
  terminal.writeLine("usage: touch file ...")
  return
)
for i args.len (
  local t = ("" ++ args[i]).strip()
  if t.len == 0 (
    terminal.writeLine("touch: invalid file name")
  ) else (
    local p = terminal.resolvePath(t)
    local name = p.split("/")[-1]
    if !name.contains(".") (
      p ++= ".folder"
    )
    file "exists" p
    if exists (
      file "open" p "onlyaccess"
      file "set" "edited" timestamp
      file "close"
    ) else if p.endsWith(".folder") (
      file "set_file" p []
    ) else (
      file "set_file" p ""
    )
  )
)
