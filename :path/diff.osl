// diff file1 file2   line differences (< only in file1, > only in file2)
if args.len < 2 (
  terminal.writeLine("usage: diff file1 file2")
  return
)
local pa = terminal.resolvePath(args[1])
local pb = terminal.resolvePath(args[2])
file "exists" pa
if !exists (
  terminal.writeLine("diff: " ++ args[1] ++ ": No such file or directory")
  return
)
file "exists" pb
if !exists (
  terminal.writeLine("diff: " ++ args[2] ++ ": No such file or directory")
  return
)
local a = ("" ++ open(pa)).split("\n")
local b = ("" ++ open(pb)).split("\n")
local n = a.len
local m = b.len
if n * m > 400000 (
  terminal.writeLine("diff: files too large for a full diff, comparing line by line")
  local changed = 0
  for i max(n, m) (
    if a[i] != b[i] (
      changed += 1
      if i <= n (
        terminal.writeLine(["#ff6b6b", "< " ++ a[i]])
      )
      if i <= m (
        terminal.writeLine(["#4ade80", "> " ++ b[i]])
      )
    )
  )
  if changed == 0 (
    terminal.writeLine("files are identical")
  )
  return
)
// LCS table, (n+1) x (m+1), stored row-major in one flat array
local w = m + 1
local table = []
loop ((n + 1) * w) + 2 (
  void table.append(0)
)
local i = n
while i >= 1 (
  local j = m
  while j >= 1 (
    local idx = (i - 1) * w + j
    if a[i] == b[j] (
      table[idx] = table[(i * w) + (j + 1)] + 1
    ) else (
      table[idx] = max(table[(i * w) + j], table[((i - 1) * w) + (j + 1)])
    )
    j -= 1
  )
  i -= 1
)
local out = []
i = 1
local j = 1
local same = 0
while i <= n or j <= m (
  if i <= n and j <= m and a[i] == b[j] (
    same += 1
    i += 1
    j += 1
  ) else if j <= m and (i > n or table[((i - 1) * w) + (j + 1)] >= table[(i * w) + j]) (
    void out.append(["#4ade80", j ++ "> " ++ b[j]])
    j += 1
  ) else (
    void out.append(["#ff6b6b", i ++ "< " ++ a[i]])
    i += 1
  )
)
if out.len == 0 (
  terminal.writeLine("files are identical")
)
for k out.len (
  terminal.writeLine(out[k])
)
