// printf format [args ...]   supports %s %d %%, \n and \t
if args.len == 0 (
  terminal.writeLine("usage: printf format [args ...]")
  return
)
local fmt = ("" ++ args[1]).replace("\\n", "\n").replace("\\t", "\t")
local out = ""
local ai = 2
local i = 1
while i <= fmt.len (
  local ch = fmt[i]
  if ch == "%" and i < fmt.len (
    local spec = fmt[i + 1]
    i += 1
    if spec == "%" (
      out ++= "%"
    ) else if spec == "s" (
      out ++= "" ++ (args[ai] ?? "")
      ai += 1
    ) else if spec == "d" or spec == "i" (
      out ++= "" ++ (("" ++ (args[ai] ?? "0")).toNum() ?? 0)
      ai += 1
    ) else (
      out ++= "%" ++ spec
    )
  ) else (
    out ++= ch
  )
  i += 1
)
terminal.write(out)
