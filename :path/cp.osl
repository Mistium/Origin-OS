// cp [-r] source destination
local recursive = false
local targets = []
for i args.len (
  local a = "" ++ args[i]
  if a.startsWith("-") and a.len > 1 (
    recursive = recursive or a.contains("r") or a.contains("R")
  ) else (
    void targets.append(a)
  )
)
if targets.len < 2 (
  terminal.writeLine("usage: cp [-r] source destination")
  return
)
local src = targets[1]
local dst = targets[2]
local srcPath = terminal.resolvePath(src)
local isDir = false
file "exists" srcPath
if !exists (
  file "exists" (srcPath ++ ".folder")
  if exists (
    isDir = true
  ) else (
    terminal.writeLine("cp: cannot stat '" ++ src ++ "': No such file or directory")
    return
  )
)
local dstPath = terminal.resolvePath(dst)
file "exists" (dstPath ++ ".folder")
if exists (
  dstPath ++= "/" ++ srcPath.split("/")[-1]
)

def copyTree(srcDir, dstDir) (
  file "exists" (dstDir ++ ".folder")
  if !exists (
    file "set_file" (dstDir ++ ".folder") []
  )
  local names = listFiles(srcDir)
  for i names.len (
    local n = "" ++ names[i]
    if n.endsWith(".folder") (
      copyTree(srcDir ++ "/" ++ n.trim(1, -8), dstDir ++ "/" ++ n.trim(1, -8))
    ) else (
      file "set_file" (dstDir ++ "/" ++ n) open(srcDir ++ "/" ++ n)
    )
  )
)

if isDir (
  if !recursive (
    terminal.writeLine("cp: -r not specified; omitting directory '" ++ src ++ "'")
    return
  )
  copyTree(srcPath, dstPath)
) else (
  file "set_file" dstPath open(srcPath)
)
