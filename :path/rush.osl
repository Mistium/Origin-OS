// rush: the default originOS shell. The Terminal app runs this script inside each pane's worker with
// `terminal` bound to that pane. A shell only needs terminal.readLine(prompt) and terminal.writeLine(text);
// put a different script in ~/:path and name it in ~/:path/default_shell.txt to use it instead.

// :path scripts follow the same source as the system apps, so a local origin-os checkout serves its own commands
path_url ??= "https://origin.mistium.com/%3Apath/"
try (
  local src = "" ++ ("String(window.origin && window.origin.repoSource || '')".eval() ?? "")
  if src.startsWith("http") (
    path_url = src ++ "%3Apath/"
  )
) catch e (
  path_url = "https://origin.mistium.com/%3Apath/"
)
path = {}
try (
  path = (path_url ++ "osl-tracker.json").httpGet()
  if typeof(path) !== "object" (
    path = {}
  )
) catch e (
  path = {}
)

path = (path.scripts ?? {}).getValues()
last = []
aliases = {}
home_path ??= "" ++ (user_folder ?? "")
if home_path == "" (
  home_path = "origin/(c) users/" ++ ("" ++ username).toLower()
)

// Optional shell history / aliases: never fatal
try (
  file "exists" "~/:path/history.txt"
  if exists (
    file "open" "~/:path/history.txt" "onlyaccess"
    last @= fileGet(4).split("\n").filter(v -> v.len > 0)
    file "close"
  )
  file "exists" "~/:path/aliases.json"
  if exists (
    file "open" "~/:path/aliases.json" "onlyaccess"
    aliases = fileGet(4).JsonParse()
    if typeof(aliases) != "object" (
      aliases = {}
    )
    file "close"
  )
) catch e (
  last = []
  aliases = {}
)

def parseCommand(cmd) (
  local tokens = []
  local current = ""
  local inQuote = false
  local quoteChar = ""
  local i = 1
  while i <= cmd.len (
    local c = cmd[i]
    if !inQuote and (c == "\"" or c == "'") (
      inQuote = true
      quoteChar = c
      current ++= c
    ) else if inQuote and c == quoteChar (
      current ++= c
      inQuote = false
    ) else if !inQuote and c == "|" (
      if current.len > 0 (
        void tokens.append(current)
        current = ""
      )
      void tokens.append("|")
    ) else if !inQuote and i < cmd.len and c == ">" and cmd[i + 1] == ">" (
      if current.len > 0 (
        void tokens.append(current)
        current = ""
      )
      void tokens.append(">>")
      i += 1
    ) else if !inQuote and c == ">" (
      if current.len > 0 (
        void tokens.append(current)
        current = ""
      )
      void tokens.append(">")
    ) else if !inQuote and c == "&" (
      if current.len > 0 (
        void tokens.append(current)
        current = ""
      )
      void tokens.append("&")
    ) else if !inQuote and c == " " (
      if current.len > 0 (
        void tokens.append(current)
        current = ""
      )
    ) else (
      current ++= c
    )
    i += 1
  )
  if current.len > 0 (
    void tokens.append(current)
  )
  return tokens
)

def parseShellOperators(tokens) (
  local segments = []
  local current = []
  local redirect = null
  local redirectAppend = false
  local background = false
  local i = 1
  while i <= tokens.len (
    local tok = tokens[i]
    if tok == "|" (
      void segments.append({cmd: current, redirect: redirect, append: redirectAppend})
      current = []
      redirect = null
      redirectAppend = false
    ) else if tok == ">" (
      redirect = tokens[i + 1]
      redirectAppend = false
      i += 1
    ) else if tok == ">>" (
      redirect = tokens[i + 1]
      redirectAppend = true
      i += 1
    ) else if tok == "&" (
      background = true
    ) else (
      void current.append(tok)
    )
    i += 1
  )
  void segments.append({cmd: current, redirect: redirect, append: redirectAppend, background: background})
  return segments
)

def evalSingle(tokens, input) (
  if tokens.len == 0 (
    return []
  )
  try (
    string first = tokens[1]
    string path = first.startsWith("./") ? (terminal.pwd.replaceFirst("origin/", "/") ++ "/" ++ first.trim(3, -1)) ("~/:path/" ++ first ++ ".osl")
    path = parseFilePath(path)
    file "exists" path
    local data = open(path)
    if data == null or !exists (
      terminal_output = []
      terminal tokens.join(" ")
      if terminal_output[1] == "Unknown Terminal Command" (
        local message = "rsh: command not found: " ++ first
        terminal.writeLine(message)
        return [message]
      )
      return terminal_output
    )
    local fn @= function("args", data)
    void tokens.shift()
    // command substitution output is captured, then dropped from the scrollback
    number len0 = terminal.lines.len
    for i tokens.len (
      local cur = tokens[i]
      if cur[1] == "\"" and cur[-1] == "\"" (
        tokens[i] = cur.trim(2, -2).replace("\\", "")
      )
      if cur[1] == "(" and cur[-1] == ")" (
        local ret @= evalCmd(cur.trim(2, -2))
        for j ret.len (
          if typeof(ret[j]) == "array" (
            local line = []
            for h ret[j].len / 2 (
              void line.append(ret[j][h * 2])
            )
            ret[j] = line.join(" ")
          )
        )
        if ret.len > 0 (
          tokens[i] @= ret.join("\n")
        ) else (
          tokens[i] = null
        )
      )
    )
    loop terminal.lines.len - len0 (
      void terminal.lines.pop()
    )
    terminal.dirty = true
    number len = terminal.lines.len
    terminal.stdin = input
    void fn.apply(self, [tokens])
    terminal.stdin = null
    local out @= terminal.lines.trim(len + 1, -1)
    return out
  ) catch e (
    terminal.stdin = null
    terminal.writeLine(e.full)
    return [e.full]
  )
)

def evalCmd(cmd) (
  local tokens = parseCommand(cmd)
  local segments = parseShellOperators(tokens)
  local isBackground = segments[segments.len].background
  if segments.len == 1 and segments[1].redirect == null and !isBackground (
    return evalSingle(segments[1].cmd, null)
  )
  local pipedInput = null
  local finalOutput = []
  for i segments.len (
    local segment = segments[i]
    local n0 = terminal.lines.len
    local result = evalSingle(segment.cmd, pipedInput)
    if i < segments.len or segment.redirect != null (
      // piped or redirected output belongs to the next stage, not the scrollback
      loop terminal.lines.len - n0 (
        void terminal.lines.pop()
      )
      terminal.dirty = true
    )
    if i < segments.len (
      pipedInput = result.join("\n")
    )
    if i == segments.len and segment.redirect != null (
      local targetPath = terminal.resolvePath(segment.redirect)
      local content = result.join("\n")
      if segment.append (
        file "exists" targetPath
        if exists (
          file "get_file" targetPath
          content = data ++ "\n" ++ content
        )
      )
      file "set_file" targetPath content
    ) else if i == segments.len (
      finalOutput = result
    )
  )
  return finalOutput
)

def runBackground(cmd) (
  local jobId = null
  local jobWorker @= worker({
    isThread: true,
    command: cmd,
    done: false,
    terminal: terminal,
    evalCmd,
    oncreate: def() -> (
      if command != null (
        self.evalCmd(command)
        self.done = true
        self.command = null
        self.kill()
      )
    )
  })
  jobId = terminal.addJob(cmd, jobWorker)
  terminal.writeLine("[" ++ jobId ++ "] " ++ cmd)
)

def checkJobs() (
  local toRemove = []
  for i terminal.jobs.len (
    local job = terminal.jobs[i]
    if job.worker.done or job.worker.alive == false (
      terminal.writeLine("[" ++ job.id ++ "] Done: " ++ job.name)
      void toRemove.append(job.id)
    )
  )
  for j toRemove.len (
    terminal.removeJob(toRemove[j])
  )
)

def userStart() (
  local pos = terminal.pwd
  if pos == home_path or pos == user_folder (
    pos = "~"
  ) else if pos == "origin" or pos == "origin/" (
    pos = "/"
  ) else (
    pos = pos.split("/")[-1]
  )
  return username ++ "@originos " ++ pos ++ " % "
)

// scripts call terminal.run("cmd") to execute a line through this shell
terminal.run @= (def(cmd) -> (
  return evalCmd(cmd)
))

// check ~/:path against the tracker once per terminal window
rush_checked ??= false
if !rush_checked and path.len > 0 and home_path != "" (
  rush_checked = true
  try (
    local updates = []
    for i path.len (
      local cur = path[i]
      local cmd_path = parseFilePath("~/:path/" ++ cur.name)
      file "exists" cmd_path
      if exists (
        if cur.status == "removed" (
          file "open" cmd_path "onlyaccess"
          file "delete"
        ) else (
          local data = open(cmd_path, ["edited"])
          if data[1] != cur.lastModifiedUnix (
            void updates.append(cur)
          )
        )
      ) else if cur.status != "removed" (
        void updates.append(cur)
      )
    )
    if updates.len > 0 (
      terminal.writeLine("Updates found for the following scripts:")
      for i updates.len (
        terminal.writeLine("- " ++ updates[i].name)
      )
      if terminal.input("Update them? (y/n)") == "y" (
        file "goto_dir" "~/:path"
        for i updates.len (
          local cur = updates[i]
          file "set_file" cur.name (path_url ++ cur.name).httpGet()
          file "open" cur.name "onlyaccess"
          file "set" "edited" cur.lastModifiedUnix
          terminal.writeLine("Updated " ++ cur.name)
        )
      )
    )
  ) catch e (
    terminal.writeLine("path update check failed: " ++ (e.full ?? e))
  )
)

// `exit` sets terminal.exiting; this shell then returns. Nested shells (running `rush` inside rush)
// return to their parent, and the pane only closes when the top-level program returns.
terminal.exiting = false
while !terminal.exiting (
  string line = "" ++ (terminal.readLine(userStart()) ?? "")
  if line.strip().len > 0 (
    try (
      file "open" "~/:path/history.txt" "onlyaccess"
      file "append" (line ++ "\n")
      file "close"
    ) catch e (
      // history is optional
    )
    void last.append(line)
    array parts = line.oslTokenise()
    if aliases.contains(parts[1]) (
      parts[1] = aliases[parts[1]]
      line = parts.join(" ")
    )
    checkJobs()
    local tokens = parseCommand(line)
    local segments = parseShellOperators(tokens)
    if tokens.len > 0 and tokens[1] === "exit" (
      // exit is a shell builtin: it ends this shell process, never the window
      terminal.exiting = true
    ) else if segments[segments.len].background (
      runBackground(line.replace(" &", "").replace("&", ""))
    ) else (
      void evalCmd(line)
    )
  )
)
terminal.exiting = false
