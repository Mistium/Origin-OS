// xargs [-n count] [-I token] command [args]   build commands from stdin lines
if terminal.stdin == null (
  terminal.writeLine("usage: ... | xargs [-n count] [-I token] command [args]")
  return
)
local perCall = 0
local token = null
local cmd = []
local i = 1
while i <= args.len (
  local a = "" ++ args[i]
  if cmd.len == 0 and a == "-n" (
    perCall = args[i + 1].toNum() ?? 1
    i += 1
  ) else if cmd.len == 0 and a == "-I" (
    token = args[i + 1]
    perCall = 1
    i += 1
  ) else (
    void cmd.append(a)
  )
  i += 1
)
if cmd.len == 0 (
  void cmd.append("echo")
)
local items = terminal.stdin.split("\n").map(v -> v.strip()).filter(v -> v.len > 0)
if items.len == 0 (
  return
)
if perCall == 0 (
  void evalCmd(cmd.join(" ") ++ " " ++ items.join(" "))
  return
)
local at = 1
while at <= items.len (
  local batch = items.trim(at, min(items.len, (at + perCall) - 1))
  if token != null (
    void evalCmd(cmd.join(" ").replace(token, batch.join(" ")))
  ) else (
    void evalCmd(cmd.join(" ") ++ " " ++ batch.join(" "))
  )
  at += perCall
)
