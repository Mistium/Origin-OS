// wc [-lwc] [file ...]
local flags = ""
local files = []
for i args.len (
  local a = "" ++ args[i]
  if a.startsWith("-") and a.len > 1 (
    flags ++= a.trim(2, -1)
  ) else (
    void files.append(a)
  )
)
local inputs = []
if files.len == 0 (
  if terminal.stdin == null (
    terminal.writeLine("usage: wc [-lwc] [file ...]")
    return
  )
  void inputs.append({name: "", text: "" ++ terminal.stdin})
)
for i files.len (
  local p = terminal.resolvePath(files[i])
  file "exists" p
  if exists (
    void inputs.append({name: files[i], text: "" ++ open(p)})
  ) else (
    terminal.writeLine("wc: " ++ files[i] ++ ": No such file or directory")
  )
)
local tl = 0
local tw = 0
local tc = 0
for i inputs.len (
  local text = inputs[i].text
  local lines = text.split("\n")
  local words = 0
  for j lines.len (
    words += lines[j].split(" ").filter(w -> w.len > 0).len
  )
  local nl = text == "" ? 0 lines.len
  tl += nl
  tw += words
  tc += text.len
  local out = ""
  if flags == "" or flags.contains("l") (
    out ++= ("" ++ nl).padStart(" ", 7)
  )
  if flags == "" or flags.contains("w") (
    out ++= ("" ++ words).padStart(" ", 7)
  )
  if flags == "" or flags.contains("c") (
    out ++= ("" ++ text.len).padStart(" ", 7)
  )
  terminal.writeLine(out ++ " " ++ inputs[i].name)
)
if inputs.len > 1 (
  local out = ""
  if flags == "" or flags.contains("l") (
    out ++= ("" ++ tl).padStart(" ", 7)
  )
  if flags == "" or flags.contains("w") (
    out ++= ("" ++ tw).padStart(" ", 7)
  )
  if flags == "" or flags.contains("c") (
    out ++= ("" ++ tc).padStart(" ", 7)
  )
  terminal.writeLine(out ++ " total")
)
